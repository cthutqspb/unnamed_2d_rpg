[bootstrap]
main_collection = /main/main.collectionc
render = /orthographic/render/orthographic.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 0
fullscreen = 0

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
debug = 1

[html5]
scale_mode = stretch

[project]
title = WoW Proto
version = 0.1
dependencies#0 = https://github.com/Insality/defold-event/archive/refs/tags/14.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.2.2.zip
dependencies#2 = https://github.com/britzl/defold-orthographic/archive/master.zip

[input]
game_binding = /input/game.input_bindingc

[tilemap]
max_tile_count = 262144

