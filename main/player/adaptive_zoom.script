-- camera.script
local DESIGN_WIDTH = 1920
local DESIGN_HEIGHT = 1080
local DESIGN_ZOOM = 1

function init(self)
    -- Запоминаем дизайнерские размеры
    self.design_width = DESIGN_WIDTH / DESIGN_ZOOM
    self.design_height = DESIGN_HEIGHT / DESIGN_ZOOM
    
    -- Устанавливаем слушатель изменения окна
    window.set_listener(function(cb_self, event, data)
        if event == window.WINDOW_EVENT_RESIZED then
            self:update_zoom()
        end
    end)
    
    -- Начальный зум
    self:update_zoom()
end

function update_zoom(self)
    local win_w, win_h = window.get_size()
    if win_w == 0 then
        win_w, win_h = 1920, 1080
    end
    
    -- Рассчитываем зум, чтобы всегда показывать DESIGN_WIDTH x DESIGN_HEIGHT
    local new_zoom = math.max(win_w / self.design_width, win_h / self.design_height)
    
    -- Устанавливаем зум камеры
    go.set("#camera", "orthographic_zoom", new_zoom)
end

function update(self, dt)
    -- Следуем за игроком
    local player_pos = go.get_position("player")
    go.set_position(vmath.vector3(player_pos.x, player_pos.y, -100))
end

