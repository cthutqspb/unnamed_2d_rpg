local character_data = require("main.modules.character_data")
local settings = require("main.modules.settings")

function init(self)
    print("Player initialized at position:", go.get_position())
    -- Центр Full HD экрана
    local center_x, center_y = settings.get_center()
    go.set_position(vmath.vector3(center_x, center_y, 1.0))
    -- Запрашиваем фокус ввода (как focus() в DOM)
    msg.post(".", "acquire_input_focus")

    self.pressed_keys = { up = 0, down = 0, left = 0, right = 0 }
    -- Состояние игрока (как useState)
    self.health = character_data.player.health
    self.max_health = character_data.player.max_health
    self.mana = character_data.player.mana
    self.max_mana = character_data.player.max_mana
    self.stats = character_data.player.stats


    self.speed = 300  -- пикселей в секунду
    self.move_input = vmath.vector3(0, 0, 0)  -- запоминаем зажатые клавиши
    self.direction = 1
    
    -- Позиция игрока (будем хранить отдельно для плавности)
    self.position = vmath.vector3(0, 0, 0)

    self.correction = vmath.vector3()
    self.move_target = nil  -- цель для движения мышью
  
    self.show_interactable = false
    self.world_bounds = settings.world_bounds
end

function take_damage(self, damage)
    print("g pressed")  
    self.health = math.max(0, self.health - damage)
    local percentage = self.health / self.max_health
    
    -- Отправляем сообщение в HUD
    msg.post("/gui_manager", "update_health", { percentage = percentage })
    
    print("Health:", self.health, "Percentage:", percentage)
end

function heal(self, amount)
    print("h pressed")  
    self.health = math.min(self.max_health, self.health + amount)
    local percentage = self.health / self.max_health
    
    -- Отправляем сообщение в HUD
    msg.post("/gui_manager", "update_health", { percentage = percentage })
    
    print("Health:", self.health, "Percentage:", percentage)
end

function update(self, dt)
   -- Если есть ввод с клавиатуры — отменяем движение мышью
    if self.move_input.x ~= 0 or self.move_input.y ~= 0 then
        self.move_target = nil
    end
    
    -- 1. Собираем вектор направления из того, что пришло из on_input
    local move = vmath.vector3(self.move_input.x, self.move_input.y, 0)
    
    -- 2. Если есть цель от мышки — пересчитываем move в сторону цели
    if self.move_target then
        local p = go.get_position()
        local d = self.move_target - p
        if vmath.length(d) > 5 then
            move = vmath.normalize(d)
        else
            self.move_target = nil -- Пришли на место
            move = vmath.vector3(0,0,0)
        end
    end

    -- 3. ПРИМЕНЯЕМ ДВИЖЕНИЕ (только один раз за кадр!)
    if vmath.length(move) > 0 then
        move = vmath.normalize(move)
        local current_pos = go.get_position()
        go.set_position(current_pos + move * self.speed * dt)
    end

    if self.move_target and self.pending_item then
        local dist = vmath.length(self.move_target - go.get_position())
        if dist < 15 then
            -- Подбираем предмет
            msg.post(self.pending_item, "click")
            self.move_target = nil
            self.pending_item = nil
        end
    end
end

function on_input(self, action_id, action)
    -- Фиксируем нажатие/отпускание для каждой клавиши
    if action_id == hash("up") then
        self.pressed_keys.up = action.released and 0 or 1
    elseif action_id == hash("down") then
        self.pressed_keys.down = action.released and 0 or 1
    elseif action_id == hash("left") then
        self.pressed_keys.left = action.released and 0 or 1
    elseif action_id == hash("right") then
        self.pressed_keys.right = action.released and 0 or 1
    end

    self.move_input.x = self.pressed_keys.right - self.pressed_keys.left
    self.move_input.y = self.pressed_keys.up - self.pressed_keys.down
    -- Движение мышью (правый клик)
    if action_id == hash("mouse_right") and action.pressed then
        local player_pos = go.get_position("player")
        local w = sys.get_config("display.width")
        local h = sys.get_config("display.height")
        
        local world_x = player_pos.x + (action.x - w / 2)
        local world_y = player_pos.y + (action.y - h / 2)
        
        self.move_target = vmath.vector3(world_x, world_y, 1.0)
        self.move_input = vmath.vector3(0, 0, 0)
        
    -- Остальные действия
    elseif action_id == hash("take_damage") and action.pressed then
        take_damage(self, 10)
    elseif action_id == hash("heal") and action.pressed then
        heal(self, 10)
    elseif action_id == hash("toggle_inventory") and action.pressed then
        msg.post("/gui_manager", "toggle_inventory")
    elseif action_id == hash("toggle_character") and action.pressed then
        msg.post("/gui_manager", "toggle_character")
    end    

    if action_id == hash("key_alt") then
        -- Отправляем ТОЛЬКО когда состояние меняется (pressed или released)
        if action.pressed then
            self.show_interactable = true
            print('ALT PRESSED')
            msg.post("world", "toggle_interactable_highlight", { show = true })
        elseif action.released then
            self.show_interactable = false
            print('ALT RELEASED')
            msg.post("world", "toggle_interactable_highlight", { show = false })
        end
    end    
end

function on_message(self, message_id, message, sender)
    -- if message_id == hash("contact_point_response") then
    --     if message.distance > 0 then
    --         local proj = vmath.project(self.correction, message.normal * message.distance)
    --         if proj < 1 then
    --             local comp = (message.distance - message.distance * proj) * message.normal
    --             go.set_position(go.get_position() + comp)
    --             self.correction = self.correction + comp
    --         end
    --     end
    -- end

    if message_id == hash("move_to_item") then
        self.move_target = go.get_position(message.item_id)
        self.pending_item = message.item_id  -- запоминаем, что после подхода нужно подобрать
        self.move_input = vmath.vector3(0, 0, 0)
    end
end
