local character_data = require("main.modules.character.character_data")
local unit_logic = require("main.modules.unit.logic.unit_logic")
local settings = require("main.modules.data.settings")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local abilities_db = require("main.modules.data.abilities_db")
local broadcast = require("main.modules.system.broadcast")
local interaction_manager = require("main.modules.logic.interaction_manager")
local game_state = require("main.modules.game_state.game_state")
local units_state = require("main.modules.game_state.units_state")


---@class PlayerPressedKeys
---@field up number
---@field down number
---@field left number
---@field right number

---@class PlayerScriptInstance
---@field pressed_keys PlayerPressedKeys
---@field base_speed number
---@field move_input vector3
---@field direction number
---@field position vector3
---@field correction vector3
---@field move_target vector3|nil
---@field show_interactable boolean
---@field world_bounds table
---@field pending_item hash|nil ID целевого объекта в мире
---@field pending_event string|nil Системный ивент для отправки при добегании
---@field pending_range number Дистанция срабатывания (например, 20 или 50)
---@field cast_payload table|nil

---@param self PlayerScriptInstance
---@param amount number
local function take_damage(self, amount)
    unit_logic.take_damage(amount)
    if character_data.player.health <= 0 then
        print("Player died!")
    end
end

---@param self PlayerScriptInstance
---@param amount number
local function heal(self, amount)
    unit_logic.heal(amount)
    if character_data.player.health >= character_data.player.max_health then
        print("Already full health!")
    end
end

local function burn_mana(self, amount)
    unit_logic.burn_mana(amount)
    if character_data.player.mana <= 0 then
        print("No more MP!")
    end
end

local function restore_mana(self, amount)
    unit_logic.restore_mana(amount)
    if character_data.player.mana >= character_data.player.max_mana then
        print("Already full MP!")
    end
end

---@param self PlayerScriptInstance
function init(self)
    character_data.bind_to_units_registry()
    units_state.register(go.get_id(), character_data.PLAYER_UID)
    print("Player initialized at position:", go.get_position())
    --local center_x, center_y = settings.get_center()
    go.set_position(vmath.vector3(0, 0, 1.0))
    msg.post(".", "acquire_input_focus")
    --msg.post("game_scene:/camera", "follow", { target = go.get_id(), lerp = 0.08 })
    self.pressed_keys = { up = 0, down = 0, left = 0, right = 0 }
    self.base_speed = 300
    self.move_input = vmath.vector3(0, 0, 0)
    self.direction = 1
    self.position = vmath.vector3(0, 0, 0)
    self.correction = vmath.vector3()
    self.move_target = nil
    self.show_interactable = false
    self.world_bounds = settings.world_bounds

    -- 🎯 ВОЗВРАЩАЕМ НАШИ РОДНЫЕ ПЕРЕМЕННЫЕ АВТОЛУТА
    self.pending_item = nil
    self.pending_event = nil
    self.pending_range = 40
end

---@param self PlayerScriptInstance
---@param dt number
function update(self, dt)
    ---@type UnitInstance
    local player = character_data.player
    if not player or not player.base_attributes or not player.attributes then
        return
    end

    local position = go.get_position()
    character_data.update_position(position)

    -- 🛡️ ИДЕАЛЬНАЯ АРХИТЕКТУРА СКОРОСТИ (ИСПРАВЛЕНО):
    -- Скрипт больше не занимается самодеятельностью и не считает ХП!
    -- Он просто слепо берет готовую, выверенную бэкендом скорость юнита из RAM!
    local current_speed = player.parameters.current_speed or 120

    -- =========================================================================
    -- 🔮 КAСТБAР МАГА В ЕДИНOM ИСТОЧНИКЕ ПРАВДЫ (ИСПРАВЛЕНО НАМЕРТВО):
    -- =========================================================================
    -- 🛡️ ГВАРД СРЫВА КАСТА ПРИ ДВИЖЕНИИ WASD:
    if player.cast.ability_id and (self.move_input.x ~= 0 or self.move_input.y ~= 0) then
        print("❄️ БЭКЕНД [Magic]: Каст ПРЕРВАН из-за движения мага ногами!")
        player.cast.ability_id = nil
        player.cast.time = 0
        player.cast.duration = 0
        self.cast_payload = nil -- Очищаем боевой пакет, чтобы отмена не выстрелила!
        msg.post("main:/gui_manager#hud", "hide_castbar", { interrupted = true })
    end

    -- РЕАКТИВНЫЙ ОБСЧЁТ И ВЫКАЧКА ПРОГРЕССА В HUD:
    if player.cast.ability_id then
        -- =========================================================================
        -- 🦾 ЗРЯЧИЙ КОНВОИР ДИСТАНЦИИ КАСТА (ДОБАВЛЕНО НАМЕРТВО ПО WoW-КАНОНУ):
        -- =========================================================================
        -- Каждый божий кадр, пока ползет полоска, мы заново спрашиваем нашего судью unit_logic!
        local current_target_uid = interaction_manager.get_current_target_uid and interaction_manager.get_current_target_uid()
        ---@type UnitInstance
        local current_target_unit = game_state.get_entity_by_uid(current_target_uid)

        local is_possible, error_reason = unit_logic.check_cast_possibility(player, player.cast.ability_id, current_target_unit)

        -- 💥 МИГ ПРEРЫВAНИЯ НА ХОДУ: Скелет отбежал назад и вышел из ренжа!
        if not is_possible then
            print("🚨 БЭКЕНД [Cast Monitor]: Каст принудительно СОРВАН покадровым гвардом! Причина:", error_reason)

            -- Намертво выжигаем и очищаем ТТХ каста в оперативной памяти мага
            player.cast.ability_id = nil
            player.cast.time = 0
            player.cast.duration = 0
            self.cast_payload = nil -- аннигилируем закешированный боевой пакет!

            -- Тушим полоску кастбара с экрана игрока с флагом прерывания
            msg.post("main:/gui_manager#hud", "hide_castbar", { interrupted = true })

            -- Выплёвываем сочный Blizzard-варнинг на экран
            local log_text = "Каст прерван"
            if error_reason == "OUT_OF_RANGE" then log_text = "Цель слишком далеко!"
            elseif error_reason == "INVALID_TARGET" then log_text = "Неверная цель!"
            end
            msg.post("main:/gui_manager#hud", "show_screen_error", { text = log_text })

            return -- Наглухо обрываем апдейт в этом кадре, спасая транзакцию!
        end
        -- =========================================================================

        -- Шлем покадровый асинхронный прогресс в hud.gui_script для движения ползунка
        local progress = player.cast.time / player.cast.duration
        msg.post("main:/gui_manager#hud", "update_castbar", { progress = progress })

        -- ⚡ КАСТ БЕЗУПРЕЧНО ДОПЕЛ ДО КОНЦА НА ЦЕНТРАЛЬНЫХ ЧАСАХ!
        if player.cast.time >= player.cast.duration then
            print("❄️ БЭКЕНД [Combat]: Каст завершен! Вызываем боевой редьюсер урона.")

            -- Стерильно очищаем глобальный стейт каста внутри реестра
            player.cast.ability_id = nil
            player.cast.time = 0
            player.cast.duration = 0
            msg.post("main:/gui_manager#hud", "hide_castbar")

            -- Вызываем редьюсер диспетчера экшенов, скармливая ему сохраненный payload
            if self.cast_payload then
                 local live_target_uid = interaction_manager.get_current_target_uid and interaction_manager.get_current_target_uid()

                self.cast_payload.target_uid = live_target_uid -- Вшиваем чистую строку!
                actions_dispatcher.REDUCERS["action_bar_use"](self.cast_payload)
                self.cast_payload = nil -- Очищаем кэш после успешной транзакции
            end
        end
    end
    -- =========================================================================

    -- Если есть ввод с клавиатуры — отменяем движение мышью и сбрасываем лут
    if self.move_input.x ~= 0 or self.move_input.y ~= 0 then
        self.move_target = nil
        self.pending_item = nil
        self.pending_event = nil
        msg.post("main:/container_window#gui", "close_window", { on_move = true })
    end

    -- 1. Собираем вектор направления из клавиатурного буфера
    local move = vmath.vector3(self.move_input.x, self.move_input.y, 0)

    -- 2. Если есть цель от мышки — пересчитываем move в сторону цели
    if self.move_target then
        msg.post("main:/container_window#gui", "close_window", { on_move = true })
        local d = self.move_target - position
        if vmath.length(d) > 5 then
            move = vmath.normalize(d)
        else
            self.move_target = nil
            move = vmath.vector3(0, 0, 0)
        end
    end

    -- 3. ПРИМЕНЯЕМ ДВИЖЕНИЕ (Чистый Си-накат на основе current_speed из RAM!)
    if vmath.length(move) > 0 then
        move = vmath.normalize(move)
        go.set_position(position + move * current_speed * dt)
    end

    -- 🚩 ТВОЙ РОДНОЙ, ЧЕСТНЫЙ АВТОЛУТ (С поддержкой кастомных дистанций):
    if self.pending_item then
        local ok, target_position = pcall(go.get_world_position, self.pending_item)
        if not ok then
            self.pending_item = nil
            self.pending_event = nil
            return
        end

        -- Считаем дистанцию ровно так же, как было раньше
        local dist = vmath.length(target_position - go.get_position())

        -- Если мы зашли в индивидуальный радиус этого действия
        if dist < self.pending_range then
            -- if not window_manager.is_over_ui() then
                -- Шлем бочке/луту именно то сообщение, которое взвели при клике!
                msg.post(self.pending_item, self.pending_event)
            -- end

            -- Очищаем стейт, чтобы не кликать вечно
            self.pending_item = nil
            self.pending_event = nil
            self.move_target = nil
        end

        -- Если игрок ушел слишком далеко от цели или сбросил WASD-ом
        if self.move_target == nil and dist > 50 then
            self.pending_item = nil
            self.pending_event = nil
        end
    end
end

---@param self PlayerScriptInstance
---@param action_id hash|nil
---@param action table
function on_input(self, action_id, action)
    -- Глобальная защита GUI
    -- if action_id == hash("mouse_right") or action_id == hash("touch") then
    --     if window_manager.is_over_ui() then
    --         return false
    --     end
    -- end

    -- Управление кнопками WASD
    if action_id == hash("up") then
        self.pressed_keys.up = action.released and 0 or 1
    elseif action_id == hash("down") then
        self.pressed_keys.down = action.released and 0 or 1
    elseif action_id == hash("left") then
        self.pressed_keys.left = action.released and 0 or 1
    elseif action_id == hash("right") then
        self.pressed_keys.right = action.released and 0 or 1
    end

    self.move_input.x = self.pressed_keys.right - self.pressed_keys.left
    self.move_input.y = self.pressed_keys.up - self.pressed_keys.down

    if action.pressed and (self.move_input.x ~= 0 or self.move_input.y ~= 0) then
        msg.post("main:/context_menu_layer#gui", "hide_menu")
    end

    -- Горячие клавиши
    if action_id == hash("take_damage") and action.pressed then
        -- take_damage(self, 10)
        -- self.move_target = nil -- Гасим автобег мыши, кастуем строго с места
        -- self.cast_spell_id = "frostbolt"
        -- self.cast_duration = 2.5
        -- self.cast_current = 0
        print("❄️ БЭКЕНД: Маг начал кастовать Фростболт!")
        msg.post("main:/gui_manager#hud", "show_castbar", { spell_id = "frostbolt" })
    elseif action_id == hash("heal") and action.pressed then
        heal(self, 10)
    elseif action_id == hash("burn_mana") and action.pressed then
        burn_mana(self, 10)
    elseif action_id == hash("restore_mana") and action.pressed then
        restore_mana(self, 10)
    elseif action_id == hash("toggle_inventory_window") and action.pressed then
        msg.post("main:/context_menu_layer#gui", "hide_menu")
        msg.post("main:/inventory_window#gui", "toggle_inventory_window")
    elseif action_id == hash("toggle_character_window") and action.pressed then
        msg.post("main:/context_menu_layer#gui", "hide_menu")
        msg.post("main:/character_window#gui", "toggle_character_window")
    end

    -- Подсветка Alt
    if action_id == hash("key_alt") then
        if action.pressed then
            self.show_interactable = true
            msg.post("game_scene:/world", "toggle_interactable_highlight", { show = true })
        elseif action.released then
            self.show_interactable = false
            msg.post("game_scene:/world", "toggle_interactable_highlight", { show = false })
        end
    end
end

---@param self PlayerScriptInstance
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    -- Обработка телепортации (системное действие, например, при загрузке сохранения)
    if message_id == hash("teleport_to") then
        go.set_position(message.position)
        print("Player teleported to:", message.position)
    end

    -- 🎯 ЧИСТЫЙ КОНТРОЛЛЕР ХОДЬБЫ:
    -- Игрок больше не думает, куда кликнули — в инвентарь, в сундук или в скелета.
    -- Ему просто приказали бежать в мировые координаты, и он послушно выполняет!
    if message_id == hash("move_to") then
        self.move_target = vmath.vector3(message.position.x, message.position.y, 1.0)
        self.move_input = vmath.vector3(0, 0, 0)
        self.pending_item = nil
        self.pending_event = nil

    -- Команда экстренной остановки, когда мир открыл контекстное меню над Скелетом
    elseif message_id == hash("stop_movement") then
        self.move_target = nil
        self.move_input = vmath.vector3(0, 0, 0)
    end

    -- Сигнал от ЛКМ-клика издалека по сундуку или кучке лута на земле (move_to_entity)
    if message_id == hash("move_to_entity") then
        self.move_target = go.get_world_position(message.entity_id)
        self.move_input = vmath.vector3(0, 0, 0)

        msg.post("main:/container_window#gui", "close_window")
        -- 🎯 Ставим твой оригинальный автолут на рельсы
        self.pending_item = message.entity_id
        self.pending_event = "click" -- Для ЛКМ базовый ивент бочки
        self.pending_range = 45      -- Оригинальный рабочий радиус
    end

    -- Сигнал от выбора кнопки в Контекстном меню ПКМ
    if message_id == hash("context_menu_action") then
        local target_go_id = message.data.target_go_id
        if target_go_id then
            -- Сразу отправляем персонажа бежать к объекту
            self.move_target = go.get_world_position(target_go_id)
            self.move_input = vmath.vector3(0, 0, 0)

            self.pending_item = target_go_id

            -- Выставляем дистанцию и ивент в зависимости от выбора в меню
            if message.event == "item_pickup" then
                self.pending_event = "item_pickup" -- Сигнал подбора предмета с земли
                self.pending_range = 25      -- 🎯 ДЛЯ ЛУТА НА ЗЕМЛЕ: Уменьшаем радиус до 25 пикселей
            else
                self.pending_event = "click" -- Для сундуков и бочек
                self.pending_range = 45      -- Оставляем стандартные 45 пикселей
            end
        end
    end

    if message_id == hash("contact_point_response") then
        -- 🎯 ФИКС СТАЛКИВАНИЯ МОНСТРОВ:
        -- Разрешаем коду выталкивания срабатывать И для стен, И для группы unit!
        if message.group == hash("wall") or message.group == hash("unit") then
            -- Твой оригинальный рабочий код выталкивания персонажа из препятствий:
            local new_position = go.get_position() + message.normal * message.distance
            go.set_position(new_position)

            -- Если игрок бежал по мышке (move_target), при столкновении с драконом/стеной сбрасываем бег
            if self.move_target then
                self.move_target = nil
            end
        end
    end

    if message_id == hash("player_action") then
        if message.event == "action" then
            ---@type UnitInstance
            local player = character_data.player
            -- =========================================================================
            -- 🛡️ ТИТАНОВЫЙ ААА-ЗАСОВ ГКД ЧЕРЕЗ ПОСРЕДНИКА (ИСПРАВЛЕНО НАМЕРТВО):
            -- =========================================================================
            -- Скрипт игрока общается strictly со своим родным модулем character_data!
            -- Никаких прямых левых вызовов units_state или game_state на фазе инпута.
            if character_data.is_gcd_active and character_data.is_gcd_active() then
                print("⏳ БЭКЕНД [Combat]: Действие заблокировано! ГКД еще активно.")
                return true
            end
            -- =========================================================================

            local ability_id = message.data.action_id
            local ability_cfg = abilities_db.get_ability(ability_id)

            local current_target_uid = interaction_manager.get_current_target_uid and interaction_manager.get_current_target_uid()
            ---@type UnitInstance
            local current_target_unit = game_state.get_entity_by_uid(current_target_uid)
            -- =========================================================================
            -- 🛡️ ЦЕНТРАЛЬНЫЙ СИ-ЗАСОВ БОЯ + ВЫКАЧКА В БОЕВОЙ ЛОГ (ИСПРАВЛЕНО НАМЕРТВО):
            -- =========================================================================
            local is_possible, error_reason = unit_logic.check_cast_possibility(player, ability_id, current_target_unit)

            if not is_possible then
                -- Готовим каноничный Blizzard-текст для вывода на экран и в лог
                local log_text = "Неизвестная ошибка заклинания"

                if error_reason == "OUT_OF_RANGE" then
                    log_text = "Цель слишком далеко!"
                elseif error_reason == "NO_MANA" then
                    log_text = "Недостаточно маны!"
                elseif error_reason == "NO_TARGET" then
                    log_text = "Вы должны выбрать цель!"
                elseif error_reason == "INVALID_TARGET" then
                    log_text = "Неверная цель!"
                end

                print("🚨 БЭКЕНД [Combat Warning]:", log_text)

                -- 🚀 ВЗРЫВАЕМ СИГНАЛ В ТВОЙ ЖИВОЙ ЛОГ ИНТЕРФЕЙСА:
                -- Скармливаем пакет в шину Meadows. Твоё окно лога сочно поймает 
                -- этот текст и мгновенно выведет его на экран магу!
                if broadcast and broadcast.send then
                    broadcast.send("log_events", {
                        message_id = hash("log_message"),
                        channel = "combat",
                        text = log_text
                    })
                end

                return -- НАГЛУХО БЛОКИРУЕМ ИНПУТ! Кастбар не родится, мана не спишется!
            end
            -- =========================================================================
            -- ВЕТКА А: ЗАКЛИНАНИЯ С ВОСПРОИЗВЕДЕНИЕМ КАСТА (Фростболт)
            -- =========================================================================
            if ability_cfg and ability_cfg.cast_time and ability_cfg.cast_time > 0 then
                -- Читаем глобальный гвард: если маг уже кастует — рубим спам кнопки
                if player and player.cast.ability_id then return true end

                -- Гасим движение мага мышкой, кастуем строго с места
                self.move_target = nil

                -- Запекаем ТТХ каста в RAM-паспорт мага
                player.cast.ability_id = ability_cfg.id
                player.cast.duration = ability_cfg.cast_time
                player.cast.time = 0

                -- Кэшируем боевой пакет данных, приводя имена к ААА-стандарту диспетчера
                self.cast_payload = {
                    caster_uid = character_data.PLAYER_UID,
                    target_uid = current_target_uid,
                    slot_index = message.data.slot_index,
                    drag_type = message.data.action_type,
                    action_id = message.data.action_id,
                    triggers_gcd = ability_cfg.triggers_gcd
                }

                -- Запускаем часики ГКД по всей вселенной Meadows прямо в момент старта каста!
                if ability_cfg.triggers_gcd then
                    local gcd_duration = 1.5 -- (Сюда потом встанет формула Haste)

                    -- Включаем бэкенд-замок ГКД для игрока через нашего посредника
                    character_data.start_gcd(gcd_duration)

                    broadcast.send("combat_events", {
                        message_id = hash("global_cooldown_started"),
                        duration = gcd_duration
                    })
                end

                print("LOG [Magic]: Запуск каста из БД. Спелл:", ability_cfg.id, "Время:", ability_cfg.cast_time)
                msg.post("main:/gui_manager#hud", "show_castbar", { ability_id = ability_cfg.id })
                return true
            end

            -- =========================================================================
            -- ВЕТКА Б: МГНОВЕННЫЕ (INSTANT) СПОСОБНОСТИ ИЛИ ПРЕДМЕТЫ
            -- =========================================================================
            -- Если у спелла cast_time == 0 или это банка маны — транзакция летит сразу!
            if ability_cfg and ability_cfg.triggers_gcd then
                local gcd_duration = 1.5

                -- Включаем бэкенд-замок ГКД для мгновенных абилок через нашего посредника
                character_data.start_gcd(gcd_duration)

                -- 🚀 WoW КАНОН: Мгновенные заклинания ТОЖЕ обязаны взрывать ГКД на панели!
                broadcast.send("combat_events", {
                    message_id = hash("global_cooldown_started"),
                    duration = gcd_duration
                })
            end

            -- Передаем чистый triggers_gcd из конфига чертежа
            actions_dispatcher.REDUCERS["action_bar_use"]({
                caster_uid = character_data.PLAYER_UID,
                target_uid = current_target_uid,
                slot_index = message.data.slot_index,
                drag_type = message.data.action_type,
                action_id = message.data.action_id,
                triggers_gcd = ability_cfg and ability_cfg.triggers_gcd or false
            })
        end
    end
end
