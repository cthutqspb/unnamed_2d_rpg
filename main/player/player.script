local game_state = require("main.modules.game_state.game_state")
local character_data = require("main.modules.character.character_data")
local character_logic = require("main.modules.character.character_logic")
local settings = require("main.modules.data.settings")
local interaction = require("main.modules.interaction")
local window_manager = require("main.gui.components.managers.window_manager")
local gui_utils = require("main.gui.gui_utils")
local camera = require("orthographic.camera")

---@class PlayerPressedKeys
---@field up number
---@field down number
---@field left number
---@field right number

---@class PlayerScriptInstance
---@field pressed_keys PlayerPressedKeys
---@field base_speed number
---@field move_input vector3
---@field direction number
---@field position vector3
---@field correction vector3
---@field move_target vector3|nil
---@field show_interactable boolean
---@field world_bounds table
---@field pending_item hash|nil ID целевого объекта в мире
---@field pending_event string|nil Системный ивент для отправки при добегании
---@field pending_range number Дистанция срабатывания (например, 20 или 50)

---@param self PlayerScriptInstance
---@param amount number
local function take_damage(self, amount)
    character_logic.take_damage(amount)
    if character_data.player.health <= 0 then
        print("Player died!")
    end
end

---@param self PlayerScriptInstance
---@param amount number
local function heal(self, amount)
    character_logic.heal(amount)
    if character_data.player.health >= character_data.player.max_health then
        print("Already full HP!")
    end
end

---@param self PlayerScriptInstance
function init(self)
    print("Player initialized at position:", go.get_position())
    local center_x, center_y = settings.get_center()
    go.set_position(vmath.vector3(center_x, center_y, 1.0))
    msg.post(".", "acquire_input_focus")
    --msg.post("game_scene:/camera", "follow", { target = go.get_id(), lerp = 0.08 })
    self.pressed_keys = { up = 0, down = 0, left = 0, right = 0 }
    self.base_speed = 300  
    self.move_input = vmath.vector3(0, 0, 0)  
    self.direction = 1
    self.position = vmath.vector3(0, 0, 0)
    self.correction = vmath.vector3()
    self.move_target = nil  
    self.show_interactable = false
    self.world_bounds = settings.world_bounds

    -- 🎯 ВОЗВРАЩАЕМ НАШИ РОДНЫЕ ПЕРЕМЕННЫЕ АВТОЛУТА
    self.pending_item = nil
    self.pending_event = nil
    self.pending_range = 40
end

---@param self PlayerScriptInstance
---@param dt number
function update(self, dt)
    local player = character_data.player
    local pos = go.get_position()
    character_data.player.last_pos = { x = pos.x, y = pos.y }

    local hp_mod = (player.health < 20) and 0.50 or 1.0
    local current_speed = self.base_speed * hp_mod

    -- Если есть ввод с клавиатуры — отменяем движение мышью и сбрасываем лут
    if self.move_input.x ~= 0 or self.move_input.y ~= 0 then
        self.move_target = nil
        self.pending_item = nil
        self.pending_event = nil
        msg.post("main:/container_window#gui", "close_window")
    end

    -- 1. Собираем вектор направления из клавиатурного буфера
    local move = vmath.vector3(self.move_input.x, self.move_input.y, 0)

    -- 2. Если есть цель от мышки — пересчитываем move в сторону цели
    if self.move_target then
        msg.post("main:/container_window#gui", "close_window")
        local d = self.move_target - pos
        if vmath.length(d) > 5 then
            move = vmath.normalize(d)
        else
            self.move_target = nil -- Пришли на место клика на земле
            move = vmath.vector3(0, 0, 0)
        end
    end

    -- 3. ПРИМЕНЯЕМ ДВИЖЕНИЕ (Твой оригинальный код, не трогаем!)
    if vmath.length(move) > 0 then
        move = vmath.normalize(move)
        go.set_position(pos + move * current_speed * dt)
    end

    -- 🚩 ТВОЙ РОДНОЙ, ЧЕСТНЫЙ АВТОЛУТ (С поддержкой кастомных дистанций):
    if self.pending_item then
        local ok, target_pos = pcall(go.get_world_position, self.pending_item)
        if not ok then
            self.pending_item = nil
            self.pending_event = nil
            return
        end

        -- Считаем дистанцию ровно так же, как было раньше
        local dist = vmath.length(target_pos - go.get_position())

        -- Если мы зашли в индивидуальный радиус этого действия
        if dist < self.pending_range then
            if not window_manager.is_over_ui() then
                -- Шлем бочке/луту именно то сообщение, которое взвели при клике!
                msg.post(self.pending_item, self.pending_event)
            end

            -- Очищаем стейт, чтобы не кликать вечно
            self.pending_item = nil
            self.pending_event = nil
            self.move_target = nil
        end

        -- Если игрок ушел слишком далеко от цели или сбросил WASD-ом
        if self.move_target == nil and dist > 50 then
            self.pending_item = nil
            self.pending_event = nil
        end
    end
end

---@param self PlayerScriptInstance
---@param action_id hash|nil
---@param action table
function on_input(self, action_id, action)
    -- Глобальная защита GUI
    if action_id == hash("mouse_right") or action_id == hash("touch") then
        if window_manager.is_over_ui() then
            return false 
        end
    end

    -- Управление кнопками WASD
    if action_id == hash("up") then
        self.pressed_keys.up = action.released and 0 or 1
    elseif action_id == hash("down") then
        self.pressed_keys.down = action.released and 0 or 1
    elseif action_id == hash("left") then
        self.pressed_keys.left = action.released and 0 or 1
    elseif action_id == hash("right") then
        self.pressed_keys.right = action.released and 0 or 1
    end

    self.move_input.x = self.pressed_keys.right - self.pressed_keys.left
    self.move_input.y = self.pressed_keys.up - self.pressed_keys.down

    if action.pressed and (self.move_input.x ~= 0 or self.move_input.y ~= 0) then
        msg.post("main:/context_menu_layer#gui", "hide_menu")
    end

    -- ДВИЖЕНИЕ МЫШЬЮ И ПКМ КОНТЕКСТНОЕ МЕНЮ
    if action_id == hash("mouse_right") and action.pressed then
        -- ОДНА СТРОКА: Камера сама переведет клик ПКМ в точные координаты мира
        -- ОДНА СТРОКА: Получаем сразу все нужные координаты
        local gui_pos, world_pos = gui_utils.transform_coordinates(action, hash("/camera"))
        
        local target_id = interaction.get_target_under_cursor(world_pos)

        if target_id then
            local target_type, uid, state_data = game_state.get_inspect_info(target_id)

            if target_type and uid then
                msg.post("main:/context_menu_layer#gui", "show_menu", {
                    x = action.x,
                    y = action.y,
                    type = target_type,
                    sub_type = nil,
                    flags = {},
                    data = {
                        slot_index = nil,
                        item_id = state_data and state_data.item_id or nil,
                        source_url = msg.url(),
                        target_go_id = target_id,
                        target_uid = uid
                    }
                })

                self.move_target = nil
                self.move_input = vmath.vector3(0, 0, 0)
            end
        else
            msg.post("main:/context_menu_layer#gui", "hide_menu")
            self.move_target = vmath.vector3(world_pos.x, world_pos.y, 1.0)
            self.move_input = vmath.vector3(0, 0, 0)
            self.pending_item = nil
            self.pending_event = nil
        end

    -- Горячие клавиши
    elseif action_id == hash("take_damage") and action.pressed then
        take_damage(self, 10)
    elseif action_id == hash("heal") and action.pressed then
        heal(self, 10)
    elseif action_id == hash("toggle_inventory_window") and action.pressed then
        msg.post("main:/context_menu_layer#gui", "hide_menu")
        msg.post("main:/inventory_window#gui", "toggle_inventory_window")
    elseif action_id == hash("toggle_character_window") and action.pressed then
        msg.post("main:/context_menu_layer#gui", "hide_menu")
        msg.post("main:/character_window#gui", "toggle_character_window")
    end

    -- Подсветка Alt
    if action_id == hash("key_alt") then
        if action.pressed then
            self.show_interactable = true
            msg.post("game_scene:/world", "toggle_interactable_highlight", { show = true })
        elseif action.released then
            self.show_interactable = false
            msg.post("game_scene:/world", "toggle_interactable_highlight", { show = false })
        end
    end
end

---@param self PlayerScriptInstance
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    -- Обработка телепортации (системное действие, например, при загрузке сохранения)
    if message_id == hash("teleport_to") then
        go.set_position(message.position)
        print("Player teleported to:", message.position)
    end

    -- Сигнал от ЛКМ-клика издалека по сундуку или кучке лута на земле (move_to_item)
    if message_id == hash("move_to_item") then
        self.move_target = go.get_world_position(message.item_id)
        self.move_input = vmath.vector3(0, 0, 0)

        msg.post("main:/container_window#gui", "close_window")
        -- 🎯 Ставим твой оригинальный автолут на рельсы
        self.pending_item = message.item_id
        self.pending_event = "click" -- Для ЛКМ базовый ивент бочки
        self.pending_range = 45      -- Оригинальный рабочий радиус
    end

    -- Сигнал от выбора кнопки в Контекстном меню ПКМ
    if message_id == hash("context_menu_action") then
        local target_go_id = message.data.target_go_id
        if target_go_id then
            -- Сразу отправляем персонажа бежать к объекту
            self.move_target = go.get_world_position(target_go_id)
            self.move_input = vmath.vector3(0, 0, 0)
            
            self.pending_item = target_go_id
            
            -- Выставляем дистанцию и ивент в зависимости от выбора в меню
            if message.event == "item_loot_pickup" then
                self.pending_event = "click" -- Сигнал подбора предмета с земли
                self.pending_range = 25      -- 🎯 ДЛЯ ЛУТА НА ЗЕМЛЕ: Уменьшаем радиус до 25 пикселей
            else
                self.pending_event = "click" -- Для сундуков и бочек
                self.pending_range = 45      -- Оставляем стандартные 45 пикселей
            end
        end
    end
end
