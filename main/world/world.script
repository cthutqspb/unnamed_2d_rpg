local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local broadcast = require("main.modules.system.broadcast")
local items_db = require("main.modules.data.items_db")
local world_items_state = require("main.modules.game_state.world_items_state")
local game_state = require("main.modules.game_state.game_state")
local settings = require("main.modules.data.settings")
local interaction = require("main.modules.interaction")

local GRID_SIZE = 32
local DROP_OFFSETS = {
    [1] = { GRID_SIZE, 0 },   -- вправо
    [-1] = { -GRID_SIZE, 0 }, -- влево
    [2] = { 0, GRID_SIZE },   -- вверх
    [-2] = { 0, -GRID_SIZE }  -- вниз
}
local function spawn_saved_items(self)
    local saved_items = world_items_state.get_all()

    for uid, data in pairs(saved_items) do
        -- Спавним только ДИНАМИКУ (дроп). Статика сама разберется в своем init.
        if data.is_dynamic then
            local pos = vmath.vector3(data.pos.x, data.pos.y, 1)
            local item_id = data.item_id
            local item_cfg = items_db.get_item(item_id)

            if item_cfg then
                local item_go = factory.create("#pickup_factory", pos, nil, { is_from_factory = true })

                -- 2. Настраиваем логику (ID, количество, UID)
                msg.post(item_go, "set_item_id", {
                    item_id = item_id,
                    amount = data.amount,
                    uid = uid
                })

                -- 3. Настраиваем ВИЗУАЛ (Спрайт)
                local sprite_url = msg.url(nil, item_go, "sprite")
                local anim = item_cfg.animation or item_cfg.icon
                sprite.play_flipbook(sprite_url, hash(anim))

                -- 4. Настраиваем ТЕКСТ (Название и Количество)
                local item_name = locales.get(item_cfg.name_key)
                label.set_text(msg.url(nil, item_go, "item_name"), item_name)
                
                if data.amount > 1 then
                    label.set_text(msg.url(nil, item_go, "amount"), tostring(data.amount))
                else
                    label.set_text(msg.url(nil, item_go, "amount"), "")
                end

                -- 5. Настраиваем МАСШТАБ (если прописан в базе)
                if item_cfg.scale then
                    go.set_scale(vmath.vector3(item_cfg.scale, item_cfg.scale, 1), item_go)
                end

                print("SPAWNED DYNAMIC ITEM WITH VISUALS:", uid)
            end
        end
    end
end

