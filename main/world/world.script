local broadcast = require("main.modules.broadcast")
local items_db = require("main.modules.items_db")
local GRID_SIZE = 32
local DROP_OFFSETS = {
    [1] = { GRID_SIZE, 0 },   -- вправо
    [-1] = { -GRID_SIZE, 0 }, -- влево
    [2] = { 0, GRID_SIZE },   -- вверх
    [-2] = { 0, -GRID_SIZE }  -- вниз
}

