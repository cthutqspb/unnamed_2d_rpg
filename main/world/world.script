local window_manager = require("main.gui.components.managers.window_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local broadcast = require("main.modules.system.broadcast")
local items_db = require("main.modules.data.items_db")
local world_items_state = require("main.modules.game_state.world_items_state")
local game_state = require("main.modules.game_state.game_state")
local settings = require("main.modules.data.settings")
local gui_utils = require("main.gui.gui_utils")
local camera = require("orthographic.camera")
local character_data = require("main.modules.character.character_data")
local CustomCursor = require("main.gui.components.cursor.CustomCursor")

---@class WorldScriptInstance
---@field player_direction number Направление взгляда игрока (-1 или 1)
---@field drag_active boolean Флаг активного драга в мире
---@field current_hover_id hash|nil
---@field last_player_x number
---@field last_player_y number
---@field last_action table|nil

-- 🚩 УБРАЛИ НЕИСПОЛЬЗУЕМЫЙ DROP_OFFSETS ДЛЯ ЧИСТОТЫ ПАМЯТИ

---Внутренний метод спавна предметов из файла сохранения при загрузке локации
---@private
---@param self WorldScriptInstance
local function spawn_saved_items(self)
    local saved_items = world_items_state.get_all()

    for uid, data in pairs(saved_items) do
        -- Спавним только ДИНАМИКУ (дроп). Статика сама инициализируется на карте
        if data.is_dynamic then
            local pos = vmath.vector3(data.pos.x, data.pos.y, 1)
            local item_id = data.item_id
            local item_cfg = items_db.get_item(item_id)

            if item_cfg then
                -- 1. Спавним пустую физическую сущность из фабрики
                local item_go = factory.create("#item_factory", pos, nil, { is_from_factory = true })

                -- 2. 🎯 MVC-ФИКС: Шлем объекту РЕАЛЬНЫЕ ДАННЫЕ.
                -- Объект сам прочитает свой конфиг и настроит свой спрайт, имя и масштаб!
                msg.post(item_go, "set_item_id", {
                    item_id = item_id,
                    amount = data.amount,
                    uid = uid
                })

                print("WORLD БЭКЕНД: Успешно заспавнен предмет из сейва:", uid)
            end
        end
    end
end

---Внутренний изолированный метод проверки коллизий под курсором (Рейкаст)
---@private
---@param self WorldScriptInstance
---@param gui_pos vector3 Пересчитанные Druid-координаты интерфейса
---@param world_pos vector3 Пересчитанные мировые координаты на карте
local function check_hover(self, gui_pos, world_pos)
    if window_manager.is_over_ui() then
        tooltip_manager.hide_world_tooltips()
        local current_type = tooltip_manager.get_current_type()
        if not tooltip_manager.GUI_TYPES[current_type] then
            CustomCursor.set_style("cursor_default")
        end
        return false
    end

    -- 🎯 ЗАМЕНА РЕЙКАСТА НА ТРИГГЕР-ФОКУС:
    -- Больше никаких лучей, мазаний по краям и вылетов в воздухе!
    -- Берем id, который физический триггер курсора записал нам в контекст.
    local active_id = self.current_hover_id
    if active_id then
        -- Вытаскиваем данные из бэкенд-телефонных книг ("container", "item_loot", "creature")
        local kind, uid, state_data = game_state.get_inspect_info(active_id)

        if kind and state_data then
            local tooltip_type = "world_prop"

            if kind == "item_loot" then
                CustomCursor.set_style("cursor_outline_yellow")
                tooltip_type = state_data.is_dynamic and "gui_item" or "world_prop"

            elseif kind == "creature" then
                CustomCursor.set_style("cursor_outline_red")
                tooltip_type = "world_unit"

            elseif kind == "container" then
                CustomCursor.set_style("cursor_outline_yellow")
                tooltip_type = "world_prop"
            end

            tooltip_manager.show(tooltip_type, state_data, {
                uid = uid,
                kind = kind,
                source = "world"
            })
        end
    else
        -- Если под триггером мыши пусто — принудительно тушим тултип
        tooltip_manager.hide_world_tooltips()
        local cur_type = tooltip_manager.get_current_type()
        if not tooltip_manager.GUI_TYPES[cur_type] then
            CustomCursor.set_style("cursor_default")
        end
    end
end

---Вспомогательная функция перевода экранных координат мыши в мировые пиксели карты
---@private
---@param self WorldScriptInstance
---@param action_x number Экранная координата X мыши
---@param action_y number Экранная координата Y мыши
---@return vector3 Мировые координаты на карте (Z занулен)
local function get_world_mouse_pos(self, action_x, action_y)
    local player_pos = go.get_position("player")
    local screen = settings.resolution

    local world_x = player_pos.x + (action_x - screen.width / 2)
    local world_y = player_pos.y + (action_y - screen.height / 2)

    return vmath.vector3(world_x, world_y, 0)
end

---@param self WorldScriptInstance
function init(self)
    math.randomseed(os.time())
    print("World initialized")
    --msg.post("game_scene:/camera", "follow", { target = go.get_id("/player"), lerp = 0.08 })
    camera.follow(hash("/camera"), hash("/player"), { lerp = 0.2 })
    msg.post(hash("/camera"), "set_automatic_zoom", { enabled = true })
    self.player_direction = 1
    self.drag_active = false
    self.current_hover_id = nil
    -- Инициализируем кэш трекера перемещений
    self.last_player_x = 0
    self.last_player_y = 0
    self.last_action = nil
    -- Запрашиваем фокус ввода для отлова системных бродкастов и кликов по карте
    msg.post(".", "acquire_input_focus")
end

---@param self WorldScriptInstance
function final(self)
    -- Чистим за собой при выгрузке чанка коллекции
end

---@param self WorldScriptInstance
---@param dt number
function update(self, dt)
    local current_player_pos = character_data.player.last_pos
    if not current_player_pos or not self.last_action then return end

    -- Проверяем, сдвинулся ли персонаж на клавиатуре
    local player_moved = (current_player_pos.x ~= self.last_player_x) or (current_player_pos.y ~= self.last_player_y)

    if player_moved then
        -- Пересчитываем координаты (мир ушел, world_pos теперь другой!)
        local gui_pos, world_pos = gui_utils.transform_coordinates(self.last_action, hash("/camera"))

        -- Обновляем позиции в менеджерах
        tooltip_manager.update_mouse(gui_pos.x, gui_pos.y)
        window_manager.update_mouse(gui_pos.x, gui_pos.y)

        -- Проверяем ховер на ходу
        check_hover(self, gui_pos, world_pos)

        -- Запоминаем новую позицию игрока
        self.last_player_x = current_player_pos.x
        self.last_player_y = current_player_pos.y
    end
end

---@param self WorldScriptInstance
---@param dt number
function fixed_update(self, dt)
end

---@param self WorldScriptInstance
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    -- 🎯 ЛОВИМ СИ-ТРИГГЕР ВХОДА/ВЫХОДА МЫШКИ
    if message_id == hash("trigger_response") then
        if message.enter then
            -- Мышка физически наступила на триггер объекта (сундук, скелет)
            self.current_hover_id = message.other_id
        else
            -- Мышка ушла с объекта — зануляем, ТОЛЬКО если ушли именно с текущего
            if self.current_hover_id == message.other_id then
                self.current_hover_id = nil
            end
        end

        -- Мгновенно обновляем тултип при физическом движении мыши (не дожидаясь WASD-апдейта!)
        if self.last_action then
            local gui_pos, world_pos = gui_utils.transform_coordinates(self.last_action, hash("/camera"))
            check_hover(self, gui_pos, world_pos)
        end
    end
    -- Изменение направления взгляда персонажа (для навигации или спавна)
    if message_id == hash("player_direction") then
        self.player_direction = message.direction

    -- Сигнал выброса (дропа) предмета из инвентаря игрока в мир
    elseif message_id == hash("spawn_dropped_item") then
        local player_pos = go.get_position("player")

        -- Используем нашу функцию для расчета точки клика в мире
        local world_mouse = get_world_mouse_pos(self, message.mouse_x, message.mouse_y)

        -- Вычисляем вектор и расстояние направления от игрока к курсору
        local dir = vmath.vector3(world_mouse.x - player_pos.x, world_mouse.y - player_pos.y, 0)
        local dir_norm = vmath.normalize(dir)

        -- Предмет падает ровно в 40 пикселях от тела игрока по вектору мыши
        local drop_distance = 40
        local drop_pos = player_pos + dir_norm * drop_distance

        local item_id = message.item_id
        -- Регистрируем новый уникальный UID шмотки в глобальном реестре данных на земле
        local uid = world_items_state.add(item_id, drop_pos, message.amount, true)

        -- Создаем физическую сущность на карте
        local item_go = factory.create("#pickup_factory", drop_pos, nil, { is_from_factory = true })

        -- 🎯 MVC-ФИКС: Мы шлем объекту ТОЛЬКО ЕГО ДАННЫЕ.
        -- Весь визуал (спрайт флипбука, масштабы и надписи количества)
        -- полностью удален отсюда! Прехаб pickup.script настроит себя сам канонично.
        msg.post(item_go, "set_item_id", {
            item_id = item_id,
            amount = message.amount,
            uid = uid
        })

    -- Сигнал успешного подбора предмета с земли (игрок добежал и залутал)
    elseif message_id == hash("item_pickup") then
        -- Вычеркиваем UID из реестра сейва, чтобы защитить игру от дюпа шмоток
        if message.uid then
            world_items_state.remove(message.uid)
        end

        print("WORLD БЭКЕНД: Убираем из мира предмет: " .. tostring(message.item_id))

        -- Передаем данные в инвентарь игрока
        broadcast.send("inventory_events", {
            message_id = hash("add_item"),
            item_id = message.item_id,
            amount = message.amount
        })
        -- Удаляем физический Game Object с карты
        go.delete(sender)

    -- Перехват хоткея Alt: включаем/выключаем подсветку имен интерактивных объектов
    elseif message_id == hash("toggle_interactable_highlight") then
        print("WORLD КОНТРОЛЛЕР: Рассылаем бродкаст подсветки имен объектов: " .. tostring(message.show))

        broadcast.send("world_events", {
            message_id = hash("toggle_interactable_highlight"),
            show = message.show
        })

    -- Системная команда от Менеджера Сохранений при старте уровня
    elseif message_id == hash("spawn_all_saved_items") then
        spawn_saved_items(self)
    end
end

---@param self WorldScriptInstance
---@param action_id hash|nil
---@param action table
function on_input(self, action_id, action)
     if not action.x then return false end

     -- 🎯 КЭШИРУЕМ ТАБЛИЦУ ACTION: Сохраняем живой, оригинальный инпут от движка Defold
    self.last_action = action

    local gui_pos, world_pos = gui_utils.transform_coordinates(action, hash("/camera"))

    tooltip_manager.update_mouse(gui_pos.x, gui_pos.y)
    window_manager.update_mouse(gui_pos.x, gui_pos.y)

    -- Срабатывает при физическом движении мыши
    if not action_id then
        check_hover(self, gui_pos, world_pos)
    end

        -- 🎯 ЛОГИКА ПРАВОГО КЛИКА МЫШИ (ПКМ) ПО ОБЪЕКТАМ МИРА
    if action_id == hash("mouse_right") and action.pressed then
        -- Полный игнор кликов в мир, если курсор находится над GUI-окном
        if window_manager.is_over_ui() then return false end

        -- Берем ID объекта, который Си-триггер прямо сейчас держит в фокусе под мышкой
        local target_id = self.current_hover_id

        if target_id then
            -- Опрашиваем нашу центральную базу: кто это? (сундук, предмет или наш Скелет)
            local target_type, uid, state_data = game_state.get_inspect_info(target_id)

            if target_type and uid then
                -- Шлем Си-сигнал в слой контекстного меню. Оно откроется пиксель-в-пиксель!
                msg.post("main:/context_menu_layer#gui", "show_menu", {
                    x = action.x,
                    y = action.y,
                    type = target_type,
                    sub_type = nil,
                    flags = {},
                    data = {
                        slot_index = nil,
                        item_id = state_data and state_data.item_id or nil,
                        source_url = msg.url("game_scene:/player"),
                        target_go_id = target_id,
                        target_uid = uid
                    }
                })

                -- 🚩 СИНХРОН ДВИЖЕНИЯ: Приказываем игроку мгновенно остановиться, 
                -- так как открылось меню взаимодействия и бежать никуда не надо!
                msg.post("player", "stop_movement")
            end
        else
            -- Кликнули ПКМ в пустую землю — гасим открытое меню и отправляем персонажа бежать ПКМ-ом!
            msg.post("main:/context_menu_layer#gui", "hide_menu")

            -- Получаем мировые координаты точки клика земли (они у тебя уже посчитаны в on_input)
            msg.post("player", "move_to", { position = world_pos })
        end
    end

    -- 3. ЛОГИКА КЛИКА ЛКМ ПО ИГРОВОМУ ПОЛЮ
    if action_id == hash("touch") and action.pressed then
        -- Полный игнор кликов в мир, если палец нажал на GUI-интерфейс
        if window_manager.is_over_ui() then
            return false
        end

        local active_id = self.current_hover_id
        if active_id then
             msg.post(active_id, "click")
        end
    end

    return false
end

---@param self WorldScriptInstance
function on_reload(self)
end
