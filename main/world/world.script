function on_message(self, message_id, message, sender)
	  -- if message_id == hash("toggle_interactable_highlight") then
   --      print("Broadcasting via Module...")
   --      broadcast.send(message_id, message)
   --  end  

    if message_id == hash("player_direction") then
        self.player_direction = message.direction

    elseif message_id == hash("spawn_dropped_item") then
        local player_pos = go.get_position("player")
        local screen = settings.resolution

        -- Получаем экранные координаты мыши
        local mouse_x = message.mouse_x
        local mouse_y = message.mouse_y

        local world_mouse_x = player_pos.x + (mouse_x - screen.width / 2)
        local world_mouse_y = player_pos.y + (mouse_y - screen.height / 2)

        -- Вектор от игрока к курсору
        local dir = vmath.vector3(world_mouse_x - player_pos.x, world_mouse_y - player_pos.y, 1)
        local dir_norm = vmath.normalize(dir)

        -- Расстояние выпадения (40 пикселей от игрока)
        local drop_distance = 40
        local drop_pos = player_pos + dir_norm * drop_distance

        local item_id = message.item_id
        local uid = world_items_state.add(item_id, drop_pos, message.amount, true)
         -- Создаем объект
        local item_go = factory.create("#pickup_factory", drop_pos, nil, { is_from_factory = true })

        -- Шлем данные. ВАЖНО: set_item_id должен вызвать register в instances, 
        -- если это не сделано в init!
        msg.post(item_go, "set_item_id", {
            item_id = item_id,
            amount = message.amount,
            uid = uid
        })

        -- Визуал
        local data = items_db.get_item(item_id)
        if data then
            local sprite_url = msg.url(nil, item_go, "sprite")
            sprite.play_flipbook(sprite_url, hash(data.animation or data.icon))
            if data.scale then
                go.set_scale(vmath.vector3(data.scale, data.scale, 1), item_go)
            end
        end
    end

    if message_id == hash("pickup_item") then
        -- Удаляем запись из таблицы мировых предметов, чтобы не "дюпалось" при загрузке
        if message.uid then
            world_items_state.remove(message.uid)
        end

        print("WORLD: Picking up " .. tostring(message.item_id))
        broadcast.send("inventory_events", {
            message_id = hash("add_item"),
            item_id = message.item_id,
            amount = message.amount
        })
        go.delete(sender)
    end

    if message_id == hash("toggle_interactable_highlight") then
        print("World broadcasting via MODULE: " .. tostring(message.show))

        -- ВМЕСТО msg.post вызываем функцию модуля
        broadcast.send("world_events", {
            message_id = hash("toggle_interactable_highlight"),
            show = message.show
        })
    end

    if message_id == hash("spawn_all_saved_items") then
        spawn_saved_items(self)
    end
end

local function get_world_mouse_pos(self, action_x, action_y)
    local player_pos = go.get_position("player")
    local screen = settings.resolution
    
    -- Твоя рабочая формула из spawn_dropped_item:
    local world_x = player_pos.x + (action_x - screen.width / 2)
    local world_y = player_pos.y + (action_y - screen.height / 2)
    
    return vmath.vector3(world_x, world_y, 0)
end

