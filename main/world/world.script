local window_manager = require("main.gui.components.managers.window_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local broadcast = require("main.modules.system.broadcast")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local items_db = require("main.modules.data.items_db")
local world_items_state = require("main.modules.game_state.world_items_state")
local game_state = require("main.modules.game_state.game_state")
local settings = require("main.modules.data.settings")
local gui_utils = require("main.gui.gui_utils")
local camera = require("orthographic.camera")
local character_data = require("main.modules.character.character_data")
local CustomCursor = require("main.gui.components.cursor.CustomCursor")
local interaction_manager = require("main.modules.logic.interaction_manager")
local perception_manager = require("main.modules.system.perception_manager")
local combat_manager = require("main.modules.system.combat_manager")

---@class WorldScriptInstance
---@field player_direction number Направление взгляда игрока (-1 или 1)
---@field drag_active boolean Флаг активного драга в мире
---@field current_hover_id hash|nil
---@field last_player_x number
---@field last_player_y number
---@field last_action table|nil
---@field perception_timer number

---Внутренний изолированный метод проверки коллизий под курсором (Рейкаст)
---@private
---@param self WorldScriptInstance
---@param gui_pos vector3 Пересчитанные Druid-координаты интерфейса
---@param world_pos vector3 Пересчитанные мировые координаты на карте
local function check_hover(self, gui_pos, world_pos)
    if window_manager.is_over_ui() then
        tooltip_manager.hide_world_tooltips()
        local current_type = tooltip_manager.get_current_type()
        if not tooltip_manager.GUI_TYPES[current_type] then
            CustomCursor.set_style("cursor_default")
        end
        return false
    end

    -- 🎯 ЗАМЕНА РЕЙКАСТА НА ТРИГГЕР-ФОКУС:
    -- Больше никаких лучей, мазаний по краям и вылетов в воздухе!
    -- Берем id, который физический триггер курсора записал нам в контекст.
    local active_id = self.current_hover_id
    if active_id then
        -- Вытаскиваем данные из бэкенд-телефонных книг ("container", "item_loot", "unit")
        local kind, uid, state = game_state.get_inspect_info(active_id)

        if kind and state then
            local tooltip_type = "world_object"

            if kind == "world_item" then
                CustomCursor.set_style("cursor_outline_yellow")
                tooltip_type = state.is_dynamic and "world_item" or "world_object"

            elseif kind == "unit" then
                CustomCursor.set_style("cursor_outline_red")
                tooltip_type = "world_unit"

            elseif kind == "world_object" then
                CustomCursor.set_style("cursor_outline_yellow")
                tooltip_type = "world_object"
            end

            tooltip_manager.show(tooltip_type, state, {
                uid = uid,
                kind = kind
            })
        end
    else
        -- Если под триггером мыши пусто — принудительно тушим тултип
        tooltip_manager.hide_world_tooltips()
        local cur_type = tooltip_manager.get_current_type()
        if not tooltip_manager.GUI_TYPES[cur_type] then
            CustomCursor.set_style("cursor_default")
        end
    end
end

---Вспомогательная функция перевода экранных координат мыши в мировые пиксели карты
---@private
---@param self WorldScriptInstance
---@param action_x number Экранная координата X мыши
---@param action_y number Экранная координата Y мыши
---@return vector3 Мировые координаты на карте (Z занулен)
local function get_world_mouse_pos(self, action_x, action_y)
    local player_pos = go.get_position("player")
    local screen = settings.resolution

    local world_x = player_pos.x + (action_x - screen.width / 2)
    local world_y = player_pos.y + (action_y - screen.height / 2)

    return vmath.vector3(world_x, world_y, 0)
end

---@param self WorldScriptInstance
function init(self)
    math.randomseed(os.time())
    print("World initialized")
    --msg.post("game_scene:/camera", "follow", { target = go.get_id("/player"), lerp = 0.08 })
    camera.follow(hash("/camera"), hash("/player"), { lerp = 0.2 })
    msg.post(hash("/camera"), "set_automatic_zoom", { enabled = true })
    self.player_direction = 1
    self.drag_active = false
    self.current_hover_id = nil
    -- Инициализируем кэш трекера перемещений
    self.last_player_x = 0
    self.last_player_y = 0
    self.last_action = nil
    self.perception_timer = 0.1
    -- Запрашиваем фокус ввода для отлова системных бродкастов и кликов по карте
    msg.post(".", "acquire_input_focus")
end

---@param self WorldScriptInstance
function final(self)
    -- Чистим за собой при выгрузке чанка коллекции
end

---@param self WorldScriptInstance
---@param dt number
function update(self, dt)
    -- 🛡️ ЗАЩИТА ЭКРАНА: Полностью блокируем отрисовку текста, если бэкенд пустой
    ---@type UnitInstance
    local player = character_data.player
    if not player or not player.base_attributes or not player.attributes then
        return
    end

    local current_player_position = character_data.player.saved_position
    if not current_player_position or not self.last_action then return end

    -- Проверяем, сдвинулся ли персонаж на клавиатуре
    local player_moved = (current_player_position.x ~= self.last_player_x) or (current_player_position.y ~= self.last_player_y)

    if player_moved then
        -- Пересчитываем координаты (мир ушел, world_pos теперь другой!)
        local gui_pos, world_pos = gui_utils.transform_coordinates(self.last_action, hash("/camera"))

        -- Обновляем позиции в менеджерах
        tooltip_manager.update_mouse(gui_pos.x, gui_pos.y)
        window_manager.update_mouse(gui_pos.x, gui_pos.y)

        -- Проверяем ховер на ходу
        check_hover(self, gui_pos, world_pos)

        -- Запоминаем новую позицию игрока
        self.last_player_x = current_player_position.x
        self.last_player_y = current_player_position.y
    end

    -- 🦾 1. ТАЙМЕРЫ И КД (КАЖДЫЙ КАДР):
    -- Отсчет тиков ГКД на панелях и кастбары обязаны обновляться плавно, 
    -- чтобы полоски на HUD не дергались как паралитики.
    if game_state and game_state.update_all_timers then
        game_state.update_all_timers(dt)
    end

    -- 🦾 2. СИМУЛЯЦИЯ ФИЗИКИ СНАРЯДОВ (КАЖДЫЙ КАДР):
    -- Движение стрел, магии и проверка коллизий импакта — строго на максимальной 
    -- частоте кадров твоего монитора (60/144 FPS) без малейших задержек!
    combat_manager.simulate_combat_effects(dt)

    -- =========================================================================
    -- 🧠 3. ЛЕНИВЫЙ ИИ-ТИКЕР ВOСПРIЯТIЯ (РАЗ В 0.1 СЕК — ОПТИМИЗАЦИЯ CPU):
    -- =========================================================================
    self.perception_timer = self.perception_timer - dt
    if self.perception_timer <= 0 then
        perception_manager.update_threat_perception()
        self.perception_timer = 0.1
    end
    -- =========================================================================    
end

---@param self WorldScriptInstance
---@param dt number
function fixed_update(self, dt)
end

---@param self WorldScriptInstance
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    -- 🎯 ЛОВИМ СИ-ТРИГГЕР ВХОДА/ВЫХОДА МЫШКИ
    if message_id == hash("trigger_response") then
        if message.enter then
            -- Мышка физически наступила на триггер объекта (сундук, скелет)
            self.current_hover_id = message.other_id
        else
            -- Мышка ушла с объекта — зануляем, ТОЛЬКО если ушли именно с текущего
            if self.current_hover_id == message.other_id then
                self.current_hover_id = nil
            end
        end

        -- Мгновенно обновляем тултип при физическом движении мыши (не дожидаясь WASD-апдейта!)
        if self.last_action then
            local gui_pos, world_pos = gui_utils.transform_coordinates(self.last_action, hash("/camera"))
            check_hover(self, gui_pos, world_pos)
        end
    end
    -- Изменение направления взгляда персонажа (для навигации или спавна)
    if message_id == hash("player_direction") then
        self.player_direction = message.direction

    elseif message_id == hash("spawn_world_item") then
        -- Базовые параметры, общие для ВСЕХ типов спавна
        local item_id = message.item_id       -- Для плеера: "iron_sword", для моба: "unit_loot_bag"
        local drop_pos = message.position     -- Готовая точка на Meadows-земле
        local source_type = message.source    -- "player", "unit", "object"

        -- 1. 🎯 ЕДИНАЯ РЕГИСТРАЦИЯ ДУШИ В RAM (ИСПРАВЛЕНО):
        -- Метод add возвращает готовую таблицу паспорта из RAM-реестра.
        -- Мы записываем её ПРЯМО в переменную world_item, минуя лишние поиски!
        local world_item = world_items_state.add(message.item_uid, {
            item_id = item_id,
            saved_position = drop_pos,
            amount = message.amount or 1,
            is_dynamic = true,
            loot_table_id = message.loot_table_id or "empty",
            is_looted = message.is_looted
        })

        -- Переменная final_uid (если она нужна ниже по коду) хранит чистокровную строку!
        local final_uid = message.item_uid

        if world_item then
            world_item.source_type = source_type -- Запекаем тип источника в Душу на будущее

            -- 2. 🌲 ДEРEВO ВAРИAНТOВ ПO ФЛAГУ SOURCE
            -- =====================================================================
            -- ВЕТКА А: Дроп из кармана Игрока (Переносим готовый живой массив шмоток)
            -- =====================================================================
            if source_type == character_data.PLAYER_UID or source_type == "player" then
                world_item.items = message.items
                world_item.is_looted = message.is_looted or false
                world_item.loot_table_id = "empty"

            -- =====================================================================
            -- ВЕТКА Б: Лут из поверженного Монстра (Включаем ленивую генерацию WoW)
            -- =====================================================================
            -- elseif source_type == "unit" then
            --     print("SPAWN ITEM")
            --     world_item.items = nil -- Оставляем пустым для Lazy Evaluation при клике ногами!a
            --     world_item.is_looted = false
            --     world_item.loot_table_id = message.loot_table_id
            --     world_item.source_unit_id = message.unit_id
            --
            --     local unit_cfg = units_db.get_unit(message.unit_id)
            --     if unit_cfg then
            --         world_item.name = unit_cfg.name_key .. "_dead"
            --     else
            --         world_item.name = "ui_corpse_fallback_name" -- на всякий случай
            --     end
            -- =====================================================================
            -- ВЕТКА В: Спавн из интерактивного объекта (Задел под взрыв бочки / сундука)
            -- =====================================================================
            elseif source_type == "object" then
                -- Сюда завтра зайдет логика, если ты взорвешь бочку заклинанием
                world_item.items = nil
                world_item.is_looted = false
                world_item.loot_table_id = message.loot_table_id
            end
        end

        -- 3. 💥 ЕДИНАЯ МАТЕРИАЛИЗАЦИЯ НА ЗЕМЛЕ:
        -- Нам больше не нужно дублировать вызов factory.create()! 
        -- Раз Менеджер Чанков у тебя спавнит объекты на лету по реестру RAM, 
        -- мы просто позволяем твоей бесшовной системе стриминга Meadows материализовать этот мешок.
        -- (Если ты стер ручной factory.create, здесь больше вообще нет Си-кода фабрик!)

        print(string.format("🌍 БЭКЕНД МИРА [spawn_world_item]: Успешно рождена Душа. Источник: %s | ID: %s | UID: %s",
            tostring(source_type), tostring(item_id), tostring(message.item_uid)))

    elseif message_id == hash("item_pickup") then
        ---@type WorldItemInstance|nil
        local item = nil
        if message.uid then
            -- 🎯 BG3-КАНОН: Перед тем как стереть вещь из МИРА, забираем её Душу (с лутом, если он уже был) 
            item = world_items_state.get_item_by_uid(message.uid)
            world_items_state.remove(message.uid)
        end

        actions_dispatcher.REDUCERS["item_add"]({
            item_id = message.item_id,
            amount = message.amount,
            uid = message.uid,
            items = item and item.items or nil,
            is_looted = item and item.is_looted or nil,
            loot_table_id = message.loot_table_id or "empty"
        })

        -- Удаляем физический Game Object с карты
        go.delete(sender)
        tooltip_manager.hide_world_tooltips()

        broadcast.send("log_events", {
            message_id = hash("log_message"),
            channel = "loot",
            text = "Залутан" .. message.item_id .. " (" .. message.amount .. ")"
        })

    -- Перехват хоткея Alt: включаем/выключаем подсветку имен интерактивных объектов
    elseif message_id == hash("toggle_interactable_highlight") then
        print("WORLD КОНТРОЛЛЕР: Рассылаем бродкаст подсветки имен объектов: " .. tostring(message.show))

        broadcast.send("world_events", {
            message_id = hash("toggle_interactable_highlight"),
            show = message.show
        })
    end

    if message_id == hash("prepare_pocket_container") then
        local uid = message.container_uid
        local item_id = message.item_id -- Наша строка "chest_common"!
        local slot_index = message.slot_index

        local db_cfg = items_db.get_item(item_id)

        -- Вытаскиваем Душу карманного сундука из ячейки инвентаря игрока
        local current_unit_uid = message.unit_uid or "player"
        ---@type UnitInstance
        local unit = game_state.get_entity_by_uid(current_unit_uid)

        if not unit or not unit.inventory then
            print("🚨 БЭКЕНД: Не удалось найти рюкзак существа для открытия матрёшки! UID:", current_unit_uid)
            return
        end

        local player_inv = unit.inventory
        local item = player_inv:get_item(slot_index)

         if item then
            if not item.is_looted then
                print('ХЕР ЕСЛИ ЛУТАЛИ')
                local final_loot_id = item.loot_table_id or item_id or "empty"
                if final_loot_id == "" or final_loot_id == "unknown" then
                    final_loot_id = item_id or "empty"
                end

                print("БЭКЕНД [Model]: Первая геймплейная генерация лута Матрёшки по таблице:", final_loot_id)
                local loot_tables = require("main.modules.data.loot_tables")
                item.items = loot_tables.get_loot(hash(final_loot_id)) or {}
                item.is_looted = true
            end

            if not item.items then
                item.items = {}
            end

            -- =========================================================================
            -- 🦾 ВЫСОКОУРОВНЕВОЕ ОБЕРТЫВАНИЕ ВНУТРЕННОСТЕЙ ДЛЯ ТРАНСФЕР-МЕНЕДЖЕРА
            -- =========================================================================
            -- Вспоминаем твой гениальный файл 'inventory_model.lua' (Шаг 1), который мы переписали!
            -- Нам больше НЕ нужен старый файл-враппер. Мы рождаем полноценный ОБЪЕКТНЫЙ инстанс
            -- инвентаря для внутренностей бочки прямо на лету через конструктор .new()!
            -- Мы скармливаем ему пустой owner (так как бочка — это вещь, а не существо) 
            -- и размер сетки из базы (columns * rows). 
            -- И намертво заливаем туда восстановленные шмотки!
            local inventory_model = require("main.modules.models.inventory_model")
            local total_slots = (db_cfg and db_cfg.columns or 6) * (db_cfg and db_cfg.rows or 4)

            local container_instance = inventory_model.new(nil, total_slots)
            container_instance.items = item.items
            container_instance.uid = item.uid -- прокидываем UID для гварда аннигиляции!

            -- Регистрируем этот живой объектный инстанс внутренностей бочки в фокус интерфейсов!
            -- Теперь трансфер-менеджер подхватит его по Duck Typing через .get_item / .set_item!
            interaction_manager.set_focus(container_instance)

            -- Даем команду GUI-окну на отрисовку, прокидывая саму объектную модель в оверрайд!
            msg.post("main:/container_window#gui", "open_container_window", {
                container_uid = uid,
                container_id = hash(item_id),
                container_name = hash(db_cfg and db_cfg.name_key or "container_common_chest_name"),
                container_items = item.items,
                columns = db_cfg and db_cfg.columns or 6,
                rows = db_cfg and db_cfg.rows or 4,
                slot_index = slot_index,
                from_inventory = true,

                -- 🎯 ПРОБРОС ЖИВОЙ МОДЕЛИ ДЛЯ ОКНА ЛУТА:
                -- Мы передаем созданный инстанс контейнера, чтобы окно лута 
                -- зафиксировало его внутри своего StaticGrid без костылей!
                container_model_override = container_instance
            })
        else
            print("🚨 БЭКЕНД: Ошибка! Бочка в слоте рюкзака #" .. tostring(slot_index) .. " не найдена!")
        end
    end
    -- Системная команда от Менеджера Сохранений при старте уровня
    -- elseif message_id == hash("spawn_all_saved_items") then
    --     spawn_saved_items(self)
    -- end
end

---@param self WorldScriptInstance
---@param action_id hash|nil
---@param action table
function on_input(self, action_id, action)
     if not action.x then return false end

     -- 🎯 КЭШИРУЕМ ТАБЛИЦУ ACTION: Сохраняем живой, оригинальный инпут от движка Defold
    self.last_action = action

    local gui_pos, world_pos = gui_utils.transform_coordinates(action, hash("/camera"))

    tooltip_manager.update_mouse(gui_pos.x, gui_pos.y)
    window_manager.update_mouse(gui_pos.x, gui_pos.y)

    -- Срабатывает при физическом движении мыши
    if not action_id then
        check_hover(self, gui_pos, world_pos)
    end

        -- 🎯 ЛОГИКА ПРАВОГО КЛИКА МЫШИ (ПКМ) ПО ОБЪЕКТАМ МИРА
    if action_id == hash("mouse_right") and action.pressed then
        -- Полный игнор кликов в мир, если курсор находится над GUI-окном
        if window_manager.is_over_ui() then return false end

        -- Берем ID объекта, который Си-триггер прямо сейчас держит в фокусе под мышкой
        local target_id = self.current_hover_id

        if target_id then
            -- Опрашиваем нашу центральную базу: кто это? (сундук, предмет или наш Скелет)
            local target_type, uid, state_data = game_state.get_inspect_info(target_id)

            if target_type and uid then
                -- Шлем Си-сигнал в слой контекстного меню. Оно откроется пиксель-в-пиксель!
                msg.post("main:/context_menu_layer#gui", "show_menu", {
                    x = action.x,
                    y = action.y,
                    type = target_type,
                    sub_type = nil,
                    flags = {},
                    data = {
                        slot_index = nil,
                        item_id = state_data and state_data.item_id or nil,
                        source_url = msg.url("game_scene:/player"),
                        target_go_id = target_id,
                        target_uid = uid
                    }
                })

                -- 🚩 СИНХРОН ДВИЖЕНИЯ: Приказываем игроку мгновенно остановиться, 
                -- так как открылось меню взаимодействия и бежать никуда не надо!
                msg.post("player", "stop_movement")
            end
        else
            -- Кликнули ПКМ в пустую землю — гасим открытое меню и отправляем персонажа бежать ПКМ-ом!
            msg.post("main:/context_menu_layer#gui", "hide_menu")

            -- Получаем мировые координаты точки клика земли (они у тебя уже посчитаны в on_input)
            msg.post("player", "move_to", { position = world_pos })
        end
    end

    -- 3. ЛОГИКА КЛИКА ЛКМ ПО ИГРОВОМУ ПОЛЮ
    if action_id == hash("touch") and action.pressed then
        -- Полный игнор кликов в мир, если палец нажал на GUI-интерфейс
        if window_manager.is_over_ui() then
            return false
        end

        local active_id = self.current_hover_id

        if active_id then
            -- 🟢 КЕЙС А: Кликнули ПО ОБЪЕКТУ (Сундук, Лут, Скелет)
            -- Объект перехватывает клик, маг бежит к нему, боевой таргет НЕ СБРАСЫВАЕТСЯ!
            msg.post(active_id, "click")
        else
            -- =========================================================================
            -- 🌱 КЕЙС Б: КЛИКНУЛИ ПО ЧИСТОЙ ТРАВЕ (ДОБАВЛЕНО НАМЕРТВО ПО WoW-КАНОНУ):
            -- =========================================================================
            -- Раз active_id равен nil — под курсором мыши абсолютно пустая земля!
            -- Мы пуленепробиваемо гасим боевую цель мага в RAM через пассивный шлюз!
            if interaction_manager and interaction_manager.clear_target then
                interaction_manager.clear_target()
                print("🌱 WORLD_SCRIPT: Клик по чистой траве. Боевая цель мага сброшена.")
            end
            -- =========================================================================
        end
    end

    return false
end

---@param self WorldScriptInstance
function on_reload(self)
end
