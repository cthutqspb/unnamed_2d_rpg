-- В начале файла, если еще нет

function on_input(self, action_id, action)
    if not action_id then
        -- 1. Обновляем координаты
        tooltip_manager.update_mouse(action.x, action.y)
        window_manager.update_mouse(action.x, action.y)

        local player_pos = go.get_position("player")
        local cx, cy = settings.get_center()
        local world_pos = vmath.vector3(player_pos.x + (action.x - cx), player_pos.y + (action.y - cy), 0)

        local res = interaction.get_target_under_cursor(world_pos)
        
        if res then
            -- Мир просит показать тултип, но менеджер (из Шага 1) 
            -- проигнорирует это, если сейчас открыто окно с предметом
            tooltip_manager.show("world_object", { id = tostring(res), name = "OBJECT_TEST" })
        else
            -- Скрываем, ТОЛЬКО если сейчас показывается именно мировой тултип
            if tooltip_manager.get_current_type() == "world_object" then
                tooltip_manager.hide()
            end
        end
    end
end


