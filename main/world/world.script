function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
    if message_id == hash("player_direction") then
        self.player_direction = message.direction
        
    elseif message_id == hash("spawn_dropped_item") then
        local player_pos = go.get_position("player")
        local direction = self.player_direction  -- используем сохраненное направление
        
        local offset = DROP_OFFSETS[direction] or DROP_OFFSETS[1]
        
        local drop_pos = vmath.vector3(
            player_pos.x + offset[1],
            player_pos.y + offset[2],
            player_pos.z
        )
        
        local data = items_db.get_item(message.item_id)
        if data then
            local item_go = factory.create("#pickup_factory", drop_pos)
            msg.post(item_go, "set_item_id", { item_id = message.item_id })
            local sprite_url = msg.url(nil, item_go, "sprite")
            sprite.play_flipbook(sprite_url, hash(data.animation or data.icon))
            
            if data.scale then
                go.set_scale(vmath.vector3(data.scale, data.scale, 1), item_go)
            end
        end
    end
    
    if message_id == hash("pickup_item") then
        print("pickup_item received in world for:", message.item_id)
        local player_pos = go.get_position("player")
        local item_pos = go.get_position(sender)
        
        -- Расстояние между игроком и предметом
        local distance = vmath.length(player_pos - item_pos)
        
        print("Distance to item:", distance)
        
        if distance < 50 then
            print("Item picked up!")
            
            -- Сохраняем ID предмета
            local item_id = message.item_id
            
            -- Удаляем предмет из мира
            go.delete(sender)
            
            -- Отправляем сообщение в GUI менеджер для добавления в инвентарь
            msg.post("/gui_manager", "add_item_to_inventory", {
                item_id = item_id,
                amount = 1
            })
        else
            print("Too far!")
        end
    end
end

