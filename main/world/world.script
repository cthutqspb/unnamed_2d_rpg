function on_input(self, action_id, action)
    -- ПРОВЕРКА: Если это не мышь (движение или клик), выходим сразу
    -- У событий мыши ВСЕГДА есть поле x
    if not action.x then
        return false
    end

    -- 1. Обновляем координаты (теперь тут 100% есть числа)
    tooltip_manager.update_mouse(action.x, action.y)
    window_manager.update_mouse(action.x, action.y)

    -- Расчет мировых координат
    local player_pos = go.get_position("player")
    local cx, cy = settings.get_center()
    local world_pos = vmath.vector3(player_pos.x + (action.x - cx), player_pos.y + (action.y - cy), 0)

    -- 2. Логика тултипа (только при движении мыши, когда action_id == nil)
    if not action_id then
        if window_manager.is_over_ui() then
            if tooltip_manager.get_current_type() == "world_object" then tooltip_manager.hide() end
            return
        end

        local hits = interaction.get_all_targets_under_cursor(world_pos)
        if hits then
          -- hits[1] - это самый верхний объект (ближайший к камере)
            local top_object = hits[1]
            -- Для теста показываем количество и ID верхнего
            --print("HITS FOUND:", #hits)
            local kind, uid = game_state.get_entity_info(top_object.id)
            if kind then
                print('kind', kind, uid)
                local state_data = game_state.get_data_by_type(kind, uid)
                print('state_data', state_data)
                tooltip_manager.show("world_object", state_data, { uid = uid, kind = kind })
            end
        else
            if tooltip_manager.get_current_type() == "world_object" then
                tooltip_manager.hide()
            end
        end
    end

    -- 3. Логика клика (рейкаст по клику)
    if action_id == hash("touch") and action.pressed then
        if window_manager.is_over_ui() then return end

        local res = interaction.get_target_under_cursor(world_pos)
        if res then
            msg.post(res, "click")
        else
            -- Клик в пустоту — бежим
            msg.post("player", "move_to", { position = world_pos })
        end
    end
end



