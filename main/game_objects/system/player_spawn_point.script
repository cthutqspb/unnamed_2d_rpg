local map_config = require("main.modules.data.map_config")

-- 🎯 DATA-DRIVEN НАСТРОЙКИ ТОЧКИ СПАВНА:
go.property("point_id", hash("default_start"))      -- Уникальный ID точки (mage_start, orc_start, tavern_exit)
go.property("zone_id", hash("meadows"))         -- К какому чанку/зоне принадлежит эта точка
go.property("story_milestone", hash("none"))     -- Метка прогресса (например, hash("prologue_done"))

function init(self)
    -- Отключаем визуальный спрайт флажка в рантайме, чтобы игрок его не видел на траве
    -- msg.post("#sprite", "disable") 

    -- 🎯 АВТО-РЕГИСТРАЦИЯ В ОПЕРАТИВНОЙ ПАМЯТИ:
    -- Точка спавна родилась вместе с чанком и сама записывает свои МИРОВЫЕ координаты
    -- в центральный менеджер карт! Никаких msg.post и поисков по путям.
    map_config.register_spawn_point(self.point_id, {
        position = go.get_position(),
        zone_id = self.zone_id,
        story_milestone = self.story_milestone
    })

    print("📍 ТОЧКА СПАВНА ЗАРЕГИСТРИРОВАНА ЧЕРЕЗ БЭКЕНД:", self.point_id)
end

function final(self)
    -- Если чанк выгружается, убираем точку из оперативной памяти
    map_config.unregister_spawn_point(self.point_id)
end

