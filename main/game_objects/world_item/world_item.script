go.property("uid", hash("")) -- Для предметов из редактора
go.property("item_id",  hash("unknown"))
go.property("amount", 1)
go.property("is_from_factory", false) -- В редакторе всегда false
go.property("loot_table_id", hash("empty"))

local locales = require("main.modules.data.locales.locale_manager")
local interaction = require("main.modules.interaction")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local items_db = require("main.modules.data.items_db")
local broadcast = require("main.modules.system.broadcast")
local world_items_state = require("main.modules.game_state.world_items_state")
local loot_tables = require("main.modules.data.loot_tables")

-- Вспомогательные функции для HUD
---@class WorldItemScriptContext
---@field go_id hash Идентификатор Game Object (физический хэш движка)
---@field uid hash|string Уникальный идентификатор предмета в сейве
---@field item_id string Строковый ID предмета из items_db ("sword", "potion")
---@field amount number Количество предметов в этой кучке
---@field loot_table_id hash|nil
---@field is_from_factory boolean Спавнится ли фабрикой (дроп) или стоит изначально в редакторе
---@field is_interactable boolean Флаг доступности для кликов мыши
---@field broadcast_handler function Ссылка на анонимную функцию-слушатель для корректной отписки

---Вспомогательная функция визуальной подсветки предмета при наведении (ховер)
---@param self WorldItemScriptContext
---@param go_id hash
local function show_highlight(self, go_id)
    go.set_scale(vmath.vector3(1.2, 1.2, 1), go_id)
    -- Показываем текст
    msg.post(msg.url(nil, go_id, "item_name"), "enable")
end

---Вспомогательная функция скрытия подсветки
---@param self WorldItemScriptContext
---@param go_id hash
local function hide_highlight(self, go_id)
    go.set_scale(vmath.vector3(1, 1, 1), go_id)
    -- Скрываем текст
    msg.post(msg.url(nil, go_id, "item_name"), "disable")
end

---Применить графику и имя на основе текущего item_id из базы данных
---@param self WorldItemScriptContext
local function apply_item_visual(self)
    local data = items_db.get_item(self.item_id)
    if data then
        local sprite_url = msg.url(nil, go.get_id(), "sprite")
        sprite.play_flipbook(sprite_url, hash(data.animation))
        label.set_text("#item_name", locales.get(data.name_key))
        if self.amount > 1 then
            label.set_text("#amount", self.amount)
        end
    end
end

---@param self WorldItemScriptContext
function init(self)
    self.go_id = go.get_id()
    local p = go.get_position()

    -- 🎯 ШАГ 1: ГЕНЕРИРУЕМ ЧИСТУЮ СТРОКУ (Не трогая движковый self.uid!)
    local string_uid = interaction.clean_id(self.uid) or ""
    if self.uid == hash("") or string_uid == "" or string.find(string_uid, "unknown") then
        string_uid = string.format("i_%d_%d", math.floor(p.x), math.floor(p.y))
    end

    self.item_id = interaction.clean_id(self.item_id) or "unknown"

    -- Кэшируем чистую строку в СВОЮ собственную переменную контекста!
    self.uid = string_uid

    -- =========================================================================
    -- 1. РЕЖИМ ЗАПЕКАНИЯ ПРЕДМЕТА (Bake Mode)
    -- =========================================================================
    if not self.is_from_factory then
        if world_items_state.is_item_collected and world_items_state.is_item_collected(string_uid) then
            go.delete()
            return
        end

        if world_items_state.is_loaded_from_save and not world_items_state.exists(string_uid) then
            go.delete()
            return
        end

        local entity_data = {
            id = self.item_id,
            amount = self.amount or 1
        }
        local map_config = require("main.modules.data.map_config")
        map_config.bake_entity("meadows", string_uid, "item", entity_data, p)

        if not world_items_state.exists(string_uid) then
            local string_loot_id = interaction.clean_id(self.loot_table_id) or "empty"

            world_items_state.registry[string_uid] = {
                item_id = self.item_id,
                pos = { x = p.x, y = p.y },
                amount = self.amount or 1,
                is_dynamic = false,
                is_collected = false,
                loot_table_id = string_loot_id
            }
        end

        go.delete()
        return
    end

    -- =========================================================================
    -- 2. БОЕВОЙ КОНТУР (Сработает ТОЛЬКО для предметов из Фабрики)
    -- =========================================================================
    -- Передаем чистую локальную строку string_uid напрямую
    world_items_state.register(self.go_id, string_uid)

    self.is_interactable = true
    -- if self.item_id ~= "unknown" and self.item_id ~= hash("unknown") then
    --     apply_item_visual(self)
    -- end

    msg.post("#item_name", "disable")

    self.broadcast_handler = function(data)
        if data.message_id == hash("toggle_interactable_highlight") then
            if data.show then show_highlight(self, self.go_id) else hide_highlight(self, self.go_id) end
        end
    end
    broadcast.subscribe("world_events", self.broadcast_handler)
end


---@param self WorldItemScriptContext
function final(self)
    -- 🎯 ЗEРКAЛЬНЫЙ ААА-ДЕСТРУКТОР (По канону Скелетов):
    -- Перед физическим удалением тела с экрана при стриминге чанков,
    -- мы бережно берем текущие координаты предмета и сохраняем их в Душу в Model!
    if world_items_state.registry and world_items_state.registry[self.uid] then
        local p = go.get_position()
        world_items_state.registry[self.uid].pos = { x = p.x, y = p.y }
    end

    if world_items_state.unregister then
        world_items_state.unregister(self.go_id)
    end

    if self.broadcast_handler then
        broadcast.unsubscribe("world_events", self.broadcast_handler)
    end
end

---@param self WorldItemScriptContext
---@param dt number
function update(self, dt)
end

function fixed_update(self, dt)
end

---@param self WorldItemScriptContext
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    -- =========================================================================
    -- 1. СИГНАЛ ИНИЦИАЛИЗАЦИИ ОТ ФАБРИКИ (Материализация на земле)
    -- =========================================================================
    if message_id == hash("set_item_id") then
        local string_item_id = interaction.clean_id(message.item_id) or "unknown"
        local string_uid = interaction.clean_id(message.uid) or ""

        self.item_id = string_item_id
        self.amount = message.amount or 1
        self.uid = string_uid

        world_items_state.register(self.go_id, string_uid)
        apply_item_visual(self)

        local data = items_db.get_item(self.item_id)
        if data then
            local item_name = locales.get(data.name_key)
            label.set_text("#item_name", item_name)
            if self.amount > 1 then
                label.set_text("#amount", tostring(self.amount))
            else
                label.set_text("#amount", "")
            end
        end
    end

    -- =========================================================================
    -- 2. 🎯 ПРЯМОЙ ПЕРЕХВАТ ЛУТAНИЯ (Из Контекстного Меню ПКМ "Забрать коробку")
    -- =========================================================================
    if message_id == hash("item_pickup") then
        print("БЭКЕНД [WorldItem]: Получена прямая команда подбора в инвентарь: " .. self.item_id)
        
        -- 🎯 СИ-ЗАМОК ДУШИ (Разрыв слепоты фабрики):
        -- Вместо пустого Си-свойства self.loot_table_id мы лезем в Единую Базу world_items_state
        -- по нашему бессмертному self.uid! И забираем оттуда ту самую строковую таблицу лута,
        -- которую маркер бережно запек туда при старте Новой Игры!
        local item_data = world_items_state.get_item_by_uid(self.uid)

        -- Если Душа помнит таблицу из инспектора Tiled — берем её! 
        -- А если Души нет (вещь дропнули из сумки), подстрахуемся дефолтом из items_db
        local string_loot_table_id = "empty"
        if item_data and item_data.loot_table_id and item_data.loot_table_id ~= "empty" then
            string_loot_table_id = item_data.loot_table_id
        else
            local db_cfg = items_db.get_item(self.item_id)
            string_loot_table_id = db_cfg and db_cfg.loot_table_id or "empty"
        end

        print("🔬 СИ-ДЕБАГ: Вытащили зрячую таблицу из Души шмотки мира:", string_loot_table_id)

        -- Пуляем зрячую посылку в мир! Теперь бэкенд соседа гарантированно увидит "chest_common"!
        msg.post("/world#world", "item_pickup", {
            item_id = self.item_id,
            amount = self.amount,
            uid = self.uid,
            loot_table_id = string_loot_table_id -- Улетела зрячая строка контента! [🔍]
        })
        return
    end

    -- =========================================================================
    -- 3. СИГНАЛ КЛИКА ЛКМ (Обычный подход ногами)
    -- =========================================================================
    if message_id == hash("click") then
        interaction.handle_click(self, 50, function()
            local db_cfg = items_db.get_item(self.item_id)
            local action_type = db_cfg and db_cfg.action_type or "item"

            -- -----------------------------------------------------------------
            -- ВЕТКА А: ОБЫЧНЫЙ ЛУТ (Меч, зелье, шлем под ногами)
            -- -----------------------------------------------------------------
            if action_type ~= "container_item" then
                print("PICKUP: Игрок залутал предмет с земли:", self.item_id)
                msg.post("/world#world", "item_pickup", {
                    item_id = self.item_id,
                    amount = self.amount,
                    uid = self.uid
                })

            -- -----------------------------------------------------------------
            -- ВЕТКА Б: МАТРЁШКА (Обычный подход ногами -> Обыск бочки)
            -- -----------------------------------------------------------------
            else
                print("GUI: Игрок обыскивает контейнер-предмет на земле! UID:", self.uid)

                local item_data = world_items_state.get_item_by_uid(self.uid)

                if item_data then
                    actions_dispatcher.REDUCERS["container_open_world"]({
                        uid = self.uid,
                        id = self.item_id,
                        db_cfg = db_cfg,
                        instance_data = item_data, -- Передали живой стейт аргументом!
                        position = go.get_position()
                    })
                else
                    print("🚨 БЭКЕНД: Критическая ошибка! Душа бочки [" .. self.uid .. "] не найдена!")
                end
            end
        end)
    end
end


function on_reload(self)

end
