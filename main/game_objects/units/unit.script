go.property("uid", hash(""))
go.property("unit_id", hash("unknown_unit"))
go.property("unit_level", 1)
go.property("unit_rank", hash("common"))
go.property("is_from_factory", false) -- В редакторе всегда false
go.property("loot_table_id", hash("empty"))

local locales = require("main.modules.data.locales.locale_manager")
local interactions = require("main.modules.interactions")
local units_db = require("main.modules.data.units_db")
local broadcast = require("main.modules.system.broadcast")
local units_state = require("main.modules.game_state.units_state")
local unit_ai = require("main.modules.unit.ai.unit_ai")
local interaction_manager = require("main.modules.logic.interaction_manager")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local map_config = require("main.modules.data.map_config")

---@class UnitScriptContext : AIUnitContext  -- Наследуем класс ИИ!
---@field go_id hash
---@field uid string
---@field unit_id string
---@field unit_level number
---@field unit_rank string
---@field unit_type string
---@field loot_table_id string
---@field is_from_factory boolean
---@field speed number                 -- Наша рабочая скорость для ИИ
---@field hitbox_size number  
---@field ai_profile string            -- Профиль ИИ из базы данных
---@field spawn_position vector3            -- Точка дома для патруля
---@field saved_position vector3
---@field ai_is_patrolling boolean     -- Флаг снижения скорости в патруле

---@param self UnitScriptContext
function init(self)
    self.go_id = go.get_id()
    self.spawn_position = go.get_position()

    -- 1. Стерильно очищаем идентификаторы из редактора / фабрики
    local string_uid = interactions.clean_id(self.uid) or ""
    local string_id = interactions.clean_id(self.unit_id) or "unknown_unit"
    local string_rank = interactions.clean_id(self.unit_rank) or "common"
    local string_type = interactions.clean_id(self.unit_type) or ""
    local string_loot_table_id = interactions.clean_id(self.loot_table_id) or "empty"
    print("STRING UID 1:", string_uid)
    -- Если UID пустой (моб стоит изначально в редакторе), генерируем его по координатам
    if self.uid == hash("") or string_uid == "" or string.find(string_uid, "unknown") then
        string_uid = string.format(
            "c_%d_%d",
            math.floor(self.spawn_position.x + 0.5), -- 🛡️ Честное округление до ближайшего целого
            math.floor(self.spawn_position.y + 0.5)
        )
    end

    self.uid = string_uid

    -- =========================================================================
    -- 🧱 ФAЗA 1: РEЖИМ ЗAПEКAНИЯ СУЩEСТВA (Bake Mode — Зеркало предметов!)
    -- =========================================================================
    if not self.is_from_factory then
        -- Вызываем наш чистый симметричный метод-вопрос!
        if units_state.is_unit_collected and units_state.is_unit_collected(string_uid) then
            go.delete()
            return
        end

        if units_state.is_loaded_from_save and not units_state.exists(string_uid) then
            go.delete()
            return
        end

        local dynamic_chunk_id = interactions.get_current_defold_chunk()

        -- Запекаем чертеж монстра в конфигуратор карты
        local entity_data = {
            id = string_id,
            level = self.unit_level or 1,
            rank = string_rank
        }

        local saved_data = units_state.get(string_uid)

        local baked_position = self.spawn_position

        if saved_data and saved_data.saved_position then
            baked_position = saved_data.saved_position
        end
        print("STRING UID", string_uid)
        map_config.bake_entity(
            dynamic_chunk_id,
            string_uid,
            "unit",
            entity_data,
            baked_position or self.spawn_position
        )

        -- Если Души моба еще нет в реестре RAM — запекаем паспорт через M.add!
        if not units_state.exists(string_uid) then
            units_state.add(string_uid, {
                unit_id = string_id,
                level = self.unit_level or 1,
                type = string_type,
                rank = string_rank,
                loot_table_id = string_loot_table_id,
                saved_position = self.spawn_position
            })
        end

        go.delete()
        return
    end

    -- =========================================================================
    -- ⚔️ ФAЗA 2: БОЕВОЙ КОНТУР (Сработает ТОЛЬКО для монстров из Фабрики)
    -- =========================================================================
    -- Легально вызываем инкапсулированный метод связи! Никакой ручной лапши с таблицами!
    units_state.register(self.go_id, string_uid)

    -- Читаем чистокровные, стопроцентно защищенные данные из RAM-памяти (или файла сохранения)
    local unit_instance_data = units_state.get_unit_by_uid(string_uid)

    -- 🛡️ 1. UNIT-КАНОН СИНХРОНИЗАЦИИ СТРОК (ДОБАВЛЕНО):
    -- берем чистокровную строку unit_id ("skeleton_warrior") НАПРЯМУЮ из RAM-паспорта!
    -- Перезаписываем string_id, полностью уничтожая мутацию в драконов!
    if unit_instance_data and unit_instance_data.unit_id then
        string_id = unit_instance_data.unit_id
    end
    self.unit_id = string_id -- Намертво сохраняем строку в контекст объекта для on_message!

    -- Стучимся в статичную базу units_db по ЧИСТОЙ, ИСПРАВЛЕННОЙ строке!
    local db_cfg = units_db.get_unit(string_id)

    if unit_instance_data then
        -- 🌟 WOW-РЕАНИМАЦИЯ ТРУПА ИЗ СЕЙВА ПОСЛЕ СТРИМИНГА ЧАНКОВ:
        -- Возвращаем на место координаты, если это загрузка сейва
        if unit_instance_data.saved_position then
            go.set_position(unit_instance_data.saved_position)
        end

        -- 🛡️ 2. ПРИНУДИТЕЛЬНЫЙ ПЕРЕКРАС И МАСШТАБ (ПЕРЕНЕСЕНО СЮДА, ДО ГВАРДА СМЕРТИ!):
        -- Срываем дефолтную шкуру дракона с прехаба до того, как сработает return трупа.
        -- Теперь объект гарантированно сменит визуал на скелета в первую же наносекунду!
        local anim_name = db_cfg and db_cfg.animation or string_id
        if sprite then
            sprite.play_flipbook("#sprite", hash(anim_name))
        end

        if db_cfg and db_cfg.hitbox_size then
            local base_prefab_size = 64
            local scale_factor = db_cfg.hitbox_size / base_prefab_size
            go.set_scale(vmath.vector3(scale_factor, scale_factor, 1))
        end

        if unit_instance_data.is_dead then
            for k,v in pairs(unit_instance_data) do
                print("PAIRS", k,v)
            end
            -- Моб заспавнился из сейва мертвым! 
            -- ЗАПРЕЩЕНО жестко дергать go.set в init на первом микрокадре!
            -- шлем асинхронный Си-пакет самому себе ("."), чтобы движок уложил 
            -- труп набок на следующем тике кадра, когда все компоненты на 100% запекутся!
            msg.post(".", "apply_dead_state_after_spawn")

            self.loot_table_id = unit_instance_data.loot_table_id
            print(string.format("💀 СУЩЕСТВО [%s]: Поставили асинхронную реанимацию трупа в очередь кадра.", string_uid))
            return -- Отрезаем инициализацию живого ИИ, как у тебя и было!
        end

        -- Читаем сочные, уже посчитанные от уровня и ранга статы из возвращенной структуры сейва!
        self.speed = unit_instance_data.speed or 90
        self.hitbox_size = unit_instance_data.hitbox_size or 64
        self.ai_profile = unit_instance_data.ai_profile or "aggressive_patrol"
        self.loot_table_id = unit_instance_data.loot_table_id

        -- (Отсюда блок смены спрайта и масштаба удален, так как мы выполнили его выше!)
    else
        -- Экстренный фоллбек, если бэкенд почему-то выдал nil
        self.speed = db_cfg and db_cfg.base_speed or 90
        self.hitbox_size = db_cfg and db_cfg.hitbox_size or 64
        self.ai_profile = db_cfg and db_cfg.ai_profile or "aggressive_patrol"
        self.loot_table_id = string_loot_table_id

        -- Фоллбек перекраса на случай краша RAM-реестра
        local anim_name = db_cfg and db_cfg.animation or string_id
        if sprite then sprite.play_flipbook("#sprite", hash(anim_name)) end
    end

    -- Запускаем ИИ живого моба
    unit_ai.init(self.ai_profile, self)
end

---@param self UnitScriptContext
function final(self)
    if units_state.unregister then
        units_state.unregister(self.go_id)
    end
end

function update(self, dt)
    -- 🛡️ WOW-КАНОН ОПТИМИЗАЦИИ:
    -- Если этот объект — призрак из редактора, который пришел запечь карту,
    -- мы мгновенно прерываем update. Ему запрещено думать, ходить и спамить в бэкенд!
    if not self.is_from_factory then return end

    -- Опрашиваем профиль ИИ из базы данных

    local move_direction = unit_ai.update(self.ai_profile, self, dt)

    -- Если мозг выдал вектор направления движения — плавно сдвигаем Game Object в мире
    if move_direction then
        local current_speed = self.speed

        -- Если профиль-мозг пометил флаг патруля, режем боевую скорость пополам
        if self.ai_is_patrolling then
            current_speed = current_speed * 0.5
        end

        local position = go.get_position()
        -- 🎯 СЧИТАЕМ НОВУЮ ТОЧКУ ДЛЯ КАДРА
        local next_position = position + move_direction * current_speed * dt

        -- Физически сдвигаем тушку моба на Meadows-карте
        go.set_position(next_position)

        -- =========================================================================
        -- 🚀 СИНХРОНИЗАЦИЯ СТЕЙТА С ПЛАШКАМИ ИМЕН (WoW-канон):
        -- =========================================================================
        -- Мы вызываем твой бэкенд-мутатор, передавая ему свежесчитанный vector3!
        -- Теперь gui_script на этом же кадре прочитает из RAM новые координаты,
        -- и плашка ХП плавно покатится по экрану вслед за бегущим скелетом!
        units_state.update_data(self.uid, {
            saved_position = next_position,
        })
        -- =========================================================================
    end
end


function late_update(self, dt)
end

function fixed_update(self, dt)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("click") then
        interaction_manager.set_target(self.go_id, self.uid)

        local unit_data = units_state.get(self.uid)
        local is_unit_dead = unit_data and unit_data.is_dead or false

        if is_unit_dead then
            interactions.handle_click(self, 50, function()
              local db_cfg = units_db.get_unit(self.unit_id)

              -- 🎯 ВЫЗЫВАЕМ ОБЩИЙ ЭКШЕН:
              actions_dispatcher.REDUCERS["container_open"]({
                  entity_type = "unit",
                  uid = self.uid,
                  id = self.unit_id,
                  db_cfg = db_cfg,
                  instance_data = unit_data, -- Передали живой стейт аргументом!
                  position = go.get_position()
              })
            end)
        else
            print("⚔️ БОЙ: Юнит жив, готовы к автоатаке...")
        end
    end

    if message_id == hash("on_unit_damaged") then
        -- 🎯 RIMWORLD-КАНОН (Вспышка урона):
        -- 1. Мгновенно выставляем цвет спрайта в чистый ярко-красный vector4(2, 0, 0, 1)
        -- (Мы задираем R в двойку, чтобы красный цвет сочно светился даже через шейдеры!)
        go.set("#sprite", "tint", vmath.vector4(2, 0, 0, 1))

        -- 2. Запускаем встроенный интерполятор Defold, который за 0.15 секунды 
        -- плавно вернет цвет спрайта в дефолтный белый vector4(1, 1, 1, 1)!
        -- Никаких Lua-таймеров в update, движок все обсчитает нативно на Си-уровне!
        go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTSINE, 0.15)

    elseif message_id == hash("on_unit_died") then
        -- 1. Стучимся в Модель и официально выставляем флаг смерти в RAM!
        -- Мы передаем текущие нулевые параметры здоровья и флаг, что юнит мертв
        local current_position = go.get_position()
        local dead_body_pos = vmath.vector3(current_position.x, current_position.y, 0.9)
        go.set_position(dead_body_pos)

        units_state.update_data(self.uid, {
            health = 0,
            is_dead = true,
            saved_position = dead_body_pos
        })

        msg.post("#collision_collider", "disable")

        if sprite then
            go.set("#sprite", "tint", vmath.vector4(0.4, 0.4, 0.4, 1))
        end

        local rotation_quat = vmath.quat_rotation_z(math.rad(-90))
        go.set_rotation(rotation_quat)

        unit_ai.disable(self)
        interaction_manager.clear_target()

        print(string.format("💀 СУЩЕСТВО [%s]: Физическое тело перешло в режим ТРУПА. Ждем обыска карманов.", self.uid))
    elseif message_id == hash("apply_dead_state_after_spawn") then
        -- На этом тике кадра все Си-компоненты объекта заспавнились полностью!
        -- Мы можем со спокойной душой выключить физику и завалить спрайт набок!
        msg.post("#collision_collider", "disable")

        -- Красим в серый мертвенный цвет (Твоя точка краша теперь пуленепробиваема!)
        go.set("#sprite", "tint", vmath.vector4(0.4, 0.4, 0.4, 1))

        -- Ровный флип набок на -90 градусов
        local rotation_quat = vmath.quat_rotation_z(math.rad(-90))
        go.set_rotation(rotation_quat)

        -- Наглухо обесточиваем покадровую логику ИИ
        unit_ai.disable(self)
        return
    end
end

function on_input(self, action_id, action)
end

function on_reload(self)
end
