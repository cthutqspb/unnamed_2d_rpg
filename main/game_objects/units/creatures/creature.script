---@param self CreatureScriptContext
function final(self)
    if creatures_state.unregister then
        -- Перед удалением отправляем текущую позицию ИИ в бэкенд-стейт
        local current_data = creatures_state.get(self.uid) or {}
        current_data.saved_position = go.get_position()
        -- Сохраняем измененные данные (включая ХП, если есть) обратно в creatures_db/state
        creatures_state.update_data(self.uid, current_data)

        creatures_state.unregister(self.go_id)
    end
end

function update(self, dt)
     -- Опрашиваем профиль ИИ из базы данных, передавая контекст self конкретного моба
    local move_dir = creature_ai.update(self.ai_profile, self, dt)

    -- Если мозг выдал вектор направления движения — плавно сдвигаем Game Object в мире
    if move_dir then
        local current_speed = self.speed

        -- Если профиль-мозг пометил флаг патруля, режем боевую скорость пополам
        if self.ai_is_patrolling then
            current_speed = current_speed * 0.5
        end

        local pos = go.get_position()
        go.set_position(pos + move_dir * current_speed * dt)
    end
end

function late_update(self, dt)
end

function fixed_update(self, dt)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("click") then
        interaction_manager.set_target(self.go_id, self.uid)

        local creature_data = creatures_state.get(self.uid)
        local is_unit_dead = creature_data and creature_data.is_dead or false

        if is_unit_dead then
            local db_cfg = creatures_db.get_creature(self.creature_id)

            -- 🎯 ВЫЗЫВАЕМ ОБЩИЙ ЭКШЕН:
            actions_dispatcher.REDUCERS["container_open_world"]({
                uid = self.uid,
                id = self.creature_id,
                db_cfg = db_cfg,
                instance_data = creature_data, -- Передали живой стейт аргументом!
                position = go.get_position()
            })
        else
            print("⚔️ БОЙ: Юнит жив, готовы к автоатаке...")
        end
    end

    if message_id == hash("on_creature_died") then
        -- 1. Стучимся в Модель и официально выставляем флаг смерти в RAM!
        -- Мы передаем текущие нулевые параметры здоровья и флаг, что юнит мертв
        creatures_state.update_data(self.uid, {
            health = 0,
            is_dead = true,
            saved_position = go.get_position()
        })

        -- 2. Отключаем боевой коллайдер, чтобы сквозь труп можно было ходить,
        -- и чтобы боевой рейкаст автоатак по нему больше не попадал
        --msg.post("#collision_combat", "disable") -- Подставь точное имя твоего коллайдера!

        -- 3. Выключаем ИИ
        -- creature_ai.disable(self) -- (Внедряем тот метод смены стейта в "dead", о котором говорили)

        -- 4. 🎯 ОФИЦИАЛЬНОЕ ОКРАШИВАНИЕ ТРУПА В Defold (WoW-канон без рисования):
        -- Мы меняем свойство tint у компонента #sprite.
        -- Передаем вектор vector4(R, G, B, A):
        -- R=0.4, G=0.4, B=0.4 — приглушают цвета, делая спрайт мертвенно-серым.
        -- A=0.6 — делает тело слегка полупрозрачным, уводя его на задний план мира Meadows.
        if sprite then
            go.set("#sprite", "tint", vmath.vector4(0.4, 0.4, 0.4, 1))
        end

        -- =========================================================================
        -- 🤸‍♂️ ВEЛИКИЙ ААА-ФЛИП НАБОК (Инди-канон Meadows):
        -- =========================================================================
        -- Математика Defold: поворачиваем игровой объект вокруг оси Z.
        -- math.rad(-90) переводит -90 градусов в радианы, которые ждет кватернион.
        -- Объект мгновенно шмякнется горизонтально на левый бок!
        local rotation_quat = vmath.quat_rotation_z(math.rad(-90))
        go.set_rotation(rotation_quat)

        creature_ai.disable(self)
        interaction_manager.clear_target()

        print(string.format("💀 СУЩЕСТВО [%s]: Физическое тело перешло в режим ТРУПА. Ждем обыска карманов.", self.uid))
    end
end

function on_input(self, action_id, action)
end

function on_reload(self)
end
