go.property("uid", hash(""))
go.property("creature_id", hash("unknown_creature"))
go.property("creature_level", 1)
go.property("creature_rank", hash("common"))
go.property("is_from_factory", false) -- В редакторе всегда false
go.property("loot_table_id", hash("empty"))

local locales = require("main.modules.data.locales.locale_manager")
local interaction = require("main.modules.interaction")
local creatures_db = require("main.modules.data.creatures_db")
local broadcast = require("main.modules.system.broadcast")
local creatures_state = require("main.modules.game_state.creatures_state")
local creature_ai = require("main.modules.creature.ai.creature_ai")
local interaction_manager = require("main.modules.logic.interaction_manager")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local map_config = require("main.modules.data.map_config")

---@class CreatureScriptContext : AICreatureContext  -- Наследуем класс ИИ!
---@field go_id hash
---@field uid string
---@field creature_id string
---@field creature_level number
---@field creature_rank string
---@field creature_type string
---@field loot_table_id string
---@field is_from_factory boolean
---@field speed number                 -- Наша рабочая скорость для ИИ
---@field hitbox_size number           
---@field attack_range_melee number    
---@field ai_profile string            -- Профиль ИИ из базы данных
---@field spawn_pos vector3            -- Точка дома для патруля
---@field saved_position vector3
---@field ai_is_patrolling boolean     -- Флаг снижения скорости в патруле

---@param self CreatureScriptContext
function init(self)
    self.go_id = go.get_id()
    self.spawn_pos = go.get_position()

    -- 1. Стерильно очищаем идентификаторы из редактора / фабрики
    local string_uid = interaction.clean_id(self.uid) or ""
    local string_id = interaction.clean_id(self.creature_id) or "unknown_creature"
    local string_rank = interaction.clean_id(self.creature_rank) or "common"
    local string_type = interaction.clean_id(self.creature_type) or ""
    local string_loot_table_id = interaction.clean_id(self.loot_table_id) or "empty"

    -- Если UID пустой (моб стоит изначально в редакторе), генерируем его по координатам
    if self.uid == hash("") or string_uid == "" then
        string_uid = string.format("c_%d_%d", math.floor(self.spawn_pos.x), math.floor(self.spawn_pos.y))
    end

    self.uid = string_uid

    -- =========================================================================
    -- 🎯 ЕДИНАЯ РЕГИСТРАЦИЯ БЭКЕНДА (WoW-канон для любого типа спавна!)
    -- =========================================================================
    -- Мы вызываем твой рабочий M.register, передавая ВСЕ параметры, включая loot_table_id!
    -- Твой метод сам запишет данные в M.registry[uid] и свяжет Си-адрес в M.instances
    local creature_instance_data = creatures_state.register(self.go_id, {
        creature_id = string_id,
        creature_uid = string_uid,
        level = self.creature_level or 1,
        type = string_type,
        rank = string_rank,
        loot_table_id = string_loot_table_id -- 🎯 ТЕПЕРЬ ТАБЛИЦА ДРОПА НИКОГДА НЕ ПОТЕРЯЕТСЯ!
    })

    -- =========================================================================
    -- 🤖 СИНХРОНИЗАЦИЯ СТЕЙТА И ХАРАКТЕРИСТИК ДЛЯ ИИ
    -- =========================================================================
    -- Стучимся в статичную базу creatures_db, чтобы вытащить имя анимации и базовые скейлы
    local db_cfg = creatures_db.get_creature(string_id)

    if creature_instance_data then
        -- Читаем сочные, уже посчитанные от уровня и ранга статы из возвращенной структуры!
        self.speed = creature_instance_data.speed or 90
        self.hitbox_size = creature_instance_data.hitbox_size or 64
        self.attack_range_melee = creature_instance_data.attack_range_melee or 8
        self.ai_profile = creature_instance_data.ai_profile or "aggressive_patrol"

        -- 🌟 СОХРАНЯЕМ СТРОКУ ТАБЛИЦЫ ДРОПА В КОНТЕКСТ СКРИПТА!
        -- Теперь, когда моб умрет, self.loot_table_id гарантированно будет содержать "chest_common"
        self.loot_table_id = creature_instance_data.loot_table_id

        -- Зрячая смена спрайта (Твой рабочий код)
        local anim_name = db_cfg and db_cfg.animation or string_id
        if sprite then
            sprite.play_flipbook("#sprite", hash(anim_name))
        end

        -- Принудительный масштаб хитбокса для фабрики коллекций (Твой рабочий фикс)
        if self.is_from_factory and db_cfg and db_cfg.hitbox_size then
            local base_prefab_size = 64
            local scale_factor = db_cfg.hitbox_size / base_prefab_size
            go.set_scale(vmath.vector3(scale_factor, scale_factor, 1))
        end

        -- Возвращаем на место координаты, если это загрузка сейва (Твой рабочий код)
        -- (Для новой игры saved_position будет nil, и моб останется на точке спавна)
        if creature_instance_data.saved_position then
            go.set_position(creature_instance_data.saved_position)
        end
    else
        -- Экстренный фоллбек, если бэкенд почему-то выдал nil
        self.speed = db_cfg and db_cfg.base_speed or 90
        self.hitbox_size = db_cfg and db_cfg.hitbox_size or 64
        self.attack_range_melee = db_cfg and db_cfg.attack_range_melee or 8
        self.ai_profile = db_cfg and db_cfg.ai_profile or "aggressive_patrol"
        self.loot_table_id = string_loot_table_id
    end

    -- Запускаем ИИ моба
    creature_ai.init(self.ai_profile, self)
end


