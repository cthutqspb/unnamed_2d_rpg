go.property("uid", hash(""))
go.property("creature_id", hash("unknown_creature"))
go.property("creature_level", 1)
go.property("creature_rank", hash("common"))
go.property("is_from_factory", false) -- В редакторе всегда false

local locales = require("main.modules.data.locales.locale_manager")
local interaction = require("main.modules.interaction")
local creatures_db = require("main.modules.data.creatures_db")
local broadcast = require("main.modules.system.broadcast")
local creatures_state = require("main.modules.game_state.creatures_state")
local creature_ai = require("main.modules.creature.ai.creature_ai")
local interaction_manager = require("main.modules.logic.interaction_manager")
local map_config = require("main.modules.data.map_config")

---@class CreatureScriptContext : AICreatureContext  -- Наследуем класс ИИ!
---@field go_id hash
---@field uid string
---@field creature_id string
---@field creature_level number
---@field creature_rank string
---@field creature_type string
---@field is_from_factory boolean
---@field speed number                 -- Наша рабочая скорость для ИИ
---@field hitbox_size number           
---@field attack_range_melee number    
---@field ai_profile string            -- Профиль ИИ из базы данных
---@field spawn_pos vector3            -- Точка дома для патруля
---@field saved_position vector3
---@field ai_is_patrolling boolean     -- Флаг снижения скорости в патруле

---@param self CreatureScriptContext
function init(self)
    self.go_id = go.get_id()
    self.spawn_pos = go.get_position()

    local string_uid = interaction.clean_id(self.uid) or ""
    local string_id = interaction.clean_id(self.creature_id) or "unknown_creature"
    local string_rank = interaction.clean_id(self.creature_rank) or "common"
    local string_type = interaction.clean_id(self.creature_type) or ""

    -- =========================================================================
    -- 1. РЕЖИМ ЗАПЕКАНИЯ СУЩНОСТИ (Bake Mode)
    -- Если Скелет родился напрямую из редактора, он работает как энтити-маркер
    -- =========================================================================
    if not self.is_from_factory then
        -- Если UID пустой, генерируем по начальной точке спавна
        if self.uid == hash("") or string_uid == "" then
            local creature_position = go.get_position()
            string_uid = string.format("c_%d_%d", math.floor(creature_position.x), math.floor(creature_position.y))
        end

        

        -- ПОЛИМОРФНОЕ ЗАПЕКАНИЕ СУЩНОСТИ:
        -- Упаковываем параметры в плоскую таблицу и шлем в центральный конфиг
        local entity_data = {
            id = string_id,
            level = self.creature_level or 1,
            rank = string_rank
        }
        map_config.bake_entity("meadows", string_uid, "creature", entity_data, self.spawn_pos)

        -- РЕГИСТРИРУЕМ ДУШУ В ПАМЯТИ БЭКЕНДА (Если это первый старт новой игры)
        if not creatures_state.exists_by_uid or not creatures_state.exists_by_uid(string_uid) then
            if creatures_state.register_by_uid then
                creatures_state.register_by_uid(string_uid, {
                    creature_id = string_id,
                    level = self.creature_level or 1,
                    rank = string_rank,
                    type = string_type,
                    saved_position = self.spawn_pos,
                    zone_id = "meadows"
                })
            end
        end

        -- ХАК ДЛЯ ПЕРЕЗАГРУЗКИ ЧАНКА (BG3-style):
        -- Если существо с таким UID УЖЕ существует в вашей базе данных,
        -- это значит, что фабрика чанка пытается создать дубликат.
        if creatures_state.get(string_uid) then
            go.delete()
            return
        end

        -- Проверка старого сейва (если загрузили игру из файла, а моб был убит)
        if creatures_state.is_loaded_from_save and not creatures_state.exists(string_uid) then
            go.delete()
            return
        end
    end

    -- =========================================================================
    -- 2. БОЕВОЙ КОНТУР (Сработает ТОЛЬКО для живых тел из Фабрики!)
    -- =========================================================================
    self.uid = string_uid

    -- Регистрируем связь для рейкаста и курсора в памяти бэкенда
    creatures_state.register(self.go_id, {
        creature_id = self.creature_id,
        creature_uid = string_uid,
        level = self.creature_level or 1,
        type = string_type,
        rank = string_rank
    })

    -- ВЫТАСКИВАЕМ ДАННЫЕ ИЗ БЭКЕНД-СТЕЙТА ДЛЯ ИИ:
    local creature_instance_data = creatures_state.get(string_uid)
    if creature_instance_data then
        self.speed = creature_instance_data.speed or 90
        self.hitbox_size = creature_instance_data.hitbox_size or 64
        self.attack_range_melee = creature_instance_data.attack_range_melee or 8
        self.ai_profile = creature_instance_data.ai_profile

        -- 🎯 ЗРЯЧАЯ СМЕНА СПРАЙТА:
        -- Мы стучимся в твою оригинальную базу данных criaturas_db за базовым конфигом!
        local db_cfg = creatures_db.get_creature(self.creature_id)

        -- Посмотри, как у тебя в creatures_db называется поле с именем анимации!
        -- Если поле называется animation, оставь db_cfg.animation. 
        -- Если поля нет, можно использовать очищенный id типа string_id.
        local anim_name = db_cfg and db_cfg.animation or string_id

        if sprite then
            sprite.play_flipbook("#sprite", hash(anim_name))
        end

        -- ВОЗВРАЩАЕМ НА МЕСТО: Если в базе есть сохраненная позиция, сдвигаем моба туда
        if creature_instance_data.saved_position then
            go.set_position(creature_instance_data.saved_position)
        end
    else
        self.speed = 90
        self.hitbox_size = 64
        self.attack_range_melee = 8
        self.ai_profile = "aggressive_patrol"
    end

    -- ИНИЦИАЛИЗАЦИЯ ИИ: Менеджер сам навесит нужные таймеры и стейты внутрь self
    creature_ai.init(self.ai_profile, self)
end


---@param self CreatureScriptContext
function final(self)
    if creatures_state.unregister then
        -- Перед удалением отправляем текущую позицию ИИ в бэкенд-стейт
        local current_data = creatures_state.get(self.uid) or {}
        current_data.saved_position = go.get_position()
        -- Сохраняем измененные данные (включая ХП, если есть) обратно в creatures_db/state
        creatures_state.update_data(self.uid, current_data)

        creatures_state.unregister(self.go_id)
    end
end

function update(self, dt)
     -- Опрашиваем профиль ИИ из базы данных, передавая контекст self конкретного моба
    local move_dir = creature_ai.update(self.ai_profile, self, dt)

    -- Если мозг выдал вектор направления движения — плавно сдвигаем Game Object в мире
    if move_dir then
        local current_speed = self.speed

        -- Если профиль-мозг пометил флаг патруля, режем боевую скорость пополам
        if self.ai_is_patrolling then
            current_speed = current_speed * 0.5
        end

        local pos = go.get_position()
        go.set_position(pos + move_dir * current_speed * dt)
    end
end

function late_update(self, dt)
end

function fixed_update(self, dt)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("click") then
        print(string.format("🖱️ КЛИК: Игрок выбрал тушку %s [%s]", self.creature_id, self.uid))

        -- 🎯 ЧИСТОКРОВНЫЙ WoW-КАНОН:
        -- Зашиваем СИ-адрес и строковый GUID монстра в центральную ячейку таргета!
        interaction_manager.set_target(self.go_id, self.uid)
    end
end

function on_input(self, action_id, action)
end

function on_reload(self)
end
