function init(self)
	  msg.post(".", "acquire_input_focus")
    self.go_id = go.get_id()
    self.container_id = tostring(self.go_id)
       -- Инициализируем контейнер
    self.container_data = {
        id = self.container_id,
        -- name = self.container_name,
        columns = self.columns,
        rows = self.rows,
        items = {}
    }

    self.is_looted = false
    containers_state.init(self.container_id, {
        items = self.container_data.items,
        columns = self.columns,
        rows = self.rows,
        is_looted = self.is_looted,
        loot_table_id = self.loot_table_id
    })


    apply_container_visual(self)

    msg.post("#container_name", "disable")
    
    -- if self.loot_table_id ~= hash("empty") then
    --     local items = loot_tables.get_loot(self.loot_table_id)
    --     for i, item in ipairs(items) do
    --         self.container_data.items[i] = item
    --     end
    -- end

    -- self.container_data.items[1] = {item_id = hash("iron_sword"), amount = 1}
    -- self.container_data.items[2] = {item_id = hash("lesser_mana_potion"), amount = 2}

    -- Подписываемся на хайлайт
    self.broadcast_handler = function(message_id, message)
        if message_id == hash("toggle_interactable_highlight") then
          print('TEST PRINT')
            if message.show then
                go.set_scale(vmath.vector3(1.2, 1.2, 1), self.go_id)
                -- label.set_text("#container_name", 'СУНДУК')
                msg.post(msg.url(nil, self.go_id, "container_name"), "enable")
            else
                go.set_scale(vmath.vector3(1, 1, 1), self.go_id)
                msg.post(msg.url(nil, self.go_id, "container_name"),"disable")
            end
        end
    end
    
    broadcast.subscribe(self.broadcast_handler)
end

function final(self)
	  broadcast.unsubscribe(self.broadcast_handler)
    containers_state.remove(self.container_id)
end

function update(self, dt)

end

function late_update(self, dt)

end

function fixed_update(self, dt)
	
end

function on_message(self, message_id, message, sender)
	  if message_id == hash("click") then
        interaction.handle_click(self, 50, function()
            open_container(self)
        end)
    end
    
    if message_id == hash("close_window") then
        self:close_container()
    end
end

