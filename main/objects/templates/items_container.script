function on_reload(self)

end

function open_container(self)
    local state = containers_state.get(self.container_id)
    print("container_id:", self.container_id)
    print("Opening container:", self.container_name)
    if not state.is_looted then
        -- генерируем лут в state.items
        local items = loot_tables.get_loot(self.loot_table_id)
        for i, item in ipairs(items) do
            state.items[i] = item
        end
        state.is_looted = true
        -- обновляем реестр
        containers_state.init(self.container_id, state)
    end
    
    -- Передаём в GUI ссылку на state.items
    msg.post("main:/container_window#gui", "open_container_window", {
        container_id = self.container_id,
        container_items = state.items,  -- передаём ссылку на предметы
        columns = self.columns,
        rows = self.rows,
        position = go.get_world_position(),
        player_pos = go.get_position("/player")
    })
end

function close_container(self)
    -- Закрыть окно
    msg.post("hud#gui", "close_container")
end

function update_container_data(self)
    msg.post("/gui_manager", "update_container_data", {
        container_id = self.container_id,
        container_data = self.container_data
    })
end

function get_data_source(self)
    print("get_data_source called, returning", self.container_data)
    return self.container_data  -- возвращаем ссылку на оригинал
end
