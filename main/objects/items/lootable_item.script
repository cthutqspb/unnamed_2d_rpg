function on_message(self, message_id, message, sender)
    if message_id == hash("set_item_id") then
        self.item_id = message.item_id
        print('AMOUTN', message.amount)
        self.amount = message.amount or 1
        
        -- Получаем данные (уже с переводом внутри!)
        local data = items_db.get_item(self.item_id)
        if data then
            -- Устанавливаем текст в Label
            label.set_text("#item_name", data.name)
            if self.amount > 1 then
                label.set_text("#amount", self.amount)
            end
        end
    end
    if message_id == hash("click") then
        print("Lootable item got click, item_id:", self.item_id)
        
        -- Проверка дистанции до игрока
        local player_pos = go.get_position("player")
        local my_pos = go.get_position()
        local dist = vmath.length(player_pos - my_pos)

        if dist < 50 then
            print("Picking up:", self.item_id)
            msg.post("world", "pickup_item", {
                item_id = self.item_id,
                amount = self.amount
            })
        else
            print("Too far:", dist)
        end
    end
end

