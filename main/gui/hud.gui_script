local druid = require("druid.druid")
local broadcast = require("main.modules.system.broadcast")
local HealthBar = require("main.gui.components.health_bar.HealthBar")
local ActionBar = require("main.gui.action_bar.action_bar")
local player_inv = require("main.modules.player.player_inventory")
local drag_manager = require("main.gui.components.managers.drag_manager")
local window_manager = require("main.gui.components.managers.window_manager")
local item_transfer_manager = require("main.modules.item_transfer_manager")
local items_db = require("main.modules.data.items_db")
local h_touch = hash("touch")

function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)

    self.action_bar = self.druid:new(ActionBar, "action_bar", self.druid)
    self.health_bar = self.druid:new(HealthBar, "health_bar")

    _G.HUD = self
    self.is_shift_pressed = false

    self.msg_handlers = {
        [hash("update_health")] = function(self, message)
            self.health_bar:update_health(message.percentage)
        end,
    }

    -- self.input_handlers = {
    --     -- [hash("toggle_inventory")] = function(self) self.inventory:toggle() end,
    --     msg.post("main:/character_window#gui", "toggle_character_window"),
    --     msg.post("main:/inventory_window#gui", "toggle_inventory_window")
    -- }

    self.on_inventory_event = function(data)
        if data.message_id == hash("add_item") then
            local success = player_inv.add_item(data.item_id, data.amount)
            if success then
                -- Обновляем все заинтересованные окна
                msg.post("main:/character_window#gui", "refresh")
                msg.post("main:/inventory_window#gui", "refresh")
                -- Если нужно обновить что-то в самом HUD
                if self.static_grid then self.static_grid:refresh() end
            end
        end
    end

    self.on_player_event = function(data)
        if data.message_id == hash("update_health") then
            self.health_bar:update_health(data.percentage)
        elseif data.message_id == hash("player_data_loaded") then
            -- Сюда прилетит сигнал из SaveManager при загрузке игры
            -- Пересчитываем полоски ХП и Маны под новые загруженные цифры
            print('DATA', data.health_percentage)
            self.health_bar:update_health(data.health_percentage)
        end
    end

    broadcast.subscribe("inventory_events", self.on_inventory_event)
    broadcast.subscribe("player_events", self.on_player_event)
    print("HUD initialized")
end

function on_message(self, message_id, message, sender)
    local handler = self.msg_handlers[message_id]
    if handler then
        handler(self, message)
    end

    if message_id == hash("refresh_inventories") then
        msg.post("main:/character_window#gui", "refresh")
        msg.post("main:/inventory_window#gui", "refresh")
    end
end

function on_input(self, action_id, action)
     -- 1. СНАЧАЛА проверяем системные клавиши типа Shift
    if action_id == hash("key_lshift") then
        if action.pressed then
            self.is_shift_pressed = true
            print("HUD: SHIFT PRESSED")
        elseif action.released then
            self.is_shift_pressed = false
            print("HUD: SHIFT RELEASED")
        end
        -- ВАЖНО: возвращаем false, чтобы этот инпут не блокировал Druid 
        -- и другие окна (Character Window) тоже могли увидеть Shift, если им нужно
        return false
    end

     -- 1. Если это просто движение мыши - ДАЕМ ПРОЙТИ СКВОЗЬ
    if not action_id then
        -- Мы уже обновили координаты в player.script, 
        -- тут просто отдаем Друиду и возвращаем false
        self.druid:on_input(action_id, action)
        return false -- ВАЖНО: возвращаем false, чтобы Character Window тоже увидело мышь
    end

    -- 2. В остальном - Druid первый
    local handled = self.druid:on_input(action_id, action)
    if handled then return true end

    if action_id == hash("key_esc") and action.pressed then
        -- Пытаемся закрыть верхнее окно
        handled = window_manager.close_top()

        if not handled then
            -- Если окон в стеке нет, открываем общее меню игры (Settings/Exit)
            print("HUD: No windows to close. Toggling Main Menu.")
            msg.post("main:/main_menu#gui", "toggle_main_menu")
        end
        return true -- Поглощаем ESC, чтобы игра не закрылась сразу
    end

    if not action.x or not action.y then
        return self.druid:on_input(action_id, action)
    end

    -- 1. Движение мыши (чтобы иконка летала, когда мы над HUD)
    if not action_id and drag_manager.is_dragging() then
        drag_manager.update(action.x, action.y)
    end

    -- 2. ЕДИНЫЙ БЛОК ЗАВЕРШЕНИЯ ДРАГА В HUD
    -- if action_id == h_touch and action.released and drag_manager.is_dragging() then
    --     drag_manager.finish(nil, nil)
    --     return true
    -- end
    if action_id ==  h_touch and action.released and drag_manager.is_dragging() then
        print("HUD: Nobody claimed the drop, spawning in world...")
        drag_manager.finish(nil, nil)
        broadcast.send("inventory_events", { message_id = hash("inventory_changed") })
        return true
    end

    return handled
end

function final(self)
    broadcast.unsubscribe("inventory_events", self.on_inventory_event)
    broadcast.unsubscribe("player_events", self.on_player_event)
    print("HUD final: unsubscribed from all events")
end

function update(self, dt)
end

function on_reload(self)
end
