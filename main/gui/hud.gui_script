local druid = require("druid.druid")
local broadcast = require("main.modules.system.broadcast")
local HealthBar = require("main.gui.components.health_bar.HealthBar")
local ActionBar = require("main.gui.action_bar.action_bar")
local player_inv = require("main.modules.player.player_inventory")
local drag_manager = require("main.gui.components.managers.drag_manager")
local window_manager = require("main.gui.components.managers.window_manager")

---@class HudScriptContext
---@field druid druid.instance Инстанс Друида для этого GUI-экрана
---@field action_bar table Компонент нижней панели скиллов
---@field health_bar table Компонент полоски здоровья персонажа
---@field is_shift_pressed boolean Системный флаг зажатия клавиши Shift
---@field on_inventory_event function Коллбэк для инвентарных бродкастов
---@field on_player_event function Коллбэк для характеристик игрока
---@field on_ui_event function Коллбэк для системных отмен фокусов и окон
---@field static_grid table|nil Ссылка на сетку слотов, если она встроена в HUD

local h_touch = hash("touch")

---@param self HudScriptContext
function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)

    self.action_bar = self.druid:new(ActionBar, "action_bar", self.druid)
    self.health_bar = self.druid:new(HealthBar, "health_bar")

    _G.HUD = self
    self.is_shift_pressed = false

    -- 📬 СЛАЙС 1: ИНВЕНТАРНЫЕ СОБЫТИЯ (inventory_events)
    self.on_inventory_event = function(data)
        if data.message_id == hash("add_item") then
            local success = player_inv.add_item(data.item_id, data.amount)
            if success then
                msg.post("main:/character_window#gui", "refresh")
                msg.post("main:/inventory_window#gui", "refresh")
                if self.static_grid then self.static_grid:refresh() end
            end
        end
    end

    -- 📬 СЛАЙС 2: 🎯 ЧИСТОЕ РЕАКТИВНОЕ РЕШЕНИЕ ХП (player_events)
    -- Анонимная функция поймала бродкаст и просто перенаправила его себе же 
    -- через msg.post, чтобы движок Defold на следующем кадре безопасно переключил графический контекст!
    self.on_player_event = function(data)
        if data.message_id == hash("update_health") then
            msg.post("main:/gui_manager#hud", "update_health_deferred", { percentage = data.percentage })
        elseif data.message_id == hash("player_data_loaded") then
            msg.post("main:/gui_manager#hud", "update_health_deferred", { percentage = data.health_percentage })
        end
    end

    -- 📬 СЛАЙС 3: СИСТЕМНЫЙ UI-КОНТЕКСТ (ui_events)
    self.on_ui_event = function(data)
        if data.message_id == hash("focus_lost") then
            drag_manager.abort_drag()
            msg.post("main:/split_window#gui", "close_window")
        end
    end

    -- Оформляем подписки на наши Redux-каналы
    broadcast.subscribe("inventory_events", self.on_inventory_event)
    broadcast.subscribe("player_events", self.on_player_event)
    broadcast.subscribe("ui_events", self.on_ui_event)

    print("HUD initialized successfully")
end

---@param self HudScriptContext
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
  -- 🎯 ТИПИЗИРОВАННЫЙ ПРИЕМНИК: Отложенный безопасный апдейт графики ХП
    if message_id == hash("update_health_deferred") then
        print("HUD: Графический контекст восстановлен аппаратно движком! Красим полоску ХП.")
        self.health_bar:update_health(message.percentage)
    end

    if message_id == hash("refresh_inventories") then
        msg.post("main:/character_window#gui", "refresh")
        msg.post("main:/inventory_window#gui", "refresh")
    end
end

---@param self HudScriptContext
---@param action_id hash|nil
---@param action table
---@return boolean
function on_input(self, action_id, action)
    if action_id == hash("key_lshift") then
        if action.pressed then self.is_shift_pressed = true
        elseif action.released then self.is_shift_pressed = false end
        return false
    end

    if not action_id then
        self.druid:on_input(action_id or hash(""), action)
        return false
    end

    local handled = self.druid:on_input(action_id, action)
    if handled then return true end

    if action_id == hash("key_esc") and action.pressed then
        handled = window_manager.close_top()
        if not handled then
            msg.post("main:/main_menu#gui", "toggle_main_menu")
        end
        return true
    end

    if not action.x or not action.y then
        return false
    end

    if not action_id and drag_manager.is_dragging() then
        drag_manager.update(action.x, action.y)
    end

    if action_id == hash("touch") and action.released and drag_manager.is_dragging() then
        print("HUD: Выбрасываем предмет в игровой мир...")
        drag_manager.finish(nil, nil)
        broadcast.send("inventory_events", { message_id = hash("inventory_changed") })
        return true
    end

    return false
end

---@param self HudScriptContext
function final(self)
    broadcast.unsubscribe("inventory_events", self.on_inventory_event)
    broadcast.unsubscribe("player_events", self.on_player_event)
    broadcast.unsubscribe("ui_events", self.on_ui_event)
    print("HUD final: отписались от всех каналов бродкаста")
end

