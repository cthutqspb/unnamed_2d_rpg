local druid = require("druid.druid")
local broadcast = require("main.modules.system.broadcast")
local interaction_manager = require("main.modules.logic.interaction_manager")
local UnitFrame = require("main.gui.components.unit_frame.UnitFrame")
local ActionBar = require("main.gui.components.action_bar.ActionBar")
local CastBar = require("main.gui.components.cast_bar.CastBar")
local game_state = require("main.modules.game_state.game_state")
local drag_manager = require("main.gui.components.managers.drag_manager")
local window_manager = require("main.gui.components.managers.window_manager")
local character_data = require("main.modules.character.character_data")

---@class HudScriptContext
---@field druid druid.instance Инстанс Друида для этого GUI-экрана
---@field player_frame table
---@field target_frame table
---@field action_bar table
---@field player_cast_bar CastBar
---@field is_shift_pressed boolean Системный флаг зажатия клавиши Shift
---@field on_inventory_event function Коллбэк для инвентарных бродкастов
---@field on_action_bar_event function
---@field on_unit_event function Коллбэк для характеристик игрока
---@field on_ui_event function Коллбэк для системных отмен фокусов и окон
---@field on_target_event function
---@field on_combat_event function
---@field static_grid table|nil Ссылка на сетку слотов, если она встроена в HUD

---@param self HudScriptContext
function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)
    defos.set_cursor_visible(false)
    -- Стилизованный курсор

    -- self.player_frame = self.druid:new(UnitFrame, "player_frame")
    -- self.target_frame = self.druid:new(TargetFrame, "target_frame")
    self.player_frame = self.druid:new(UnitFrame, "player_frame")
    self.target_frame = self.druid:new(UnitFrame, "target_frame")
    -- self.pet_frame    = self.druid:new(UnitFrame, "pet_frame",    { unit_token = "pet" }) -- Задел под призванного скелета!
    self.action_bar = self.druid:new(
        ActionBar,
        "action_bar",
        {
            bar_index = 1,
            item_size = 40,
            spacing = 2,
        }
    )

    self.player_cast_bar = CastBar.new("cast_bar")

    self.is_shift_pressed = false

    -- 📬 СЛАЙС 1: ИНВЕНТАРНЫЕ СОБЫТИЯ (inventory_events)
    self.on_inventory_event = function(data)
        if data.message_id == hash("inventory_changed") then
            -- Память сумок на бэкенде уже мутировала шёлком! Просто перерисовываем GUI-окна!
            msg.post("main:/character_window#gui", "refresh")
            msg.post("main:/inventory_window#gui", "refresh")
            if self.static_grid then self.static_grid:refresh() end
        end
    end

    self.on_action_bar_event = function (data)
        if data.message_id == hash("action_bars_changed") then
            msg.post("main:/gui_manager#hud",  "refresh_action_bars")
        end
    end

    -- 📬 СЛАЙС 2: 🎯 ЧИСТОЕ РЕАКТИВНОЕ РЕШЕНИЕ ХП И РЕСУРСОВ (unit_events)
    self.on_unit_event = function(data)
        -- 🦾 ЕДИНЫЙ ШЛЮЗ ИЗМЕНЕНИЯ ЗДОРОВЬЯ ВСЕЛЕННОЙ Meadows:
        if data.message_id == hash("unit_health_changed") or data.message_id == hash("unit_resource_changed") then

            -- Пинаем рамку игрока, явно скармливая ей токен сессии из character_data!
            if data.uid == character_data.PLAYER_UID then
                msg.post("main:/gui_manager#hud", "refresh_player_frame_deferred", { uid = data.uid })
            end

            -- 🚀 ЧИСТЫЙ ПРОБРОС ДЛЯ ТАРГЕТ-ОКНА (ИСПРАВЛЕНО):
            -- Вычистили гнойный мусор из ключа! Теперь передается стерильный update_type!
            msg.post("main:/gui_manager#hud", "target_update", { update_type = "damage", uid = data.uid })
        end
    end

    -- 📬 СЛАЙС 3: СИСТЕМНЫЙ UI-КОНТЕКСТ (ui_events)
    self.on_ui_event = function(data)
        if data.message_id == hash("focus_lost") then
            drag_manager.abort_drag()
            msg.post("main:/split_window#gui", "close_window")
        end
    end

    -- =========================================================================
    -- 📬 СЛАЙС 4: БОЕВОЙ ТАРГЕТИНГ ПО КAНOНУ (target_events)
    -- =========================================================================
    self.on_target_event = function(data)
        if data.message_id == hash("target_changed") then
            -- 🚀 ЧИСТЫЙ СИГНАЛ (ИСПРАВЛЕНО): вычистили мусорные склейки из комментария
            -- Ловим чистый сигнал смены цели и асинхронно deferred-пробрасываем в кадр!
            msg.post("main:/gui_manager#hud", "target_changed_deferred", { uid = data.uid })

        elseif data.message_id == hash("target_lost") then
            -- Ловим чистый сигнал потери цели и deferred-гасим плашку на экране!
            msg.post("main:/gui_manager#hud", "target_lost_deferred")
        end
    end

    self.on_combat_event = function (data)
        if data.event == "unit_attacked" then
            msg.post("main:/gui_manager#hud", "target_update", { update_type = data.type, uid = data.uid })

        elseif data.message_id == hash("global_cooldown_started") then
            -- Асинхронно шлем месседж в on_message этого же скрипта HUD
            msg.post("main:/gui_manager#hud", "start_gcd_animation", { duration = data.duration })
        end
    end

    -- Оформляем подписки на наши Redux-каналы
    broadcast.subscribe("inventory_events", self.on_inventory_event)
    broadcast.subscribe("action_bar_events", self.on_action_bar_event)
    broadcast.subscribe("unit_events", self.on_unit_event)
    broadcast.subscribe("ui_events", self.on_ui_event)
    broadcast.subscribe("combat_events", self.on_combat_event)
    broadcast.subscribe("target_events", self.on_target_event)

    if self.player_frame and self.player_frame.refresh_frame then
        self.player_frame:refresh_frame(character_data.PLAYER_UID)
    end

    if self.action_bar and self.action_bar.refresh then
        self.action_bar:refresh()
    end

    print("HUD initialized successfully")
end

---@param self HudScriptContext
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    if message_id == hash("refresh_player_frame_deferred") then
        -- Передаем айдишник мага прямо в метод! Фрейм игрока обновится шёлком!
        self.player_frame:refresh_frame(character_data.PLAYER_UID)
    end

    -- 🎯 А) ИГРОК КЛИКНУЛ МЫШКОЙ ПО МОБУ (Смена Фокуса):
    if message_id == hash("target_changed_deferred") then
        -- Запечатали актуальный Си-ИНН жертвы в паспорт мага в RAM
        -- Пулей скармливаем этот UID рамке цели! Она мгновенно сочно загорится на HUD!
        self.target_frame:refresh_frame(message.uid)
    end

    -- 🎯 Б) КЛИКНУЛИ В ПУСТОТУ / МОБ УМЕР (Потеря Фокуса):
    if message_id == hash("target_lost_deferred") then
        -- Скармливаем nil — универсальный UnitFrame сам вежливо потухнет с экрана!
        self.target_frame:refresh_frame(nil)
    end

    -- 🎯 В) КТО-ТО ПОЛУЧИЛ ЛЮЛЕЙ В МИРЕ (Боевой Апдейт):
    if message_id == hash("target_update") then
        -- Вытаскиваем, кто сейчас сидит в прицеле у нашего мага
        local current_target_uid = character_data.player.combat_target_uid

        -- 🛡️ ГВАРД АОЕ/КЛИВОВ (WoW-канон):
        -- Мы обновляем плашку таргета strictly только в том случае, если UID побитого 
        -- на бэкенде существа совпадает с тем мобом, на которого мы сейчас реально СМОТРИМ!
        if current_target_uid and message.uid == current_target_uid then
            self.target_frame:refresh_frame(current_target_uid)
        end
    end

    if message_id == hash("refresh_inventories") then
        msg.post("main:/character_window#gui", "refresh")
        msg.post("main:/inventory_window#gui", "refresh")
    end

    if message_id == hash("refresh_action_bars") then
        self.action_bar:refresh()
    end

    if message_id == hash("start_gcd_animation") then
        print("⚔️ HUD: Получена команда запустить ГКД на панели способностей!")
        if self.action_bar and self.action_bar.trigger_gcd then
            -- Пинаем ООП-контроллер панели крутить шторки
            self.action_bar:trigger_gcd(message.duration)
        end
    end

    -- =========================================================================
    -- ❄️ СТEРИЛЬНЫЙ АCИHХРOHHЫЙ ТРAНЗИТ В КAСТБAР ИГРOКA (ДОБАВЛЕНО):
    -- =========================================================================
    -- Ивент А: Маг замер на месте и начал петь Фростболт
    if message_id == hash("show_castbar") then
        if self.player_cast_bar then
            self.player_cast_bar:show(message.ability_id)
        end

    -- Ивент Б: Покадровый апдейт прогресса полосы из update() игрока
    elseif message_id == hash("update_castbar") then
        if self.player_cast_bar then
            self.player_cast_bar:set_progress(message.progress)
        end

    -- Ивент В: Каст успешно допел до конца ИЛИ наглухо сорван движением WASD
    elseif message_id == hash("hide_castbar") then
        if self.player_cast_bar then
            self.player_cast_bar:hide()
        end
    end
    -- =========================================================================
end

function update(self, dt)
    local player = character_data.player

    local target_uid = interaction_manager.get_current_target_uid and interaction_manager.get_current_target_uid()
    local target = target_uid and game_state.get_entity_by_uid(target_uid)

    if self.action_bar and self.action_bar.update then
        -- Скармливаем пиксельному рендереру чистые таблицы данных
        self.action_bar:update(dt, player, target)
    end
end

---@param self HudScriptContext
---@param action_id hash|nil
---@param action table
---@return boolean
function on_input(self, action_id, action)
    -- 1. Системный Shift
    if action_id == hash("key_lshift") then
        if action.pressed then self.is_shift_pressed = true
        elseif action.released then self.is_shift_pressed = false end
        return false
    end

    -- =========================================================================
    -- 🎯 2. ПEРВЫЙ ПOГРAНИЧНЫЙ СЛOЙ ХУДA: ЛОГИКА АКТИВНОГО ДРАГА
    -- Выносим её на самый верх, полностью выжигая блокировку от 'handled = true'!
    -- =========================================================================
    if drag_manager.is_dragging() then
        -- А) Движение мыши (Плавно тащим иконку банки/спелла за курсором)
        if not action_id or action_id == hash("touch") then
            drag_manager.update(action.x, action.y)
        end

        -- Б) Отпускание мыши (Drop) над экшен-баром или в мир
        if action_id == hash("touch") and action.released then
            local bar_grid = self.action_bar and (self.action_bar.static_grid or self.action_bar.grid)

            -- Опрашиваем боевую сетку напрямую!
            if bar_grid and bar_grid:on_drop(action.x, action.y) then
                print("🚩 ХУД: Боевая сетка успешно сожрала дроп из инвентаря!")
                return true -- Поглощаем инпут, цепь замкнулась!
            end

            -- Если промахнулись мимо экшен-бара — дефолтный выброс под ноги в Meadows
            print("HUD: Промахнулись мимо панели. Выбрасываем предмет в мир...")
            drag_manager.finish(nil, nil)
            broadcast.send("inventory_events", { message_id = hash("inventory_changed") })
            return true
        end
    end

    -- =========================================================================
    -- 3. ВТОРОЙ СЛОЙ ХУДA: Отдаем инпут Друиду (Только если драг НЕ активен!)
    -- =========================================================================
    local handled = self.druid:on_input(action_id, action)
    if handled then return true end

    -- 4. Системный ESC (Закрытие окон / Меню)
    if action_id == hash("key_esc") and action.pressed then
        handled = window_manager.close_top()
        if not handled then
            msg.post("main:/main_menu#gui", "toggle_main_menu")
        end
        return true
    end

    -- =========================================================================
    -- 🎯 ЧИСТОКРОВНЫЙ СИ-ПЕРЕХВАТ ХOТКEEВ КЛAВИAТУРЫ (1..12):
    -- =========================================================================
    if action.pressed and action_id then
        local key_index = nil

        -- Быстрый развод Си-хэшей числового ряда клавиатуры движка Defold
        if     action_id == hash("key_1") then key_index = 1
        elseif action_id == hash("key_2") then key_index = 2
        elseif action_id == hash("key_3") then key_index = 3
        elseif action_id == hash("key_4") then key_index = 4
        elseif action_id == hash("key_5") then key_index = 5
        elseif action_id == hash("key_6") then key_index = 6
        elseif action_id == hash("key_7") then key_index = 7
        elseif action_id == hash("key_8") then key_index = 8
        elseif action_id == hash("key_9") then key_index = 9
        elseif action_id == hash("key_0") then key_index = 10
        -- (Если в твоем input.input_binding заведены минус и плюс, раскомментируй слоты 11 и 12):
        -- elseif action_id == hash("key_minus") then key_index = 11
        -- elseif action_id == hash("key_equal") then key_index = 12
        end

        if key_index then
            if self.action_bar then
                -- Панель сама залезет в память, проверит КД, зажжет визуал и пнет player.script!
                self.action_bar:on_slot_click(key_index)
                return true -- Поглощаем инпут, мир Meadows эту кнопку не читает
            end
        end
    end

    return false
end

---@param self HudScriptContext
function final(self)
    broadcast.unsubscribe("inventory_events", self.on_inventory_event)
    broadcast.unsubscribe("action_bar_events", self.on_action_bar_event)
    broadcast.unsubscribe("unit_events", self.on_unit_event)
    broadcast.unsubscribe("ui_events", self.on_ui_event)
    broadcast.unsubscribe("target_events", self.on_target_event)
    broadcast.unsubscribe("combat_events", self.on_combat_event)
    print("HUD final: отписались от всех каналов бродкаста")
end

