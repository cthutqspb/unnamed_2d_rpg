local druid = require("druid.druid")
local HealthBar = require("main.gui.components.health_bar.health_bar")
local ActionBar = require("main.gui.action_bar.action_bar")
local player_inv = require("main.modules.player_inventory")
local InventoryGrid = require("main.gui.components.inventory.inventory_grid")
local Inventory = require("main.gui.components.inventory.inventory")
local gui_utils = require("main.gui.gui_utils")
local drag_manager = require("main.gui.drag_manager")
local window_manager = require("main.modules.gui.window_manager")
local tooltip_manager = require("main.modules.gui.tooltip_manager")
local h_touch = hash("touch")


function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)
    
    self.action_bar = self.druid:new(ActionBar, "action_bar", self.druid)
    self.hp_bar = self.druid:new(HealthBar, "health_bar")
   
    player_inv.init() 
    player_inv.add_item("iron_sword", 1)
    player_inv.add_item("lesser_mana_potion", 10)
    player_inv.add_item("leather_helmet", 1)

    self.inventory = self.druid:new(Inventory, "inventory", {
        data_source = player_inv,
        columns = 6,
        rows = 4,
        item_size = 40,
        spacing = 2
    }) 

    self.msg_handlers = {
        [hash("update_health")] = function(self, message) 
            self.hp_bar:update_health(message.percentage) 
        end,
        
        [hash("toggle_inventory")] = function(self) 
            self.inventory:toggle() 
        end,

    }

    self.input_handlers = {
        [hash("toggle_inventory")] = function(self) self.inventory:toggle() end,
        msg.post("main:/character_window#gui", "toggle_character_window")
    }
    
    print("HUD initialized")
end

function on_message(self, message_id, message, sender)
    local handler = self.msg_handlers[message_id]
    if handler then
        handler(self, message)
    end

    if message_id == hash("add_to_inv") then
        local success = player_inv.add_item(message.item_id, message.amount)
        if success then
            msg.post("main:/character_window#gui", "refresh")
            if self.inventory and self.inventory.refresh then
                self.inventory:refresh()
            end
        end
    end

    if message_id == hash("refresh_inventories") then
        msg.post("main:/character_window#gui", "refresh")
        if self.inventory and self.inventory.refresh then
            self.inventory:refresh()
        end
    end

end

function clear_slot_highlights(self)
    -- if self.container_window and self.container_window.inventory_grid then
    --     self.container_window.inventory_grid:highlight_slot(nil)
    -- end
    -- if self.character_window and self.character_window.inventory_grid then
    --     self.character_window.inventory_grid:highlight_slot(nil)
    -- end
    if self.inventory and self.inventory.inventory_grid then
        self.inventory.inventory_grid:highlight_slot(nil)
    end
end

function on_input(self, action_id, action)
     -- 1. Если это просто движение мыши - ДАЕМ ПРОЙТИ СКВОЗЬ
    if not action_id then
        -- Мы уже обновили координаты в player.script, 
        -- тут просто отдаем Друиду и возвращаем false
        self.druid:on_input(action_id, action)
        return false -- ВАЖНО: возвращаем false, чтобы Character Window тоже увидело мышь
    end

    -- 2. В остальном - Druid первый
    local handled = self.druid:on_input(action_id, action)
    if handled then return true end
    
    if action_id == hash("key_esc") and action.pressed then
        -- Пытаемся закрыть верхнее окно
        local handled = window_manager.close_top()
        
        if not handled then
            -- Если окон в стеке нет, открываем общее меню игры (Settings/Exit)
            print("No windows to close. Open Main Menu?")
            -- self.main_menu:toggle()
        end
        return true -- Поглощаем ESC, чтобы игра не закрылась сразу
    end
    
    if not action.x or not action.y then
        return self.druid:on_input(action_id, action)
    end

    -- 1. Движение мыши (чтобы иконка летала, когда мы над HUD)
    if not action_id and drag_manager.is_dragging() then
        drag_manager.update(action.x, action.y)
    end

    -- 2. ЕДИНЫЙ БЛОК ЗАВЕРШЕНИЯ ДРАГА В HUD
    if action_id == h_touch and action.released and drag_manager.is_dragging() then
        print("HUD: Checking drop...") -- Если этого принта нет, значит h_touch nil или ввод не дошел

        -- -- Сначала проверяем Контейнер (Лут)
        -- if self.container_window and self.container_window.inventory_grid:on_drop(action.x, action.y) then
        --     print("HUD: Dropped into Container")
        --     return true
        -- end

        -- Потом проверяем Сумку (Inventory)
        if self.inventory and self.inventory.inventory_grid:on_drop(action.x, action.y) then
            print("HUD: Dropped into Bag")
            return true
        end

        -- Если мы дошли сюда, значит мы НЕ над окнами в HUD.
        -- И раз этот код вообще выполняется, значит Character Window тоже промахнулось.
        print("HUD: Dropping to world!")
        drag_manager.finish(nil, nil)
        return true
    end

    return handled
end

function final(self)
end

function update(self, dt)
end

function on_reload(self)
end
