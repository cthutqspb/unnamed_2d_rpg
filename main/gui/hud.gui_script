local druid = require("druid.druid")
local HealthBar = require("main.gui.components.health_bar.health_bar")
local ActionBar = require("main.gui.action_bar.action_bar")
local player_inv = require("main.modules.player_inventory")
local InventoryGrid = require("main.gui.components.inventory.inventory_grid")
local Inventory = require("main.gui.components.inventory.inventory")
local CharacterWindow = require("main.gui.components.character_window.character_window")
local ContainerWindow = require("main.gui.components.container_window.container_window")
local gui_utils = require("main.gui.gui_utils")
local drag_manager = require("main.gui.drag_manager")


function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)
    
    self.action_bar = self.druid:new(ActionBar, "action_bar", self.druid)
    self.hp_bar = self.druid:new(HealthBar, "health_bar")
   
    player_inv.init() 
    player_inv.add_item("iron_sword", 1)
    player_inv.add_item("lesser_mana_potion", 10)
    player_inv.add_item("leather_helmet", 1)

    self.character_window = CharacterWindow.new(self.druid, "character_window", player_inv)
    self.inventory = self.druid:new(Inventory, "inventory", {
        data_source = player_inv,
        columns = 6,
        rows = 4,
        item_size = 40,
        spacing = 2
    })
   
    self.container_window = ContainerWindow.new(self.druid, "container_window", {
        columns = 6,
        rows = 4,
        spacing = 2
    })

    self.container_window:set_visible(false)

    self.msg_handlers = {
        [hash("update_health")] = function(self, message) 
            self.hp_bar:update_health(message.percentage) 
        end,
        
        [hash("toggle_inventory")] = function(self) 
            self.inventory:toggle() 
        end,

        [hash("toggle_character")] = function(self) 
            self.character_window:toggle() 
        end
    }

    self.input_handlers = {
        [hash("toggle_inventory")] = function(self) self.inventory:toggle() end,
        [hash("toggle_character_window")] = function(self) self.character_window:toggle() end
    }
    
    print("HUD initialized")
end

function on_message(self, message_id, message, sender)
    local handler = self.msg_handlers[message_id]
    if handler then
        handler(self, message)
    end

    if message_id == hash("add_to_inv") then
        local success = player_inv.add_item(message.item_id, message.amount)
        if success then
            if self.character_window and self.character_window.inventory_grid then
                self.character_window.inventory_grid:refresh()
            end
            if self.inventory and self.inventory.refresh then
                self.inventory:refresh()
            end
        end
    end

    if message_id == hash("refresh_inventories") then
        if self.character_window and self.character_window.inventory_grid then
            self.character_window.inventory_grid:refresh()
        end
        if self.inventory and self.inventory.refresh then
            self.inventory:refresh()
        end
    end

    if message_id == hash("open_container") then        
        self.container_window:open(
            message.container_id,
            message.columns,
            message.rows,
            message.position,      -- мирная позиция контейнера
            message.player_pos     -- позиция игрока
        )
    end

    if message_id == hash("close_container_window") then
        if self.container_window then
            self.container_window:set_visible(false)
        end
    end
end

function clear_slot_highlights(self)
    if self.container_window and self.container_window.inventory_grid then
        self.container_window.inventory_grid:highlight_slot(nil)
    end
    if self.character_window and self.character_window.inventory_grid then
        self.character_window.inventory_grid:highlight_slot(nil)
    end
    if self.inventory and self.inventory.inventory_grid then
        self.inventory.inventory_grid:highlight_slot(nil)
    end
end

function on_input(self, action_id, action)
    -- Начинаем с клавиаутры
    if action.pressed then
        local handler = self.input_handlers[action_id]
        if handler then
            handler(self)
            return true
        end
    end

    if action_id == hash("key_esc") and action.pressed then
        if self.container_window then
            self.container_window:set_visible(false)
        end
        if self.character_window and gui.is_enabled(self.character_window.root) then
            self.character_window:close_window()
        end
        if self.inventory then
            self.inventory:set_visible(false)
        end
    end
    
    if not action.x or not action.y then
        return self.druid:on_input(action_id, action)
    end

    -- Обработка окончания драга
    if drag_manager.is_dragging() and action.released then
        local target_component = nil
        local target_slot = nil
        
        -- Проверяем открытые окна
        if self.container_window and self.container_window.inventory_grid then
            local inv_grid = self.container_window.inventory_grid
            local slot = inv_grid:get_slot_at_position(action.x, action.y)
            if slot then 
                target_component = inv_grid
                target_slot = slot
                print("Target: container window, slot:", target_slot)
            end
        end

        if self.character_window and self.character_window.inventory_grid then
            local inv_grid = self.character_window.inventory_grid
            local slot = inv_grid:get_slot_at_position(action.x, action.y) 
            if slot then 
                target_component = inv_grid
                target_slot = slot
                print("Target: same inventory, slot:", slot)
            end
        end

        
        if self.inventory and self.inventory.inventory_grid then
            local inv_grid = self.inventory.inventory_grid
            local slot = inv_grid:get_slot_at_position(action.x, action.y)
            if slot then
                target_component = inv_grid
                target_slot = slot
                print("Target: same inventory, slot:", slot)
            end
        end
        
        if target_component then
            drag_manager.finish(target_component, target_slot)
        else
            local source, source_slot = drag_manager.get_source()
            if source and source.is_mouse_over_any_gui then
                local over_gui = source:is_mouse_over_any_gui(action.x, action.y)
                if over_gui then
                    -- Возврат на место (свап с самим собой)
                    drag_manager.finish(source, source_slot)
                else
                    drag_manager.finish(nil, nil)
                end
            else
                drag_manager.finish(nil, nil)
            end
        end

        return true    
    end

    return self.druid:on_input(action_id, action)
end

function final(self)
end

function update(self, dt)
end

function on_reload(self)
end
