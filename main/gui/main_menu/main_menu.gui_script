local druid = require("druid.druid")
local save_nanager = require("main.modules.system.save_manager")
local MainMenu = require("main.gui.main_menu.MainMenu")

---@class MainMenuGuiScriptContext
---@field druid druid.instance Инстанс Друида для этого GUI-экрана
---@field main_menu table Созданный через фабрику объект Главного Меню

---@param self MainMenuGuiScriptContext
function init(self)
    -- Если сохранения физически не существует, визуально затемняем кнопку "Продолжить"
    if not save_nanager.exists() then
        gui.set_color(gui.get_node("btn_continue_game"), vmath.vector4(0.5, 0.5, 0.5, 1.0))
    end

    local root = gui.get_node("root")

    self.druid = druid.new(self)

    -- 🚩 ФИКС MISSING-PARAMETER: Передаем nil вторым аргументом, чтобы удовлетворить сигнатуру фабрики!
    self.main_menu = MainMenu.new(self.druid, "")

    -- По умолчанию центрируем корневую ноду по сетке проекта
    gui.set_position(root, vmath.vector3(960.0, 540.0, 0.0))

    self.main_menu.set_visible(self.main_menu, false)
end

---@param self MainMenuGuiScriptContext
function final(self)
end

---@param self MainMenuGuiScriptContext
---@param dt number
function update(self, dt)
end

---@param self MainMenuGuiScriptContext
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    if message_id == hash("toggle_main_menu") then
        self.main_menu.toggle(self.main_menu)
    end
end

---@param self MainMenuGuiScriptContext
---@param action_id hash|nil
---@param action table
---@return boolean
function on_input(self, action_id, action)
    -- 🚩 ФИКС PARAM-TYPE-MISMATCH: Подменяем nil на пустой хэш для пассивного движения мыши
    return self.druid:on_input(action_id or hash(""), action)
end

function on_reload(self)
end

