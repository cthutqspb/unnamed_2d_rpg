local druid = require("druid.druid")
local broadcast = require("main.modules.system.broadcast")
local CharacterWindow = require("main.gui.components.character_window.CharacterWindow")
local character_logic = require("main.modules.character.character_logic")
local player_inv = require("main.modules.player.player_inventory")
local drag_manager = require("main.gui.components.managers.drag_manager")
local window_manager = require("main.gui.components.managers.window_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local interaction_manager = require("main.modules.logic.interaction_manager")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local items_db = require("main.modules.data.items_db")
local CustomCursor = require("main.gui.components.cursor.CustomCursor")

local h_touch = hash("touch")

---@class CharacterWindowScript
---@field druid druid.instance
---@field character_window CharacterWindow
---@field broadcast_handler function

---@param self CharacterWindowScript
function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)

    -- Инициализируем компонент окна
    ---@type CharacterWindow
    self.character_window = self.druid:new(CharacterWindow, "", player_inv)

    self.broadcast_handler = function(data)
        if data.message_id == hash("inventory_changed") then
            -- 1. Считаем цифры мгновенно
            character_logic.update_derived_stats()
            -- 2. Включаем Dirty Flag для отрисовки в следующем кадре (защита от Wrong Scene)
            if self.character_window then
                self.character_window:request_refresh()
                self.character_window:update_all_displays()
            end
        end
    end
    broadcast.subscribe("inventory_events", self.broadcast_handler)
end

---@param self CharacterWindowScript
function final(self)
    if self.druid then
        self.druid:final()
    end
    broadcast.unsubscribe("inventory_events", self.broadcast_handler)
end

---@param self CharacterWindowScript
---@param dt number
function update(self, dt)
    -- Если окна нет или оно скрыто — выходим сразу
    if not self.character_window or not self.character_window:is_visible() then
        return
    end

    self.character_window:update(dt, window_manager.mouse_x, window_manager.mouse_y)

    local mx, my = tooltip_manager.mouse_x, tooltip_manager.mouse_y
    local hover_data = self.character_window:handle_hover(mx, my)

    if hover_data then
        CustomCursor.set_style("cursor_outline_yellow")
        tooltip_manager.show(hover_data.type, hover_data.item, { source = "inventory" })
    else
        -- Проверяем, над окном ли мы, чтобы скрыть тултип мира/предмета
        if self.character_window:is_over_window(mx, my) then
            CustomCursor.set_style("cursor_default")
            tooltip_manager.hide_gui_tooltips()
        end
    end
end

---@param self CharacterWindowScript
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    if message_id == hash("close_window") then
        -- Универсальный метод из BaseWindow (закроет, почистит стек, сбросит ховер)
        if self.character_window:is_visible() then
            self.character_window:close()
        end
    elseif message_id == hash("set_focus_visual") then
        -- Вызываем метод базового окна. 
        -- Теперь мы находимся внутри родной сцены, и Defold будет счастлив!
        if self.character_window and self.character_window.set_focus_visual then
            self.character_window:set_focus_visual(message.is_active)
        end

    elseif message_id == hash("split_confirmed") then
        local slot_index, current_amount = message.slot_index, message.current_amount
        local player_inventory = interaction_manager.get_player_inventory()
        local item = player_inventory:get_item(slot_index)

        if item and item.item_id then
            -- Визуально урезаем циферку в слоте на экране (твоя родная логика)
            local remaining = item.amount - current_amount
            self.character_window.static_grid:set_slot_amount_visual(slot_index, remaining)

            local item_cfg = items_db.get_item(item.item_id)

            -- 🎯 ПАКЕТ ДАННЫХ ДЛЯ КУРСОРНОГО СПЛИТА
            local split_item = {
                uid = item.uid,           -- 🚩 ФИКС: теперь строго 'uid' вместо 'item_uid'
                item_id = item.item_id,
                amount = current_amount,
                source_split_slot = slot_index,

                -- Метки для бэкенда
                is_split = true
            }

            -- Взводим драг от лица сетки инвентаря
            drag_manager.start(self.character_window.static_grid, slot_index, split_item, item_cfg)
        end


    elseif message_id == hash("context_menu_action") or message_id == hash("item_action") then
        local action_name = message.event

        -- Ищем нужную стратегию в глобальном диспетчере (будь то сплит, дроп или атака кабана!)
        local reducer = actions_dispatcher.REDUCERS[action_name]

        if reducer then
            -- Просто диспатчим payload (data) в редьюсер бэкенда!
            reducer(message.data)
        else
            print("WARNING: Нет обработчика для экшена:", action_name)
        end

    elseif message_id == hash("toggle_character_window") then
        self.character_window:toggle()

    elseif message_id == hash("refresh") then
        self.character_window:request_refresh()
    end
end

---@param self CharacterWindowScript
---@param action_id hash
---@param action table
function on_input(self, action_id, action)
    if not self.character_window or not self.character_window:is_visible() then
        return self.druid:on_input(action_id, action)
    end

    -- 1. Сначала отдаем ввод Друиду (кнопки, вкладки и начало драга)
    local handled = self.druid:on_input(action_id, action)

    -- 2. Логика Драга (твоя идеальная версия)
    if drag_manager.is_dragging() then
        if not action_id or action_id == h_touch then
            drag_manager.update(action.x, action.y)
            -- Используем self.character_window.root, который нашла БАЗА
            if gui.pick_node(self.character_window.root, action.x, action.y) then
                drag_manager.set_over_gui(true)
            end
        end

        if action_id == h_touch and action.released then
            if self.character_window.static_grid:on_drop(action.x, action.y) then return true end
            if self.character_window.paperdoll and self.character_window.paperdoll:on_drop(action.x, action.y) then return true end

            -- Используем self.character_window.root из БАЗЫ
            if gui.pick_node(self.character_window.root, action.x, action.y) then
                drag_manager.finish(nil, nil)
                return true
            end
        end
    end

    -- 3. ФИНАЛЬНЫЙ ШТРИХ: блокировка мира через БАЗУ
    if action_id and action.x and action.y then
        -- Используем метод из базы, который проверяет координаты
        if self.character_window:is_over_window(action.x, action.y) then
            -- 🚩 ГЛАВНЫЙ ФИКС: Если игрок КЛИКНУЛ (pressed) по окну
            if action.pressed and action_id == h_touch then
                -- Говорим менеджеру, что мы теперь главные!
                window_manager.handle_window_click(self.character_window, msg.url())
            end

            return true -- Блокируем мир
        end
    end

    return handled
end
