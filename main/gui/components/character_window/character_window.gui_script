function on_input(self, action_id, action)
    if not self.character_window or not self.character_window:is_visible() then
        return self.druid:on_input(action_id, action)
    end

    -- 1. Сначала отдаем ввод Друиду (кнопки, вкладки и начало драга)
    local handled = self.druid:on_input(action_id, action)
    
    if action.x and action.y then
        if self.character_window:is_over_window(action.x, action.y) then
            return true
        end
    end
    -- 2. Логика Драга (твоя идеальная версия)
    if drag_manager.is_dragging() then
        if not action_id or action_id == h_touch then
            drag_manager.update(action.x, action.y)
            -- Используем self.character_window.root, который нашла БАЗА
            if gui.pick_node(self.character_window.root, action.x, action.y) then
                drag_manager.set_over_gui(true)
            end
        end

        if action_id == h_touch and action.released then
            if self.character_window.static_grid:on_drop(action.x, action.y) then return true end
            if self.character_window.paperdoll and self.character_window.paperdoll:on_drop(action.x, action.y) then return true end

            -- Используем self.character_window.root из БАЗЫ
            if gui.pick_node(self.character_window.root, action.x, action.y) then
                drag_manager.finish(nil, nil)
                return true
            end
        end
    end

    -- 3. ФИНАЛЬНЫЙ ШТРИХ: блокировка мира через БАЗУ
    -- Вместо ручного pick_node мы вызываем метод базы, который просто чекает тело
    -- if action.x and action.y then
    --     -- Вызываем статический метод базы, чтобы не плодить Друидов
    --     if self.character_window.is_over_window(self.character_window, action.x, action.y) then
    --         return trua
    --     end
    -- end
    if action_id and action.x and action.y then
        if self.character_window:is_over_window(action.x, action.y) then
            return true 
        end
    end

    return handled
end
