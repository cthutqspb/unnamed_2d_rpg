local druid = require("druid.druid")
local CharacterWindow = require("main.gui.components.character_window.character_window")
local CharacterLogic = require("main.modules.character.character_logic")
local player_inv = require("main.modules.player_inventory")
local drag_manager = require("main.gui.drag_manager")
local window_manager = require("main.modules.gui.window_manager")
local tooltip_manager = require("main.modules.gui.tooltip_manager")
local h_touch = hash("touch")

function init(self)
  print("DEBUG: Character Window Address is:", msg.url())
    msg.post(".", "acquire_input_focus")
    -- 1. Создаем Druid для этого конкретного GUI
    self.druid = druid.new(self)
    
    -- 2. Создаем экземпляр твоего окна, передавая ему Druid
    -- Мы используем твой M.new из Lua-файла
    -- self.window_logic = CharacterWindow.new(self.druid, "character_window", player_inv)
    self.character_window = CharacterWindow.new(self.druid, "", player_inv)
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
    -- Если объект окна еще не создан или не проинициализирован
    if not self.character_window or not self.character_window.inventory_grid then
        return
    end
    
    -- Берем координаты из менеджера (которые обновляет world.script)
    local mx = tooltip_manager.mouse_x
    local my = tooltip_manager.mouse_y
    
    local hovered = false
    -- Проверяем инвентарь (если окно открыто)
    if self.character_window:is_visible() then
        if self.character_window.inventory_grid:update_hover(mx, my) then
            hovered = true
        end
        
        -- Если у тебя кукла тоже в этом окне:
        if not hovered and self.character_window.paperdoll:update_hover(mx, my) then
          print('AAAAAA')  
          hovered = true
        end
    end
    
    -- Если ни один слот ни в одном модуле не поймал мышь
    if not hovered then
        -- Важно: прячем только если мышь была над этим окном
        if gui.pick_node(self.character_window.root, mx, my) then
            tooltip_manager.hide()
        end
    end
end

function on_message(self, message_id, message, sender)
    -- ГОЛОЕ ЗАКРЫТИЕ (от менеджера или кнопки Esc)
    if message_id == hash("close_window") then
        if self.character_window:is_visible() then
            self.character_window:close() -- Твой метод модуля
            gui.set_render_order(0)
            window_manager.pop(msg.url())
        end

    -- ПЕРЕКЛЮЧЕНИЕ (от кнопки "C" или кнопки в HUD)
    elseif message_id == hash("toggle_character_window") then
        self.character_window:toggle()
        
        if self.character_window:is_visible() then
            gui.set_render_order(10)
            window_manager.push(msg.url(), hash("close_window")) 
        else
            gui.set_render_order(0)
            window_manager.pop(msg.url())
        end

    elseif message_id == hash("refresh") then
        if self.character_window and self.character_window:is_visible() then
            self.character_window.inventory_grid:refresh()
        end 

    elseif message_id == hash("data_updated") then
        CharacterLogic.update_derived_stats()
        
        -- Ищем модули во всех вкладках
        for name, tab in pairs(self.character_window.tabs) do
            for _, module in ipairs(tab.modules) do
                if module.update_display then
                    print("Updating module in tab:", name)
                    module:update_display()
                end
            end
        end
    end
end

