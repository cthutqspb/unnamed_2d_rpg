local druid = require("druid.druid")
local broadcast = require("main.modules.system.broadcast")
local CharacterWindow = require("main.gui.components.character_window.CharacterWindow")
local unit_logic = require("main.modules.unit.logic.unit_logic")
local drag_manager = require("main.gui.components.managers.drag_manager")
local window_manager = require("main.gui.components.managers.window_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local actions_dispatcher = require("main.modules.logic.actions_dispatcher")
local items_db = require("main.modules.data.items_db")
local CustomCursor = require("main.gui.components.cursor.CustomCursor")
local character_data = require("main.modules.character.character_data")

---@class CharacterWindowScript
---@field druid druid.instance
---@field character_window CharacterWindow
---@field broadcast_handler function

---@param self CharacterWindowScript
function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)

    -- Инициализируем компонент окна, ЯВНО передавая этот живой инвентарь в конструктор!
    -- Никакого хардкода файлов, чистокровный ААА-проброс данных (Data Injection)!
    ---@type CharacterWindow
    self.character_window = self.druid:new(CharacterWindow, "", nil, nil)

    self.broadcast_handler = function(data)
        if data.message_id == hash("inventory_changed") then
            -- 1. Считаем цифры мгновенно
            -- unit_logic.update_derived_stats(player)
            local live_unit = self.character_window and self.character_window.current_unit

            if live_unit then
                -- Считаем цифры по стопроцентно правильной, мутировавшей RAM-таблице!
                unit_logic.update_derived_stats(live_unit)
            end
            -- 2. Включаем Dirty Flag для отрисовки в следующем кадре (защита от Wrong Scene)
            if self.character_window and self.character_window.request_refresh then
                self.character_window:request_refresh()
                self.character_window:update_all_displays()
            end
        end
    end

    broadcast.subscribe("inventory_events", self.broadcast_handler)
end

---@param self CharacterWindowScript
function final(self)
    if self.druid then
        self.druid:final()
    end
    broadcast.unsubscribe("inventory_events", self.broadcast_handler)
end

---@param self CharacterWindowScript
---@param dt number
function update(self, dt)
    -- Если окна нет или оно скрыто — выходим сразу
    if not self.character_window or not self.character_window:is_visible() then
        return
    end

    self.character_window:update(dt, window_manager.mouse_x, window_manager.mouse_y)

    local mx, my = tooltip_manager.mouse_x, tooltip_manager.mouse_y
    local hover_data = self.character_window:handle_hover(mx, my)

    if hover_data then
        local slot_action_type = hover_data.item.action_type or "item" -- инвентарь по дефолту всегда item

        CustomCursor.set_style("cursor_outline_yellow")
        tooltip_manager.show(
            hover_data.type,
            hover_data.item,
            {
                --source = "inventory",
                action_type = slot_action_type
            }
        )
    else
        -- Проверяем, над окном ли мы, чтобы скрыть тултип мира/предмета
        if self.character_window:is_over_window(mx, my) then
            CustomCursor.set_style("cursor_default")
            tooltip_manager.hide_gui_tooltips()
        end
    end
end

---@param self CharacterWindowScript
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
     -- =========================================================================
    -- 🦾 ПОЛИМОРФНЫЙ ИНТЕРЦЕПТОР КОНТЕКСТА (WoW / BG3 КАНОН):
    -- =========================================================================
    -- Мы берем ТОГО юнита, который ПРЯМО СЕЙЧАС открыт в нашем визуальном окне!
    -- Если окно закрыто или только инициализируется — мягко падаем в player по дефолту.
    -- Если внутри окна сидит Компаньон или Скелет - код зряче выберет ИХ!
    local current_unit = (self.character_window and self.character_window.current_unit) or character_data.player

    if not current_unit or not current_unit.inventory or not current_unit.paperdoll then
        -- Мягко пропускаем системные сообщения, остальное гвардим на входе
        if message_id ~= hash("set_focus_visual") and message_id ~= hash("close_window") and message_id ~= hash("toggle_character_window") then
            return
        end
    end

    local unit_inventory = current_unit and current_unit.inventory
    local unit_paperdoll = current_unit and current_unit.paperdoll
    -- =========================================================================
    -- 🦾 СТЕРИЛЬНЫЙ ДИСПЕТЧЕР СООБЩЕНИЙ UI
    -- =========================================================================
    if message_id == hash("close_window") then
        if self.character_window:is_visible() then
            self.character_window:close()
        end

    elseif message_id == hash("set_focus_visual") then
        if self.character_window and self.character_window.set_focus_visual then
            self.character_window:set_focus_visual(message.is_active)
        end

    elseif message_id == hash("split_confirmed") then
        if not unit_inventory then return end

        local slot_index, current_amount = message.slot_index, message.current_amount

        -- Кристально чистый вызов без повторных проверок стейта!
        local item = unit_inventory:get_item(slot_index)

        if item and item.item_id then
            local remaining = item.amount - current_amount

            -- Вытаскиваем чертеж
            local item_cfg = items_db.get_item(item.item_id)

            -- 🦾 ТИТАНОВЫЙ ГВАРД ЛИНТEРA: Добавляем 'and item_cfg' в условие!
            -- Теперь Neovim на 1000% уверен, что в drag_manager.start 
            -- прилетит живая таблица, и ворнинг пропадет на этой же наносекунде!
            if item_cfg then
                self.character_window.static_grid:set_slot_amount_visual(slot_index, remaining)

                local split_item = {
                    uid = item.uid,
                    item_id = item.item_id,
                    amount = current_amount,
                    source_split_slot = slot_index,
                    is_split = true
                }

                drag_manager.start(unit_inventory, slot_index, split_item, item_cfg)
            end
        end

    elseif message_id == hash("context_menu_action") or message_id == hash("item_action") then
        if not current_unit then return end

        local action_name = message.event
        local reducer = actions_dispatcher.REDUCERS[action_name]

        if reducer then
            -- 🦾 ЗРЯЧИЙ ААА-ПЕРЕХВАТ НАПРАВЛЕНИЯ ТРАНЗАКЦИИ:
            if action_name == "item_transfer" and message.data then
                message.data.unit_uid = current_unit.uid

                if message.data.from_paperdoll then
                    -- 🛡️ КЕЙС СНЯТИЯ (Из куклы в рюкзак): Поменяли сорсы зеркально!
                    message.data.source_model_override = unit_paperdoll
                    message.data.target_model_override = unit_inventory
                else
                    -- ⚔️ КЕЙС НАДЕВАНИЯ (Из рюкзака на куклу): Базовый налив шмота!
                    message.data.source_model_override = unit_inventory
                    message.data.target_model_override = unit_paperdoll
                end
            elseif action_name == "item_drop" then
                -- 🦾 На лету инжектируем живую модель рюкзака мага прямо перед вызовом редьюсера!
                message.data.source_model_override = unit_inventory
            end

            reducer(message.data)
        else
            print("WARNING: Нет обработчика для экшена:", action_name)
        end

    elseif message_id == hash("toggle_character_window") then
        -- Никаких дублирующих проверок! Просто делаем Data Injection актуальных моделей в окно!
        self.character_window:bind_unit("player")
        self.character_window:toggle()

    elseif message_id == hash("refresh") then
        self.character_window:request_refresh()
    end
end

function on_input(self, action_id, action)
    return window_manager.handle_window_input(self, action_id, action, drag_manager, self.character_window)
end


