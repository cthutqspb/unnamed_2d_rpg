local constants_ui = require("main.gui.constants_ui")
local druid = require("druid.druid")
local window_manager = require("main.gui.components.managers.window_manager")
local settings = require("main.modules.data.settings")
local items_db = require("main.modules.data.items_db")

---@class SplitWindowGuiContext
---@field druid druid.instance Инстанс Друида для этого GUI-экрана
---@field root node Корневой узел интерфейса поп-апа сплита
---@field icon_from node Узел исходной иконки предмета
---@field icon_to node Узел целевой иконки предмета
---@field text_count node Текстовый узел отображения количества
---@field btn_plus table Друид-кнопка прибавления количества
---@field btn_minus table Друид-кнопка уменьшения количества
---@field btn_confirm table Друид-кнопка подтверждения "ОК"
---@field btn_cancel table Друид-кнопка отмены
---@field render_order number Системный индекс отрисовки слоев (POPUP)
---@field is_static boolean Флаг статичности окна
---@field current_amount number Текущее выбранное количество для отщипывания
---@field max_amount number Максимально доступный размер стака
---@field sender_url url|nil Ссылка на GUI-окно, которое открыло сплит (куда слать ответ)
---@field source_slot number|string|nil Индекс исходной ячейки предмета

---Обновить текстовое значение счетчика на экране
---@param self SplitWindowGuiContext
local function update_ui(self)
    gui.set_text(self.text_count, tostring(self.current_amount))
end

---Закрыть поп-ап, очистить фокус ввода и обнулить контекстные ссылки
---@param self SplitWindowGuiContext
local function close(self)
    msg.post(".", "release_input_focus")
    gui.set_enabled(self.root, false)
    self.sender_url = nil
    self.source_slot = nil
end

---Подтвердить разделение стака и отправить сигнал обратно в вызвавшее окно
---@param self SplitWindowGuiContext
local function confirm(self)
    if self.sender_url then
        -- 📬 Сигнал улетает обратно на сохраненный URL инвентаря/сундука, 
        -- где его теперь честно ловит наш Redux-приемник!
        msg.post(self.sender_url, "split_confirmed", {
            slot_index = self.source_slot,
            current_amount = self.current_amount
        })
    end
    close(self)
end

---Изменить текущее количество на дельту с шагом в рамках доступного стака
---@param self SplitWindowGuiContext
---@param delta number Изменение (1 или -1)
local function change_amount(self, delta)
    self.current_amount = self.current_amount + delta
    if self.current_amount < 1 then self.current_amount = 1 end
    if self.current_amount > self.max_amount then self.current_amount = self.max_amount end
    update_ui(self)
end

---@param self SplitWindowGuiContext
function init(self)
    self.render_order = constants_ui.LAYERS.POPUP
    self.is_static = false

    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)

    self.root = gui.get_node("root")
    self.icon_from = gui.get_node("icon_from")
    self.icon_to = gui.get_node("icon_to")
    self.text_count = gui.get_node("text_count")

    -- Регистрируем кнопки Druid, бережно передавая self в замыкания
    self.btn_plus = self.druid:new_button("btn_plus", function() change_amount(self, 1) end)
    self.btn_minus = self.druid:new_button("btn_minus", function() change_amount(self, -1) end)
    self.btn_confirm = self.druid:new_button("btn_confirm", function() confirm(self) end)
    self.btn_cancel = self.druid:new_button("btn_cancel", function() close(self) end)

    self.current_amount = 1
    self.max_amount = 1
    self.sender_url = nil
    self.source_slot = nil

    gui.set_enabled(self.root, false)
end

---@param self SplitWindowGuiContext
function final(self)
    self.druid:final()
end

---@param self SplitWindowGuiContext
---@param dt number
function update(self, dt)
    self.druid:update(dt)
end

---@param self SplitWindowGuiContext
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    if message_id == hash("close_window") then
        close(self)
        gui.set_render_order(0)
        window_manager.pop(msg.url())
    end

    if message_id == hash("open_split_window") then
        print('ON MESSAGE IN SPLIT_WINDOW: ACTIVE!')
        window_manager.push(self, msg.url(), self.render_order)
        msg.post(".", "acquire_input_focus")

        -- Запоминаем отправителя, чтобы отправить "split_confirmed" строго по адресу!
        self.sender_url = sender
        self.source_slot = message.slot_index
        self.max_amount = message.item.amount or 1

        -- По классике открываемся ровно на половине стака
        self.current_amount = math.floor(self.max_amount / 2)
        if self.current_amount < 1 then self.current_amount = 1 end

        -- Логика позиционирования адаптивного окна поп-апа
        if message.position then
            gui.set_position(self.root, message.position)
        else
            local cx, cy = settings.get_center()
            gui.set_position(self.root, vmath.vector3(cx, cy, 0.0))
        end

        -- Отрисовка текстуры шмотки из базы данных
        local item_cfg = items_db.get_item(message.item.item_id)
        if item_cfg and item_cfg.visuals.texture then
            local anim = item_cfg.visuals.animation or item_cfg.visuals.icon
            gui.set_texture(self.icon_from, item_cfg.visuals.texture)
            gui.play_flipbook(self.icon_from, hash(anim))

            gui.set_texture(self.icon_to, item_cfg.visuals.texture)
            gui.play_flipbook(self.icon_to, hash(anim))
        end

        update_ui(self)
        gui.set_render_order(constants_ui.LAYERS.POPUP)
        gui.set_enabled(self.root, true)
    end
end

---@param self SplitWindowGuiContext
---@param action_id hash|nil
---@param action table
---@return boolean
function on_input(self, action_id, action)
    if gui.is_enabled(self.root) then
        -- 🚩 ФИКС PARAM-TYPE-MISMATCH: Заменяем возможный nil на пустой хэш для движения мыши
        return self.druid:on_input(action_id or hash(""), action)
    end
    return false
end

function on_reload(self)
end

