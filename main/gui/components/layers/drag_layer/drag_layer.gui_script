local drag_manager = require("main.gui.components.managers.drag_manager")

function init(self)
    -- Мы не запрашиваем фокус ввода! Этот слой только для отрисовки.
    gui.set_render_order(20)
    self.icon = gui.get_node("icon")
    gui.set_enabled(self.icon, false)
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
    if drag_manager.is_dragging() then
        local d = drag_manager.get_active()

        -- ПРОВЕРКА 1: Существует ли активный объект?
        if not d then return end

        gui.set_enabled(self.icon, true)

        -- ПРОВЕРКА 2: Безопасная установка текстуры
        if d.texture and d.animation then
            gui.set_texture(self.icon, d.texture)
            gui.play_flipbook(self.icon, d.animation)
        end

        -- ПРОВЕРКА 3: Наличие координат
        local x = d.x or 0
        local y = d.y or 0
        gui.set_position(self.icon, vmath.vector3(x, y, 0))
    else
        -- Если не тащим — гарантированно выключаем
        if gui.is_enabled(self.icon) then
            gui.set_enabled(self.icon, false)
        end
    end
end

