local drag_manager = require("main.gui.components.managers.drag_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local items_db = require("main.modules.data.items_db")
local gui_utils = require("main.gui.gui_utils")

function init(self)
    gui.set_render_order(25) -- Самый верхний слой
    self.root = gui.get_node("root")
    self.title = gui.get_node("title")
    self.description = gui.get_node("description")
    self.stats = gui.get_node("stats")
    
    gui.set_enabled(self.root, false)
end


function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
    local data = tooltip_manager.get_current()

    -- Если драга нет и есть данные для тултипа
    if data and not drag_manager.is_dragging() then
        gui.set_enabled(self.root, true)

        -- 1. НАПОЛНЕНИЕ ДАННЫМИ
        if data.type == "item" then
            local item = items_db.get_item(data.id)

            if not item then
                -- Если предмета нет в базе, просто тихо прячемся
                gui.set_enabled(self.root, false)
                return
            end

            gui.set_text(self.title, item.name or "Unknown Item")
            gui.set_text(self.description, item.description or "")
            -- Если есть статы — собираем их в строку
            local stats_text = ""
            if item.stats then
                for stat, val in pairs(item.stats) do
                    stats_text = stats_text .. stat .. ": +" .. val .. "\n"
                end
            end
            gui.set_text(self.stats, stats_text)

        elseif data.type == "unit" then
            gui.set_text(self.title, data.id) -- например, имя монстра
            gui.set_text(self.description, "Уровень: " .. (data.extra.level or "??"))
            gui.set_text(self.stats, "HP: " .. data.extra.hp)
        end

        -- 2. ПОЗИЦИОНИРОВАНИЕ
        -- Сдвигаем на 20 пикселей от курсора, чтобы не мешать
        local mouse_pos = vmath.vector3(tooltip_manager.mouse_x + 20, tooltip_manager.mouse_y - 20, 0)

        -- Используем твой хелпер, чтобы тултип не улетал за экран!
        local final_pos = gui_utils.clamp_to_screen(self.root, mouse_pos, 10)
        gui.set_position(self.root, final_pos)
    else
        gui.set_enabled(self.root, false)
    end
end

