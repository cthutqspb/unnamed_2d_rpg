local druid = require("druid.druid")
local ContainerWindow = require("main.gui.components.container_window.ContainerWindow")
local drag_manager = require("main.gui.components.managers.drag_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local window_manager = require("main.gui.components.managers.window_manager")
local items_db = require("main.modules.data.items_db")
local h_touch = hash("touch")

function init(self)
    print("DEBUG: Container Window Address is:", msg.url())

    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)

    self.container_window = ContainerWindow.new(self.druid, "", {
        columns = 6,
        rows = 4,
        spacing = 2
    })

    self.container_window:set_visible(false)
end

function final(self)
	
end

function update(self, dt)
    -- Если объект окна еще не создан или не проинициализирован
    if not self.container_window or not self.container_window.inventory_grid then
        return
    end
    
    -- Берем координаты из менеджера (которые обновляет world.script)
    local mx = tooltip_manager.mouse_x
    local my = tooltip_manager.mouse_y
    
    local hovered = false
    -- Проверяем инвентарь (если окно открыто)
    if self.container_window:is_visible() then
        if self.container_window.inventory_grid:update_hover(mx, my) then
            hovered = true
        end
    end
    
    -- Если ни один слот ни в одном модуле не поймал мышь
    if not hovered then
        -- Важно: прячем только если мышь была над этим окном
        if gui.pick_node(self.container_window.root, mx, my) then
            tooltip_manager.hide()
        end
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_container_window") then        
        self.container_window:open(
            message.container_id,
            message.columns,
            message.rows,
            message.position,      -- мирная позиция контейнера
            message.player_pos     -- позиция игрока
        )
        gui.set_render_order(11)
        window_manager.push(msg.url())
    end
    -- ГОЛОЕ ЗАКРЫТИЕ (от менеджера или кнопки Esc)
    if message_id == hash("close_window") then
        if self.container_window:is_visible() then
            self.container_window:close()
            gui.set_render_order(0)
            window_manager.pop(msg.url())
        end
    
    elseif message_id == hash("split_confirmed") then
        local slot_index, current_amount = message.slot_index, message.current_amount
        local data_source = self.container_window.inventory_grid:get_data_source()
        local item = data_source.items[slot_index];
        local item_cfg = items_db.get_item(item.item_id)
        print('amount_to_split',  current_amount)
        local split_item = {
            item_id = item.item_id,
            amount = current_amount,
            source_split_slot = slot_index
        }
        drag_manager.start(self.container_window.inventory_grid, slot_index, split_item, item_cfg)
    end

    if message_id == hash("refresh") then
        self.container_window.inventory_grid:refresh()
    end
  
   

    -- elseif message_id == hash("close_container_window") then
    --     if self.container_window then
    --         self.container_window.close() -- Вызываем твой метод
    --         gui.set_render_order(0) -- Возвращаем приоритет в базу
    --     end
    --
    -- elseif message_id == hash("refresh") then
    --     if self.container_window and self.container_window:is_visible() then
    --         self.container_window.inventory_grid:refresh()
    --     end
    -- end       
end

function on_input(self, action_id, action)
    -- 1. Игнорим закрытое окно
    if not self.container_window:is_visible() then
        return self.druid:on_input(action_id, action)
    end

    local handled = self.druid:on_input(action_id, action)

    -- 2. Обновляем координаты для плавности (когда просто водим или тащим)
    if drag_manager.is_dragging() then
        if not action_id or action_id == h_touch then
            drag_manager.update(action.x, action.y)
        end
        
        if gui.pick_node(self.container_window.root, action.x, action.y) then
            drag_manager.set_over_gui(true)
        end

        -- 3. Логика отпускания (DROP)
        if action_id == h_touch and action.released then
            -- Пробуем в слоты сундука
            if self.container_window.inventory_grid:on_drop(action.x, action.y) then 
                return true 
            end

            -- ЗАЩИТА: Промахнулись мимо слота, но попали в окно сундука
            if gui.pick_node(self.container_window.root, action.x, action.y) then
                print("CONTAINER: Cancel drop")
                drag_manager.finish(nil, nil)
                return true
            end
        end
    end

    return handled
end

function on_reload(self)

end
