local druid = require("druid.druid")
local broadcast = require("main.modules.system.broadcast")
local item_transfer_manager = require("main.modules.item_transfer_manager")
local ContainerWindow = require("main.gui.components.container_window.ContainerWindow")
local drag_manager = require("main.gui.components.managers.drag_manager")
local tooltip_manager = require("main.gui.components.managers.tooltip_manager")
local window_manager = require("main.gui.components.managers.window_manager")
local interaction_manager = require("main.modules.logic.interaction_manager")
local items_db = require("main.modules.data.items_db")
local CustomCursor = require("main.gui.components.cursor.CustomCursor")

local h_touch = hash("touch")

---@class ContainerWindowScript
---@field druid druid.instance
---@field container_window ContainerWindow
---@field broadcast_handler function

function init(self)
    msg.post(".", "acquire_input_focus")
    self.druid = druid.new(self)
    -- Создаем окно как Druid-компонент
    -- Пустая строка "" вторым аргументом, так как внутри компонента мы ищем ноды напрямую или через префиксы
    ---@type ContainerWindow
    self.container_window = self.druid:new(ContainerWindow, "", {
        columns = 6,
        rows = 4,
        spacing = 2
    })
    self.broadcast_handler = function(data)
        if data.message_id == hash("inventory_changed") then
            -- Сундуку не нужно пересчитывать статы персонажа, 
            -- ему нужно просто обновить иконки
            if self.container_window then
                self.container_window:request_refresh()
            end
        end
    end
    broadcast.subscribe("inventory_events", self.broadcast_handler)
end

function final(self)
    broadcast.unsubscribe("inventory_events", self.broadcast_handler)
end

---@param self ContainerWindowScript
---@param dt number
function update(self, dt)
    -- Если окна нет или оно скрыто — выходим сразу
    if not self.container_window or not self.container_window:is_visible() then
        return
    end

    self.container_window:update(dt, window_manager.mouse_x, window_manager.mouse_y)

    local mx, my = tooltip_manager.mouse_x, tooltip_manager.mouse_y
    local hover_data = self.container_window:handle_hover(mx, my)

    -- 1. Если данные есть (мы над предметом)
    if hover_data then
        CustomCursor.set_style("cursor_outline_yellow")
        tooltip_manager.show(hover_data.type, hover_data.item, { source = "container" })
    else
        -- 2. Если данных нет, но мы над окном — прячем
        if gui.pick_node(self.container_window.root, mx, my) then
            -- print("OVER WINDOW BUT NO ITEM")
            CustomCursor.set_style("cursor_default")
            tooltip_manager.hide_gui_tooltips()
        end
    end
end

---@param self ContainerWindowScript
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    -- ОТКРЫТИЕ ОКНА
    if message_id == hash("open_container_window") then
        msg.post(".", "acquire_input_focus")

        self.container_window:open(
            message.container_uid,
            message.container_id,
            message.container_name,
            message.columns,
            message.rows,
            message.position,
            message.player_pos
        )
        self.container_window:toggle()
    end

    -- ЗАКРЫТИЕ (от ESC или менеджера окон)
    if message_id == hash("close_window") then
        if self.container_window:is_visible() then
            self.container_window:toggle()
        end

    elseif message_id == hash("set_focus_visual") then
      print('SETFOCUS CONTAIENR')
        -- Вызываем метод базового окна. 
        -- Теперь мы находимся внутри родной сцены, и Defold будет счастлив!
        if self.container_window and self.container_window.set_focus_visual then
            self.container_window:set_focus_visual(message.is_active)
        end

    elseif message_id == hash("split_confirmed") then
        local slot_index, current_amount = message.slot_index, message.current_amount
        local data_source = self.container_window.static_grid:get_data_source()

        if not data_source or not data_source.items then return end

        local item = data_source.items[slot_index]
        local item_cfg = item and items_db.get_item(item.item_id)

        if item and item_cfg then
            -- Визуально урезаем циферку в сундуке на экране
            local remaining = item.amount - current_amount
            self.container_window.static_grid:set_slot_amount_visual(slot_index, remaining)

            local split_item = {
                uid = item.uid,
                item_id = item.item_id,
                amount = current_amount,
                source_split_slot = slot_index,
                is_split = true
            }

            -- Взводим слепой драг
            drag_manager.start(
                self.container_window.static_grid,
                slot_index,
                split_item,
                item_cfg
            )
        end


    -- ПРИНУДИТЕЛЬНОЕ ОБНОВЛЕНИЕ
    elseif message_id == hash("refresh") then
        self.container_window.static_grid:refresh()

    elseif message_id == hash("context_menu_action") or message_id == hash("item_action") then
         -- Общие данные для обоих событий
        local slot_index = message.data.slot_index
        local item_id = message.data.item_id

        local data_source = self.container_window.static_grid:get_data_source()

        if not data_source or not data_source.items then return end

        local item = data_source:get_item(slot_index)
        local item_cfg = items_db.get_item(item_id)

        if item and item_cfg then
            if message.event == "item_transfer" then
                -- 🎯 ЦЕЛЬ: Кукла (Paperdoll)
                -- Пытаемся взять открытую куклу через window_manager или напрямую модуль
                local target = interaction_manager.get_player_paperdoll()
                item_transfer_manager.execute_transfer(
                    data_source,
                    slot_index,
                    target,
                    item_cfg.equip_slot,
                    item,
                    item_cfg
                )

            elseif message.event == "item_loot" then
                -- 🎯 ЦЕЛЬ: Инвентарь игрока
                local target = interaction_manager.get_player_inventory()
                item_transfer_manager.execute_transfer(
                    data_source,
                    slot_index,
                    target,
                    nil,
                    item,
                    item_cfg
                )
            end
        end
        if message.event == "item_loot_all" then
            local target = interaction_manager.get_player_inventory()
            for i = 1, data_source.max_slots do

                local _item = data_source:get_item(i)
                local _item_cfg = _item and _item.item_id and items_db.get_item(_item.item_id)

                if _item and _item_cfg then
                    item_transfer_manager.execute_transfer(
                        data_source,
                        i,
                        target,
                        nil,
                        _item,
                        _item_cfg
                    )
                end
            end
        end
    end
end

---@param self ContainerWindowScript
---@param action_id hash
---@param action table
function on_input(self, action_id, action)
    if not self.container_window or not self.container_window:is_visible() then
        return self.druid:on_input(action_id, action)
    end

    -- 1. Сначала отдаем ввод Друиду (кнопки, вкладки и начало драга)
    local handled = self.druid:on_input(action_id, action)

    -- 2. Логика Драга (твоя идеальная версия)
    if drag_manager.is_dragging() then
        if not action_id or action_id == h_touch then
            drag_manager.update(action.x, action.y)
            -- Используем self.character_window.root, который нашла БАЗА
            if gui.pick_node(self.container_window.root, action.x, action.y) then
                drag_manager.set_over_gui(true)
            end
        end

        if action_id == h_touch and action.released then
            if self.container_window.static_grid:on_drop(action.x, action.y) then return true end
            -- Используем self.character_window.root из БАЗЫ
            if gui.pick_node(self.container_window.root, action.x, action.y) then
                drag_manager.finish(nil, nil)
                return true
            end
        end
    end

    -- 3. ФИНАЛЬНЫЙ ШТРИХ: блокировка мира через БАЗУ
    if action_id and action.x and action.y then
        -- Используем метод из базы, который проверяет координаты
        if self.container_window:is_over_window(action.x, action.y) then
            -- 🚩 ГЛАВНЫЙ ФИКС: Если игрок КЛИКНУЛ (pressed) по окну
            if action.pressed and action_id == h_touch then
                -- Говорим менеджеру, что мы теперь главные!
                window_manager.handle_window_click(self.container_window, msg.url())
            end

            return true -- Блокируем мир
          end
    end
    return handled
end
