local spawn_manager = require("main.modules.logic.spawn_manager")

local CHUNKS = {
    meadows = {
        url = "/world#factory_meadows",
        w = 8192, h = 4096,
        pos = vmath.vector3(0, 0, 0), -- Честный левый нижний угол чанка в мире!
        root_id = nil
    },
}

local PADDING = 500 -- Запас для подгрузки

function update(self, dt)
    local p_pos = go.get_position("player")

    for name, chunk in pairs(CHUNKS) do
        -- 🎯 ЧЕСТНЫЕ МИРОВЫЕ ГРАНИЦЫ ОТ УГЛА (0,0):
        -- Так как левый нижний угол карты Meadows — это (0,0), границы чанка идут 
        -- строго от chunk.pos.x до chunk.pos.x + chunk.w! Никаких делений на 2!
        local x_min = chunk.pos.x - PADDING
        local x_max = chunk.pos.x + chunk.w + PADDING
        local y_min = chunk.pos.y - PADDING
        local y_max = chunk.pos.y + chunk.h + PADDING

        local is_inside = p_pos.x >= x_min and p_pos.x <= x_max and
                          p_pos.y >= y_min and p_pos.y <= y_max

        -- =========================================================================
        -- СПАВН ЧАНКА (Истинный ААА-конвейер Blizzard)
        -- =========================================================================
        if is_inside and not chunk.root_id then
            -- 🦾 РОЖДЕНИЕ В ЧЕСТНОМ МИРОВОМ НУЛЕ:
            -- Спавним фабрику прямо в chunk.pos (0,0,0)! 
            -- Карта, тайлмап и маркеры Скелетов СРАЗУ рождаются на своих идеальных местах,
            -- как они нарисованы дизайнером в редакторе! Вообще без сдвигов!
            local ids = collectionfactory.create(chunk.url, chunk.pos) 

            -- Находим и запоминаем абсолютный Си-путь рута ТОЛЬКО ради будущей выгрузки
            for full_id, absolute_id in pairs(ids) do 
                if string.find(tostring(full_id), "/root") then
                    chunk.root_id = absolute_id 
                    break
                end
            end

            print("БЭКЕНД [WorldController]: Чанк земли успешно рожден в мировых координатах: " .. name)
            
            -- МАТЕРИАЛИЗАЦИЯ БОЕВЫХ ТУШЕК:
            -- Так как фабрика отработала, маркеры-скелеты в эту же наносекунду кадра 
            -- запустили свой init(), запекли честные координаты в память и удалились.
            -- Сразу же командуем спавнеру вывести живых Скелетов из универсальной фабрики!
            spawn_manager.spawn_zone(name) 

        -- =========================================================================
        -- УДАЛЕНИЕ ЧАНКА
        -- =========================================================================
        elseif not is_inside and chunk.root_id then
            -- Честный абсолютный хэш с префиксом удалит нужный инстанс без осечек
            if go.exists(chunk.root_id) then
                go.delete(chunk.root_id)
                print("БЭКЕНД [WorldController]: Чанк земли успешно выгружен: " .. name)
                spawn_manager.clear_all_bodies(name)
            else
                spawn_manager.clear_all_bodies(name)
                print("БЭКЕНД [WorldController]: Чанк удален из оперативной памяти стейта: " .. name)
            end
            chunk.root_id = nil
        end
    end
end

